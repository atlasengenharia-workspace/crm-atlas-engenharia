@using MudBlazor

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" Height="28px" Animation="Animation.Wave" Class="mb-4" />

    <MudGrid Spacing="3">
        @for (var i = 0; i < 6; i++)
        {
            <MudItem xs="12" md="6">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="56px" Animation="Animation.Wave" />
            </MudItem>
        }
    </MudGrid>

    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="40px" Animation="Animation.Wave" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="40px" Animation="Animation.Wave" />
    </MudStack>
</MudPaper>
