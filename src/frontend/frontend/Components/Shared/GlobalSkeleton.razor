@using MudBlazor

@if (IsLoading)
{
    @switch (Layout)
    {
        case SkeletonLayoutType.Dashboard:
            <DashboardSkeleton />
            break;
        case SkeletonLayoutType.Table:
            <TablePageSkeleton MetricCount="MetricCount" ColumnCount="ColumnCount" RowCount="RowCount" />
            break;
        case SkeletonLayoutType.CardGrid:
            <CardGridSkeleton MetricCount="MetricCount" />
            break;
        case SkeletonLayoutType.Form:
            <FormSkeleton />
            break;
        case SkeletonLayoutType.Custom:
            @CustomSkeleton
            break;
        default:
            <TablePageSkeleton MetricCount="MetricCount" ColumnCount="ColumnCount" RowCount="RowCount" />
            break;
    }
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool IsLoading { get; set; } = true;
    [Parameter] public SkeletonLayoutType Layout { get; set; } = SkeletonLayoutType.Table;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? CustomSkeleton { get; set; }
    [Parameter] public int MetricCount { get; set; } = 3;
    [Parameter] public int ColumnCount { get; set; } = 5;
    [Parameter] public int RowCount { get; set; } = 5;

    public enum SkeletonLayoutType
    {
        Table,
        Dashboard,
        Form,
        CardGrid,
        Custom
    }
}
