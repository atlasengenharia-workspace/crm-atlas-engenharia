    private async Task BuscarCepAsync()
    {
        var cep = _model.EnderecoEmpresaCep;
        if (string.IsNullOrWhiteSpace(cep)) return;
        try
        {
            var result = await JS.InvokeAsync<ViaCepResult?>("buscarCep", cep);
            if (result is null) return;
            if (result.erro is true) { Snackbar.Add("CEP não encontrado.", Severity.Warning); return; }
            _model.EnderecoEmpresaRua = result.logradouro;
            _model.EnderecoEmpresaBairro = result.bairro;
            _model.EnderecoEmpresaCidade = result.localidade;
            _model.EnderecoEmpresaEstado = result.uf;
        }
        catch (Exception ex) { Snackbar.Add($"Erro ao consultar CEP: {ex.Message}", Severity.Error); }
    }
