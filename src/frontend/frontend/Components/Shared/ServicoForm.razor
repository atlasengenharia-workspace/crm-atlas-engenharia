    private async Task BuscarCnpjAsync()
    {
        var digits = new string(_model.DocumentoEmpresa.Where(char.IsDigit).ToArray());
        if (digits.Length != 14) return;
        try
        {
            var result = await JS.InvokeAsync<BrasilApiCnpjResult?>("buscarCnpj", _model.DocumentoEmpresa);
            if (result is null) return;
            if (result.razao_social is not null && string.IsNullOrWhiteSpace(_model.RazaoSocialEmpresa))
                _model.RazaoSocialEmpresa = result.razao_social;
            if (result.ddd_telefone_1 is not null && string.IsNullOrWhiteSpace(_model.Telefone))
                _model.Telefone = $"({result.ddd_telefone_1[..2]}) {result.ddd_telefone_1[2..]}".Trim();
            if (result.email is not null && string.IsNullOrWhiteSpace(_model.Email))
                _model.Email = result.email;
            if (result.cep is not null && string.IsNullOrWhiteSpace(_model.EnderecoEmpresaCep))
                _model.EnderecoEmpresaCep = result.cep;
            if (result.logradouro is not null && string.IsNullOrWhiteSpace(_model.EnderecoEmpresaRua))
                _model.EnderecoEmpresaRua = $"{result.descricao_tipo_logradouro} {result.logradouro}".Trim();
            if (result.numero is not null && string.IsNullOrWhiteSpace(_model.EnderecoEmpresaNumero))
                _model.EnderecoEmpresaNumero = result.numero;
            if (result.complemento is not null && string.IsNullOrWhiteSpace(_model.EnderecoEmpresaComplemento))
                _model.EnderecoEmpresaComplemento = result.complemento;
            if (result.bairro is not null && string.IsNullOrWhiteSpace(_model.EnderecoEmpresaBairro))
                _model.EnderecoEmpresaBairro = result.bairro;
            if (result.municipio is not null && string.IsNullOrWhiteSpace(_model.EnderecoEmpresaCidade))
                _model.EnderecoEmpresaCidade = result.municipio;
            if (result.uf is not null && string.IsNullOrWhiteSpace(_model.EnderecoEmpresaEstado))
                _model.EnderecoEmpresaEstado = result.uf;
        }
        catch (Exception ex) { Snackbar.Add($"Erro ao consultar CNPJ: {ex.Message}", Severity.Error); }
    }
    private void OnDocumentoChanged(string value)
    {
        _model.DocumentoEmpresa = value;
        AtualizarDocumentoLabel(value);
    }
    private void AtualizarDocumentoLabel(string? value)
    {
        var digits = new string((value ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length <= 11)
        {
            _documentoLabel = digits.Length == 11 ? "CPF" : "CPF ou CNPJ";
            _documentoHelper = digits.Length == 11
                ? "CPF detectado."
                : "Digite CPF (11 dígitos) ou CNPJ (14 dígitos).";
        }
        else
        {
            _documentoLabel = "CNPJ";
            _documentoHelper = "CNPJ detectado.";
        }
    }
    private async Task OnDocumentoBlur()
    {
        _model.DocumentoEmpresa = FormatCpfCnpj(_model.DocumentoEmpresa);
        AtualizarDocumentoLabel(_model.DocumentoEmpresa);
        if (!string.IsNullOrWhiteSpace(_model.DocumentoEmpresa) && !IsCpfOrCnpjValid(_model.DocumentoEmpresa))
        {
            Snackbar.Add($"{_documentoLabel} inválido.", Severity.Warning);
            return;
        }
        await BuscarCnpjAsync();
    }
    private static bool IsCpfOrCnpjValid(string? value)
    {
        var digits = new string((value ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length != 11 && digits.Length != 14) return false;
        if (new HashSet<char>(digits).Count == 1) return false;
        if (digits.Length == 11)
        {
            int[] w1 = [10, 9, 8, 7, 6, 5, 4, 3, 2];
            int[] w2 = [11, 10, 9, 8, 7, 6, 5, 4, 3, 2];
            var baseCpf = digits[..9];
            int calc(string input, int[] weights)
            {
                int s = 0;
                for (int i = 0; i < weights.Length; i++) s += (input[i] - '0') * weights[i];
                int r = s % 11;
                return r < 2 ? 0 : 11 - r;
            }
            int d1 = calc(baseCpf, w1);
            int d2 = calc(baseCpf + d1, w2);
            return digits[9] - '0' == d1 && digits[10] - '0' == d2;
        }
        else
        {
            int[] w1 = [5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2];
            int[] w2 = [6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2];
            var baseCnpj = digits[..12];
            int calc(string input, int[] weights)
            {
                int s = 0;
                for (int i = 0; i < weights.Length; i++) s += (input[i] - '0') * weights[i];
                int r = s % 11;
                return r < 2 ? 0 : 11 - r;
            }
            int d1 = calc(baseCnpj, w1);
            int d2 = calc(baseCnpj + d1, w2);
            return digits[12] - '0' == d1 && digits[13] - '0' == d2;
        }
    }
    private static string FormatCpfCnpj(string? value)
    {
        var digits = new string((value ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length == 11)
            return $"{digits[..3]}.{digits[3..6]}.{digits[6..9]}-{digits[9..]}";
        if (digits.Length == 14)
            return $"{digits[..2]}.{digits[2..5]}.{digits[5..8]}/{digits[8..12]}-{digits[12..]}";
        return value ?? "";
    }
