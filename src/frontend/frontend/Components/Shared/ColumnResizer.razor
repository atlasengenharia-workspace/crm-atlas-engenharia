@((MarkupString)Render())

@code {
    [Parameter, EditorRequired] public int Index { get; set; }
    [Parameter, EditorRequired] public string WrapperId { get; set; } = "";
    [Parameter, EditorRequired] public string StorageKey { get; set; } = "";

    private string Render()
    {
        return $"<span class='rt-resizer' title='Arrastar para redimensionar' " +
               $"style='position:absolute;right:-4px;top:0;bottom:0;width:16px;cursor:col-resize;" +
               $"z-index:100;background:rgba(0,0,0,0.08);user-select:none;pointer-events:auto;' " +
               $"onmouseenter=\"this.style.background='rgba(0,0,0,0.25)';\" " +
               $"onmouseleave=\"this.style.background='rgba(0,0,0,0.08)';\" " +
               $"onmousedown=\"event.preventDefault(); event.stopPropagation(); " +
               $"window.resizableTable.start('{WrapperId}', '{StorageKey}', {Index}, event.clientX);\">" +
               $"<svg width='6' height='100%' viewBox='0 0 6 100' preserveAspectRatio='none' " +
               $"style='position:absolute;right:5px;top:0;height:100%;opacity:.45;pointer-events:none;'>" +
               $"<line x1='2' y1='0' x2='2' y2='100' stroke='currentColor' stroke-width='1' />" +
               $"<line x1='4' y1='0' x2='4' y2='100' stroke='currentColor' stroke-width='1' />" +
               $"</svg></span>";
    }
}
