<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <base href="/" />
    <ResourcePreloader />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Radzen.Blazor/css/material-base.css"]" />
    <style>
        ::-webkit-scrollbar {
            width: 0 !important;
            height: 0 !important;
            display: none !important;
            background: transparent !important;
        }

        * {
            -ms-overflow-style: none !important;
            scrollbar-width: none !important;
        }

        .metric-card {
            min-height: 155px !important;
            height: 100% !important;
            display: flex !important;
            flex-direction: column !important;
            justify-content: space-between !important;
        }

        html, body {
            overflow-x: hidden !important;
            max-width: 100vw !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .mud-layout, .mud-main-content, .mud-container {
            max-width: 100vw !important;
            overflow-x: hidden !important;
            box-sizing: border-box !important;
        }

        /* Responsive Mobile & Tablet Optimizations */
        @@media (max-width: 960px) {
            .mud-main-content {
                padding-left: 8px !important;
                padding-right: 8px !important;
            }
            .mud-table-container {
                overflow-x: auto !important;
                -webkit-overflow-scrolling: touch;
            }
            .mud-drawer-responsive {
                width: 85vw !important;
                max-width: 320px !important;
            }
            .mud-button-root {
                min-height: 44px !important;
            }
            .atlas-panel {
                padding: 0.85rem !important;
            }
            .atlas-filter-panel {
                padding: 0.75rem !important;
            }
            .mud-grid {
                width: 100% !important;
                margin-left: 0 !important;
                margin-right: 0 !important;
            }
            .mud-grid-item {
                padding-left: 4px !important;
                padding-right: 4px !important;
            }
        }

        .inline-icon {
            vertical-align: middle;
        }
    </style>
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_content/Radzen.Blazor/Radzen.Blazor.js"]"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="/js/dashboardCharts.js"></script>
    <script src="/js/resizableTable.js?v=4"></script>
    <script>
        window.downloadFileFromBytes = (fileName, base64Data, contentType) => {
            const link = document.createElement('a');
            link.download = fileName;
            link.href = `data:${contentType || 'application/pdf'};base64,${base64Data}`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };
        window.downloadUrl = (url, fileName) => {
            const link = document.createElement('a');
            link.href = url;
            link.download = fileName;
            link.style.display = 'none';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };
        window.buscarCep = async (cep) => {
            const clean = (cep || '').replace(/\D/g, '');
            if (clean.length !== 8) return null;
            try {
                const resp = await fetch(`https://viacep.com.br/ws/${clean}/json/`);
                if (!resp.ok) return null;
                return await resp.json();
            } catch { return null; }
        };
        window.buscarCnpj = async (cnpj) => {
            const clean = (cnpj || '').replace(/\D/g, '');
            if (clean.length !== 14) return null;
            try {
                const resp = await fetch(`https://brasilapi.com.br/api/cnpj/v1/${clean}`);
                if (!resp.ok) return null;
                return await resp.json();
            } catch { return null; }
        };
    </script>
</body>

</html>
