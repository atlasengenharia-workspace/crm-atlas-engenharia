@page "/financeiro/lancamentos"
@attribute [Authorize]
@using Radzen.Blazor
@inject ILancamentoService Service
@inject ICadastroServicoService CadastroServicoService
@inject IPrestadorService PrestadorService
@inject IReceiptStorage ReceiptStorage
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Lançamentos | CRM Atlas</PageTitle>

<PageHeader Title="Lançamentos financeiros"
            Subtitle="Controle entradas, saídas, previsões e pagamentos realizados.">
    <Actions>
        <ValuesVisibilityToggle @bind-Hidden="_hideValues" />
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="New">Novo lançamento</MudButton>
    </Actions>
</PageHeader>

@if (_initialLoading)
{
    <TablePageSkeleton MetricCount="3" ColumnCount="6" />
}
else
{
<MudGrid Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudPaper Outlined="true" Class="pa-4">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Entradas no período</MudText>
            <MudText Typo="Typo.h5" Color="Color.Success">@Money(_summaryItems.Sum(x => x.Faturamento))</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Outlined="true" Class="pa-4">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Saídas no período</MudText>
            <MudText Typo="Typo.h5" Color="Color.Error">@Money(_summaryItems.Sum(x => x.CustoDireto))</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Outlined="true" Class="pa-4">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Saldo no período</MudText>
            <MudText Typo="Typo.h5" Color="@(_summaryItems.Sum(x => x.Lucro) >= 0 ? Color.Success : Color.Error)">
                @Money(_summaryItems.Sum(x => x.Lucro))
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_search" Label="Descrição ou código do serviço"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="LancamentoTipo?" @bind-Value="_tipo" Label="Tipo"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                <MudSelectItem T="LancamentoTipo?" Value="LancamentoTipo.ENTRADA">Entrada</MudSelectItem>
                <MudSelectItem T="LancamentoTipo?" Value="LancamentoTipo.SAIDA">Saída</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="LancamentoStatus?" @bind-Value="_status" Label="Status"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var status in Enum.GetValues<LancamentoStatus>())
                {
                    <MudSelectItem T="LancamentoStatus?" Value="@status">@StatusLabel(status)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2"><MudDatePicker @bind-Date="_startDate" Label="Data inicial" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" /></MudItem>
        <MudItem xs="6" md="2"><MudDatePicker @bind-Date="_endDate" Label="Data final" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" /></MudItem>
        <MudItem xs="12" md="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FilterAlt"
                       OnClick="ApplyFilterAsync" Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                }
                Aplicar filtros
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Outlined="true" Class="atlas-loading-host">
    <MudOverlay Visible="@(_loading && !_initialLoading)" Absolute="true"
                DarkBackground="false" Class="atlas-table-overlay">
        <div class="atlas-loading-badge">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.body2">Atualizando lançamentos...</MudText>
        </div>
    </MudOverlay>
    <SmartTableFilter TItem="LancamentoDto" Items="_result.Items" Columns="_filterColumns"
                      ProcessOnClient="false" TotalCount="_result.TotalItems"
                      OnStateChanged="OnSmartTableStateChanged">
    <ChildContent Context="smartItems">
    <RadzenDataGrid @ref="_grid" Data="@_result.Items" TItem="LancamentoDto"
                    Class="excel-grid" Style="width:100%;" AllowPaging="true" PageSize="50"
                    AllowColumnResize="true" AllowColumnPicking="true" AllowColumnReorder="true"
                    AllowSorting="true" AllowFiltering="true" AllowColumnFiltering="true" AllowGrouping="true" AllowAlternatingRows="true"
                    FilterMode="Radzen.FilterMode.CheckBoxList" Culture="@_ptBr" UICulture="@_ptBr"
                    Density="Radzen.Density.Compact" EmptyText="Nenhum lançamento encontrado"
                    GroupPanelText="Arraste um cabeçalho de coluna aqui para agrupar"
                    ColumnsShowingText="colunas visíveis">
        <Columns>
            <RadzenDataGridColumn TItem="LancamentoDto" Property="Data" Title="Data">
                <Template Context="context">@context.Data.ToString("dd/MM/yyyy")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LancamentoDto" Property="Descricao" Title="Lançamento">
                <Template Context="context">
                    <MudText Typo="Typo.body2"><strong>@context.Descricao</strong></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @context.Codigo @(!string.IsNullOrWhiteSpace(context.CodigoServico) ? $"• {context.CodigoServico}" : "")
                    </MudText>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LancamentoDto" Property="Tipo" Title="Tipo">
                <Template Context="context">
                    <MudChip T="string" Size="Size.Small"
                             Color="@(context.Tipo == LancamentoTipo.ENTRADA ? Color.Success : Color.Error)">
                        @(context.Tipo == LancamentoTipo.ENTRADA ? "Entrada" : "Saída")
                    </MudChip>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LancamentoDto" Property="Status" Title="Status">
                <Template Context="context">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@StatusLabel(context.Status)</MudChip>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LancamentoDto" Property="Valor" Title="Valor" TextAlign="Radzen.TextAlign.Right">
                <Template Context="context"><strong>@Money(context.Valor)</strong></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LancamentoDto" Property="CodigoServico" Title="Código serviço" />
            <RadzenDataGridColumn TItem="LancamentoDto" Property="NomeCliente" Title="Cliente" />
            <RadzenDataGridColumn TItem="LancamentoDto" Property="NumeroParcela" Title="Parcela" TextAlign="Radzen.TextAlign.Center">
                <Template Context="context">@(context.NumeroParcela is null ? "—" : $"{context.NumeroParcela}")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LancamentoDto" Property="NomePrestador" Title="Prestador" />
            <RadzenDataGridColumn TItem="LancamentoDto" Property="FormaPagamento" Title="Forma de pagamento" />
            <RadzenDataGridColumn TItem="LancamentoDto" Property="Plataforma" Title="Banco / plataforma" />
            <RadzenDataGridColumn TItem="LancamentoDto" Property="Empresa" Title="Empresa" />
            <RadzenDataGridColumn TItem="LancamentoDto" Property="Observacao" Title="Observação">
                <Template Context="context">@(context.Observacao ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LancamentoDto" Title="Comprovante" Sortable="false" Filterable="false" Resizable="false" TextAlign="Radzen.TextAlign.Center">
                <Template Context="context">
                    @if (!string.IsNullOrWhiteSpace(context.ComprovanteUrl))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile" Href="@context.ComprovanteUrl"
                                       Target="_blank" Size="Size.Small" aria-label="Abrir comprovante" />
                    }
                    else
                    {
                        <span>—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="LancamentoDto" Title="Ações" Sortable="false" Filterable="false" Resizable="false" TextAlign="Radzen.TextAlign.Right">
                <Template Context="context">
                    @if (!string.IsNullOrWhiteSpace(context.ComprovanteUrl))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile" Href="@context.ComprovanteUrl"
                                       Target="_blank" Size="Size.Small" aria-label="Abrir comprovante" />
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => Edit(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(context))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    </ChildContent>
    </SmartTableFilter>
    <MudDivider />
</MudPaper>

}

<MudDrawer @bind-Open="_editorOpen" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary"
           Width="min(560px, 100vw)" Elevation="8">
    <div class="pa-5">
        <MudToolBar Class="pa-0 mb-3">
            <MudText Typo="Typo.h5">@(_model.Id is null ? "Novo lançamento" : "Editar lançamento")</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _editorOpen = false)" />
        </MudToolBar>
        <MudDivider Class="mb-5" />
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="LancamentoTipo" @bind-Value="_model.Tipo" Label="Tipo"
                               Required="true" Variant="Variant.Outlined">
                        <MudSelectItem Value="LancamentoTipo.ENTRADA">Entrada</MudSelectItem>
                        <MudSelectItem Value="LancamentoTipo.SAIDA">Saída</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Value="_model.Descricao" Label="Descrição (preenchida pelo serviço)"
                                  ReadOnly="true" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_model.Data" Label="Data" Required="true"
                                   Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal" @bind-Value="_model.Valor" Label="Valor"
                                     Required="true" Min="0.01M" Format="C2" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="CadastroServicoDto" Value="SelectedService" ValueChanged="ServiceChanged"
                                     Label="Serviço vinculado" Variant="Variant.Outlined" Clearable="true"
                                     SearchFunc="SearchServicesAsync" ToStringFunc="ServiceLabel"
                                     CoerceText="false" ResetValueOnEmptyText="true"
                                     HelperText="Digite o código ou o nome do cliente para pesquisar." />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" Value="_model.NumeroParcela" ValueChanged="InstallmentChanged"
                               Label="Parcela" Variant="Variant.Outlined" Clearable="true" Disabled="_model.CadastroServicoId is null">
                        @foreach (var item in SelectedService?.Parcelas ?? [])
                        {
                            <MudSelectItem T="int?" Value="@item.NumeroParcela">Parcela @item.NumeroParcela — @Money(item.Valor ?? 0)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="long?" Value="_model.PrestadorId" ValueChanged="ProviderChanged"
                               Label="Prestador" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var item in FilteredProviders)
                        {
                            <MudSelectItem T="long?" Value="@item.Id">@item.Nome</MudSelectItem>
                        }
                    </MudSelect>
                    <MudCheckBox T="bool" @bind-Value="_showAllProviders" Color="Color.Primary"
                                 Label="Exibir todos os prestadores" Dense="true" Class="mt-1" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_model.FormaPagamento" Label="Forma de pagamento" Variant="Variant.Outlined" Clearable="true">
                        <MudSelectItem Value="@("PIX")">PIX</MudSelectItem><MudSelectItem Value="@("Boleto")">Boleto</MudSelectItem>
                        <MudSelectItem Value="@("Transferência")">Transferência</MudSelectItem><MudSelectItem Value="@("Cartão")">Cartão</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_model.Plataforma" Label="Banco / plataforma" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_model.Empresa" Label="Empresa pagadora / recebedora" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12">
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle2">Comprovante</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">PDF ou imagem, até 10 MB. Download protegido por autenticação.</MudText>
                        <div class="d-flex flex-wrap align-center gap-3 mt-3">
                            <InputFile OnChange="ReceiptSelected" accept=".pdf,.png,.jpg,.jpeg,.webp" />
                            @if (!string.IsNullOrWhiteSpace(_model.ComprovanteNomeArquivo))
                            {
                                <MudChip T="string" Icon="@Icons.Material.Filled.AttachFile">@_model.ComprovanteNomeArquivo</MudChip>
                            }
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Observacao" Label="Observações"
                                  Lines="3" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudForm>
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-6">
            <MudButton OnClick="@(() => _editorOpen = false)">Cancelar</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="_saving" OnClick="SaveAsync">
                @if (_saving)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    <span>Salvando...</span>
                }
                else
                {
                    <span>Salvar lançamento</span>
                }
            </MudButton>
        </MudStack>
    </div>
</MudDrawer>

@code {
    private RadzenDataGrid<LancamentoDto>? _grid;
    private readonly System.Globalization.CultureInfo _ptBr = new("pt-BR");
    private PagedResult<LancamentoDto> _result = new([], 1, 20, 0);
    private IReadOnlyList<LancamentoDto> _summaryItems = [];
    private readonly IReadOnlyList<SmartFilterColumn<LancamentoDto>> _filterColumns =
    [
        new("data","Data",x=>x.Data,1),new("lancamento","Lançamento",x=>x.Descricao,2),
        new("codigo","Código",x=>x.Codigo,2),new("servico","Serviço",x=>x.CodigoServico,2),
        new("tipo","Tipo",x=>x.Tipo==LancamentoTipo.ENTRADA?"Entrada":"Saída",3),
        new("status","Status",x=>StatusLabel(x.Status),4),new("valor","Valor",x=>x.Valor,5,true)
    ];
    private EntryModel _model = new();
    private IReadOnlyList<CadastroServicoDto> _services = [];
    private IReadOnlyList<PrestadorDto> _providers = [];
    private IBrowserFile? _receipt;
    private MudForm? _form;
    private bool _valid;
    private bool _hideValues;
    private bool _initialLoading = true;
    private bool _loading;
    private bool _saving;
    private bool _editorOpen;
    private readonly SemaphoreSlim _loadGate = new(1, 1);
    private string? _search;
    private LancamentoTipo? _tipo;
    private LancamentoStatus? _status;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private string? _sortKey;
    private bool _sortDescending;
    private bool _showAllProviders;

    private CadastroServicoDto? SelectedService => _services.FirstOrDefault(x => x.Id == _model.CadastroServicoId);
    private IEnumerable<PrestadorDto> FilteredProviders => _showAllProviders ? _providers : FilteredServiceProviders;
    private IEnumerable<PrestadorDto> FilteredServiceProviders
    {
        get
        {
            if (SelectedService is null) return [];
            var ids = SelectedService.Prestadores.Select(p => p.PrestadorId).Where(id => id is not null).ToHashSet();
            return _providers.Where(p => ids.Contains(p.Id));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _services = (await CadastroServicoService.ListAsync(new(null, null, null, 1, 5000, null, false))).Items;
            _providers = (await PrestadorService.ListAsync(new(PageSize: 5000))).Items;
            _result = await Service.ListAsync(CurrentFilter(1, 0));
            _summaryItems = _result.Items;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Não foi possível carregar os lançamentos: {ex.Message}", Severity.Error);
        }
        finally
        {
            _initialLoading = false;
        }
    }

    private async Task OnSmartTableStateChanged(SmartTableState state)
    {
        _search = state.Search;
        _sortKey = state.SortKey;
        _sortDescending = state.SortDescending;
        await LoadAsync();
    }

    private async Task ApplyFilterAsync() { await LoadAsync(); }

    private async Task LoadAsync()
    {
        await _loadGate.WaitAsync();
        _loading = true;
        try
        {
            if (_startDate.HasValue && _endDate.HasValue && _startDate.Value.Date > _endDate.Value.Date)
            {
                Snackbar.Add("A data inicial não pode ser posterior à data final.", Severity.Warning);
                return;
            }
            _result = await Service.ListAsync(CurrentFilter(1, 0));
            _summaryItems = _result.Items;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; _loadGate.Release(); }
    }

    private LancamentoFilter CurrentFilter(int page, int pageSize) => new(
        _tipo, _status,
        _startDate.HasValue ? DateOnly.FromDateTime(_startDate.Value) : null,
        _endDate.HasValue ? DateOnly.FromDateTime(_endDate.Value) : null,
        _search, _search, page, pageSize, _sortKey, _sortDescending);

    private void New() { _model = new(); _receipt = null; _editorOpen = true; }
    private void Edit(LancamentoDto x)
    {
        _model = new()
        {
            Id = x.Id, Tipo = x.Tipo, Status = x.Status, Origem = x.Origem,
            Descricao = x.Descricao, Data = x.Data.ToDateTime(TimeOnly.MinValue),
            Valor = x.Valor, CadastroServicoId = x.CadastroServicoId, PrestadorId = x.PrestadorId,
            CodigoServico = x.CodigoServico, NomeCliente = x.NomeCliente,
            NomePrestador = x.NomePrestador, FormaPagamento = x.FormaPagamento,
            NumeroParcela = x.NumeroParcela, DataPrevistaParcela = x.DataPrevistaParcela?.ToDateTime(TimeOnly.MinValue),
            MetodoPagamento = x.MetodoPagamento, Plataforma = x.Plataforma, Empresa = x.Empresa,
            ComprovanteUrl = x.ComprovanteUrl, ComprovanteNomeArquivo = x.ComprovanteNomeArquivo,
            Observacao = x.Observacao
        };
        _receipt = null;
        _editorOpen = true;
    }

    private Task<IEnumerable<CadastroServicoDto>> SearchServicesAsync(string value, CancellationToken cancellationToken) =>
        Task.FromResult(_services.Where(x => string.IsNullOrWhiteSpace(value)
            || x.Codigo?.Contains(value, StringComparison.OrdinalIgnoreCase) == true
            || x.RazaoSocialEmpresa.Contains(value, StringComparison.OrdinalIgnoreCase)).Take(50));

    private static string ServiceLabel(CadastroServicoDto? item) =>
        item is null ? string.Empty : $"{item.Codigo} — {item.RazaoSocialEmpresa}";

    private void ServiceChanged(CadastroServicoDto? service)
    {
        _model.CadastroServicoId = service?.Id;
        _model.NumeroParcela = null;
        _model.CodigoServico = service?.Codigo;
        _model.NomeCliente = service?.RazaoSocialEmpresa;
        _model.Descricao = service is null
            ? string.Empty
            : $"{service.Codigo} — {service.Subtipo} — {service.RazaoSocialEmpresa}";

        if (!_showAllProviders && service is not null)
        {
            var ids = service.Prestadores.Select(p => p.PrestadorId).Where(id => id is not null).ToHashSet();
            if (!ids.Contains(_model.PrestadorId))
            {
                _model.PrestadorId = null;
                _model.NomePrestador = null;
                _model.MetodoPagamento = null;
            }
        }
    }
    private void InstallmentChanged(int? number)
    {
        _model.NumeroParcela = number;
        var item = SelectedService?.Parcelas.FirstOrDefault(x => x.NumeroParcela == number);
        if (item is null) return;
        _model.Valor = item.Valor ?? _model.Valor;
        _model.DataPrevistaParcela = item.DataVencimento?.ToDateTime(TimeOnly.MinValue);
        _model.FormaPagamento = item.FormaPagamento;
    }
    private void ProviderChanged(long? id)
    {
        _model.PrestadorId = id;
        var item = _providers.FirstOrDefault(x => x.Id == id);
        _model.NomePrestador = item?.Nome;
        _model.MetodoPagamento = item?.MetodoPagamento;
    }
    private void ReceiptSelected(InputFileChangeEventArgs args) => _receipt = args.File;

    private async Task SaveAsync()
    {
        await (_form?.ValidateAsync() ?? Task.CompletedTask);
        if (!_valid || _model.Data is null) return;
        _saving = true;
        try
        {
            if (_receipt is not null)
            {
                await using var stream = _receipt.OpenReadStream(100 * 1024 * 1024);
                var stored = await ReceiptStorage.SaveAsync(stream, _receipt.Name, _receipt.ContentType);
                _model.ComprovanteUrl = $"/api/comprovantes/{stored.Key}";
                _model.ComprovanteNomeArquivo = stored.OriginalFileName;
            }
            var dto = _model.ToDto();
            if (_model.Id is null) await Service.CreateAsync(dto);
            else await Service.UpdateAsync(_model.Id.Value, dto);
            _editorOpen = false;
            Snackbar.Add("Lançamento salvo com sucesso.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(LancamentoDto x)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Excluir lançamento", $"Deseja excluir “{x.Descricao}”?", "Excluir", cancelText: "Cancelar");
        if (confirm != true || x.Id is null) return;
        try { await Service.DeleteAsync(x.Id.Value); await LoadAsync(); Snackbar.Add("Lançamento excluído.", Severity.Success); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private static string StatusLabel(LancamentoStatus status) => status switch
    {
        LancamentoStatus.A_PAGAR => "A pagar",
        LancamentoStatus.A_CONFIRMAR => "A confirmar",
        LancamentoStatus.PAGO => "Pago",
        _ => "Previsto"
    };
    private string Money(decimal value) => _hideValues ? "R$ ••••••" : value.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));

    private sealed class EntryModel
    {
        public long? Id { get; set; }
        public LancamentoTipo Tipo { get; set; } = LancamentoTipo.ENTRADA;
        public LancamentoStatus Status { get; set; } = LancamentoStatus.PREVISTO;
        public LancamentoOrigem Origem { get; set; } = LancamentoOrigem.MANUAL;
        public long? CadastroServicoId { get; set; }
        public long? PrestadorId { get; set; }
        public string? CodigoServico { get; set; }
        public string? NomeCliente { get; set; }
        public string? NomePrestador { get; set; }
        public string Descricao { get; set; } = "";
        public DateTime? Data { get; set; } = DateTime.Today;
        public decimal Valor { get; set; }
        public int? NumeroParcela { get; set; }
        public DateTime? DataPrevistaParcela { get; set; }
        public string? FormaPagamento { get; set; }
        public string? MetodoPagamento { get; set; }
        public string? Plataforma { get; set; }
        public string? Empresa { get; set; }
        public string? ComprovanteUrl { get; set; }
        public string? ComprovanteNomeArquivo { get; set; }
        public string? Observacao { get; set; }

        public LancamentoDto ToDto() => new(
            Id, null, Tipo, Status, Origem, CadastroServicoId, CodigoServico, NomeCliente,
            PrestadorId, NomePrestador, Descricao, DateOnly.FromDateTime(Data!.Value), Valor,
            NumeroParcela, DataPrevistaParcela is null ? null : DateOnly.FromDateTime(DataPrevistaParcela.Value),
            FormaPagamento, MetodoPagamento, Plataforma, Empresa, ComprovanteUrl, ComprovanteNomeArquivo, Observacao,
            0, 0, 0, null, null);
    }
}
