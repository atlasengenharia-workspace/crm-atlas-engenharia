@page "/clientes"
@attribute [Authorize]
@inject IClienteService ClienteService
@inject ICepLookupService CepLookupService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Clientes | CRM Atlas</PageTitle>

<PageHeader Title="Clientes" Subtitle="Cadastre e encontre empresas e pessoas atendidas pelo escritório.">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="New">
            Novo cliente
        </MudButton>
    </Actions>
</PageHeader>

<MudPaper Outlined="true" Class="atlas-filter-panel pa-4 mb-5 atlas-enter">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="gap-3">
        <MudTextField @bind-Value="_search" Placeholder="Buscar por nome, documento ou contato"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" OnKeyDown="SearchOnEnter" Class="flex-grow-1" Style="max-width: 500px;" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudSelect T="string" Label="Estado" @bind-Value="_estado" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Clearable="true" Style="min-width: 140px;">
                @foreach (var uf in Ufs)
                {
                    <MudSelectItem Value="@uf">@uf</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" OnClick="LoadAsync" Disabled="_loading"
                       StartIcon="@Icons.Material.Filled.FilterAlt">Filtrar</MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

<GlobalSkeleton IsLoading="_loading" Layout="GlobalSkeleton.SkeletonLayoutType.Table" MetricCount="3" ColumnCount="5">
    <section class="atlas-enter">
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MetricCard Title="Clientes" Value="@_statistics.TotalClientes.ToString("N0", PtBr)" Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MetricCard Title="Cidades atendidas" Value="@_statistics.TotalCidades.ToString("N0", PtBr)" Icon="@Icons.Material.Filled.LocationCity" Color="Color.Info" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MetricCard Title="Estados alcançados" Value="@_statistics.TotalEstados.ToString("N0", PtBr)" Icon="@Icons.Material.Filled.Map" Color="Color.Success" />
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-3">
            <MudItem xs="12">
                <MudPaper Outlined="true" Class="atlas-panel pa-5 mb-6">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="atlas-panel-heading mb-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h6">Empresas e pessoas</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@_result.TotalItems registro(s)</MudChip>
                        </MudStack>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add" OnClick="New">
                            Novo cliente
                        </MudButton>
                    </MudStack>

                    <MudTable Items="_result.Items" Hover="true" Loading="_loading" Breakpoint="Breakpoint.Sm"
                              Elevation="0" Class="atlas-data-table">
                        <HeaderContent>
                            <MudTh><MudTableSortLabel SortBy="@(new Func<ClienteDto, object>(x => x.RazaoSocial))">Cliente</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="@(new Func<ClienteDto, object>(x => x.CnpjCpf))">Documento</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="@(new Func<ClienteDto, object>(x => x.Telefone ?? ""))">Contato</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="@(new Func<ClienteDto, object>(x => x.Cidade ?? ""))">Localidade</MudTableSortLabel></MudTh>
                            <MudTh Class="text-right">Ações</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Cliente">
                                <MudText Typo="Typo.body2"><strong>@context.RazaoSocial</strong></MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.NomeContato</MudText>
                            </MudTd>
                            <MudTd DataLabel="Documento">@context.CnpjCpf</MudTd>
                            <MudTd DataLabel="Contato">
                                <MudText Typo="Typo.body2">@context.Telefone</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Email</MudText>
                            </MudTd>
                            <MudTd DataLabel="Localidade">@Location(context)</MudTd>
                            <MudTd DataLabel="Ações" Class="text-right">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               Color="Color.Primary" OnClick="@(() => Edit(context))"
                                               aria-label="Editar cliente" />
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                               Color="Color.Error" OnClick="@(() => DeleteAsync(context))"
                                               aria-label="Excluir cliente" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <EmptyState Title="Nenhum cliente cadastrado"
                                        Message="Cadastre empresas e pessoas para vincular a serviços e orçamentos." />
                        </NoRecordsContent>
                    </MudTable>

                    @if (_result.TotalPages > 1)
                    {
                        <MudDivider Class="my-3" />
                        <MudToolBar Class="justify-space-between flex-wrap gap-2 pa-0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @_result.TotalItems registro(s)
                            </MudText>
                            <MudPagination Count="_result.TotalPages" Selected="_page"
                                           SelectedChanged="PageChangedAsync" Color="Color.Primary" />
                        </MudToolBar>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </section>
</GlobalSkeleton>

<MudDrawer @bind-Open="_editorOpen" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary"
           Width="min(560px, 100vw)" Elevation="8">
    <div class="pa-5">
        <MudToolBar Class="pa-0 mb-3">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">@(_model.Id is null ? "Novo cliente" : "Editar cliente")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Dados cadastrais e de contato</MudText>
            </MudStack>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _editorOpen = false)"
                           aria-label="Fechar formulário" />
        </MudToolBar>
        <MudDivider Class="mb-5" />
        <MudForm @ref="_form" @bind-IsValid="_formValid">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.RazaoSocial" Label="Razão social / nome"
                                  Required="true" RequiredError="Informe a razão social."
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.CnpjCpf" Label="CPF ou CNPJ"
                                  Required="true" RequiredError="Informe o CPF ou CNPJ."
                                  Variant="Variant.Outlined" OnBlur="FormatDocument"
                                  HelperText="A máscara é aplicada automaticamente." />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.NomeContato" Label="Pessoa de contato"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Telefone" Label="Telefone"
                                  Variant="Variant.Outlined" InputType="InputType.Telephone"
                                  OnBlur="FormatPhone" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Email" Label="E-mail"
                                  Variant="Variant.Outlined" InputType="InputType.Email"
                                  Validation="@(new EmailAddressAttribute { ErrorMessage = "Informe um e-mail válido." })" />
                </MudItem>
                <MudItem xs="12"><MudDivider Class="my-2" /></MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_model.Cep" Label="CEP"
                                  Variant="Variant.Outlined" OnBlur="FormatCep"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_lookingUpCep ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Search)"
                                  OnAdornmentClick="LookupCepAsync" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex align-center">
                    <MudButton Variant="Variant.Outlined" OnClick="LookupCepAsync"
                               Disabled="_lookingUpCep" FullWidth="true">
                        Buscar CEP
                    </MudButton>
                </MudItem>
                <MudItem xs="12" sm="9">
                    <MudTextField @bind-Value="_model.Rua" Label="Logradouro"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="_model.Numero" Label="Número"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Complemento" Label="Complemento"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Bairro" Label="Bairro"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_model.Cidade" Label="Cidade"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_model.Estado" Label="UF"
                               Variant="Variant.Outlined">
                        @foreach (var uf in Ufs)
                        {
                            <MudSelectItem Value="@uf">@uf</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudForm>

        <MudDivider Class="mt-6 mb-4" />
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Outlined" OnClick="@(() => _editorOpen = false)">
                Cancelar
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="SaveAsync" Disabled="_saving">
                @(_saving ? "Salvando..." : "Salvar cliente")
            </MudButton>
        </MudStack>
    </div>
</MudDrawer>

@code {
    private static readonly System.Globalization.CultureInfo PtBr = new("pt-BR");
    private static readonly string[] Ufs =
        ["AC","AL","AP","AM","BA","CE","DF","ES","GO","MA","MT","MS","MG","PA","PB","PR","PE","PI","RJ","RN","RS","RO","RR","SC","SP","SE","TO"];
    private PagedResult<ClienteDto> _result = new([], 1, 20, 0);
    private ClienteStatistics _statistics = new(0, 0, 0);
    private ClienteEditModel _model = new();
    private MudForm? _form;
    private bool _formValid;
    private bool _loading;
    private bool _saving;
    private bool _editorOpen;
    private bool _lookingUpCep;
    private string? _search;
    private string? _estado;
    private int _page = 1;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _result = await ClienteService.ListAsync(new(
                null, _search, _search, _search, _search, null, _estado, _page, 20));
            _statistics = await ClienteService.GetStatisticsAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task SearchOnEnter(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") { _page = 1; await LoadAsync(); }
    }

    private async Task PageChangedAsync(int page) { _page = page; await LoadAsync(); }
    private void New() { _model = new(); _editorOpen = true; }
    private void Edit(ClienteDto item) { _model = ClienteEditModel.From(item); _editorOpen = true; }

    private async Task SaveAsync()
    {
        await (_form?.ValidateAsync() ?? Task.CompletedTask);
        if (!_formValid) return;
        _saving = true;
        try
        {
            var dto = _model.ToDto();
            if (_model.Id is null) await ClienteService.CreateAsync(dto);
            else await ClienteService.UpdateAsync(_model.Id.Value, dto);
            Snackbar.Add("Cliente salvo com sucesso.", Severity.Success);
            _editorOpen = false;
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(ClienteDto item)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Excluir cliente",
            $"Deseja excluir “{item.RazaoSocial}”? Esta ação não pode ser desfeita.",
            yesText: "Excluir", cancelText: "Cancelar");
        if (confirm != true || item.Id is null) return;
        try
        {
            await ClienteService.DeleteAsync(item.Id.Value);
            Snackbar.Add("Cliente excluído.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private static string Location(ClienteDto item) =>
        string.Join(" - ", new[] { item.Cidade, item.Estado }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private void FormatDocument(FocusEventArgs _) => _model.CnpjCpf = BrazilianMasks.Document(_model.CnpjCpf);
    private void FormatPhone(FocusEventArgs _) => _model.Telefone = BrazilianMasks.Phone(_model.Telefone);
    private void FormatCep(FocusEventArgs _) => _model.Cep = BrazilianMasks.Cep(_model.Cep);

    private async Task LookupCepAsync()
    {
        _lookingUpCep = true;
        try
        {
            var address = await CepLookupService.FindAsync(_model.Cep ?? "");
            if (address is null) { Snackbar.Add("CEP não encontrado.", Severity.Warning); return; }
            _model.Cep = BrazilianMasks.Cep(address.Cep);
            _model.Rua = address.Rua;
            _model.Bairro = address.Bairro;
            _model.Cidade = address.Cidade;
            _model.Estado = address.Estado;
            Snackbar.Add("Endereço preenchido pelo CEP.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Não foi possível consultar o CEP: {ex.Message}", Severity.Error); }
        finally { _lookingUpCep = false; }
    }

    private static class BrazilianMasks
    {
        public static string Document(string? value)
        {
            var d = Digits(value, 14);
            return d.Length <= 11
                ? Apply(d, "###.###.###-##")
                : Apply(d, "##.###.###/####-##");
        }
        public static string? Phone(string? value)
        {
            var d = Digits(value, 11);
            if (d.Length == 0) return null;
            return d.Length <= 10 ? Apply(d, "(##) ####-####") : Apply(d, "(##) #####-####");
        }
        public static string? Cep(string? value)
        {
            var d = Digits(value, 8);
            return d.Length == 0 ? null : Apply(d, "#####-###");
        }
        private static string Digits(string? value, int max) => new((value ?? "").Where(char.IsDigit).Take(max).ToArray());
        private static string Apply(string digits, string pattern)
        {
            var result = new System.Text.StringBuilder();
            var index = 0;
            foreach (var c in pattern)
            {
                if (c == '#')
                {
                    if (index >= digits.Length) break;
                    result.Append(digits[index++]);
                }
                else if (index > 0 && index < digits.Length) result.Append(c);
            }
            return result.ToString();
        }
    }

    private sealed class ClienteEditModel
    {
        public long? Id { get; set; }
        public string CnpjCpf { get; set; } = "";
        public string RazaoSocial { get; set; } = "";
        public string? NomeContato { get; set; }
        public string? Telefone { get; set; }
        public string? Email { get; set; }
        public string? Rua { get; set; }
        public string? Numero { get; set; }
        public string? Bairro { get; set; }
        public string? Complemento { get; set; }
        public string? Cidade { get; set; }
        public string? Estado { get; set; }
        public string? Cep { get; set; }

        public static ClienteEditModel From(ClienteDto x) => new()
        {
            Id = x.Id, CnpjCpf = x.CnpjCpf, RazaoSocial = x.RazaoSocial,
            NomeContato = x.NomeContato, Telefone = x.Telefone, Email = x.Email,
            Rua = x.Rua, Numero = x.Numero, Bairro = x.Bairro, Complemento = x.Complemento,
            Cidade = x.Cidade, Estado = x.Estado, Cep = x.Cep
        };

        public ClienteDto ToDto() => new(
            Id, CnpjCpf, RazaoSocial, NomeContato, Telefone, Email, Rua, Numero,
            Bairro, Complemento, Cidade, Estado, Cep);
    }
}
