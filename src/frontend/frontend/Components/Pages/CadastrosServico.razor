@page "/servicos"
@attribute [Authorize]
@inject ICadastroServicoService Service
@inject IClienteService ClienteService
@inject ICondicaoPagamentoService CondicaoService
@inject IOrcamentoService OrcamentoService
@inject IPrestadorService PrestadorService
@inject IAcompanhamentoService AcompanhamentoService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Cadastros de serviço | CRM Atlas</PageTitle>

<PageHeader Title="Cadastros de serviço"
            Subtitle="Centralize contrato, cliente, parcelas e dados operacionais.">
    <Actions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="New">Novo serviço</MudButton>
    </Actions>
</PageHeader>

<GlobalSkeleton IsLoading="_loading" Layout="GlobalSkeleton.SkeletonLayoutType.Table" MetricCount="0" ColumnCount="6">
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="5">
                <MudTextField @bind-Value="_search" Label="Código ou documento da empresa"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="AcompanhamentoServicoTipo?" @bind-Value="_tipo"
                           Label="Tipo de serviço" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true">
                    @foreach (var type in Enum.GetValues<AcompanhamentoServicoTipo>())
                    {
                        <MudSelectItem T="AcompanhamentoServicoTipo?" Value="@type">@TypeLabel(type)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" @bind-Value="_situacao"
                           Label="Situação" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true">
                    @foreach (var status in AvailableSituations)
                    {
                        <MudSelectItem Value="@status">@status</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_ocultarConcluidos" Color="Color.Primary">
                    Ocultar concluídos
                </MudSwitch>
            </MudItem>
            <MudItem xs="12" sm="6" md="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FilterAlt"
                           OnClick="ApplyFilterAsync">Filtrar</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Outlined="true">
        <SmartTableFilter TItem="CadastroServicoDto" Items="_result.Items" Columns="_filterColumns">
        <ChildContent Context="smartItems">
        <MudTable Items="smartItems" Hover="true" Loading="_loading" Elevation="0"
                  Breakpoint="Breakpoint.Md">
            <HeaderContent>
                <MudTh>Código</MudTh><MudTh>Empresa</MudTh><MudTh>Serviço</MudTh><MudTh>Situação</MudTh>
                <MudTh>Contrato</MudTh><MudTh>Entrada</MudTh><MudTh Class="text-right">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código"><strong>@context.Codigo</strong></MudTd>
                <MudTd DataLabel="Empresa">
                    <MudText Typo="Typo.body2"><strong>@context.RazaoSocialEmpresa</strong></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.DocumentoEmpresa</MudText>
                </MudTd>
                <MudTd DataLabel="Serviço">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@TypeLabel(context.TipoServico)</MudChip>
                    <MudText Typo="Typo.caption" Class="ml-1">@context.Subtipo</MudText>
                </MudTd>
                <MudTd DataLabel="Situação">
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.SituacaoInicial)">
                        @(context.SituacaoInicial ?? "Não informada")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Contrato">@Money(context.ValorContrato ?? 0)</MudTd>
                <MudTd DataLabel="Entrada">@context.DataEntrada.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Ações" Class="text-right">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => Edit(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Title="Nenhum serviço encontrado"
                            Message="Cadastre o primeiro contrato para iniciar a operação." />
            </NoRecordsContent>
        </MudTable>
        </ChildContent>
        </SmartTableFilter>
        @if (_result.TotalPages > 1)
        {
            <MudDivider />
            <MudToolBar Class="justify-end pa-4">
                <MudPagination Count="_result.TotalPages" Selected="_page" SelectedChanged="PageChangedAsync" Color="Color.Primary" />
            </MudToolBar>
        }
    </MudPaper>
</GlobalSkeleton>

<MudDrawer @bind-Open="_editorOpen" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary"
           Width="min(820px, 100vw)" Elevation="8">
    <div class="pa-5">
        <MudToolBar Class="pa-0 mb-3">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">@(_model.Id is null ? "Novo serviço" : $"Editar {_model.Codigo}")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Preencha contrato e plano financeiro.</MudText>
            </MudStack>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _editorOpen = false)" />
        </MudToolBar>
        <MudDivider Class="mb-4" />

        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudTabs Elevation="0" Rounded="true" Class="service-tabs">
                <MudTabPanel Text="Identificação" Icon="@Icons.Material.Filled.Business">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudSelect T="long?" @bind-Value="_model.ClienteId" Label="Cliente cadastrado"
                                       Variant="Variant.Outlined" Clearable="true">
                                @foreach (var cliente in _clientes)
                                {
                                    <MudSelectItem T="long?" Value="@cliente.Id">@cliente.RazaoSocial</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_model.DocumentoEmpresa" Label="CPF ou CNPJ"
                                          Required="true" RequiredError="Informe o documento."
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.RazaoSocialEmpresa" Label="Razão social"
                                          Required="true" RequiredError="Informe a razão social."
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_model.ContatoEmpresa" Label="Pessoa de contato"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudTextField @bind-Value="_model.Telefone" Label="Telefone" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudTextField @bind-Value="_model.Email" Label="E-mail" Variant="Variant.Outlined"
                                          InputType="InputType.Email" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.EnderecoEmpresa" Label="Endereço da empresa"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudSwitch T="bool" @bind-Value="_model.MesmoEnderecoEmpresa" Color="Color.Primary">
                                Serviço executado no mesmo endereço
                            </MudSwitch>
                        </MudItem>
                        @if (!_model.MesmoEnderecoEmpresa)
                        {
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_model.EnderecoServico" Label="Endereço do serviço"
                                              Variant="Variant.Outlined" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudTabPanel>
                <MudTabPanel Text="Serviço e contrato" Icon="@Icons.Material.Filled.Assignment">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudSelect T="long?" Value="_model.OrcamentoId" ValueChanged="BudgetChanged"
                                       Label="Converter orçamento existente" Clearable="true"
                                       Variant="Variant.Outlined" HelperText="Tipo, cliente e valor serão aproveitados automaticamente.">
                                @foreach (var budget in _budgets.Where(x => !ClosedBudget(x.Situacao)))
                                {
                                    <MudSelectItem T="long?" Value="@budget.Id">@budget.Codigo — @budget.Nome — @Money(budget.ValorTotal ?? 0)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="AcompanhamentoServicoTipo" Value="_model.TipoServico"
                                       Label="Tipo de serviço" Required="true" Variant="Variant.Outlined"
                                       ValueChanged="TypeChanged">
                                @foreach (var type in Enum.GetValues<AcompanhamentoServicoTipo>())
                                {
                                    <MudSelectItem Value="@type">@TypeLabel(type)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" @bind-Value="_model.Subtipo" Label="Subtipo"
                                       Required="true" RequiredError="Informe o subtipo."
                                       Variant="Variant.Outlined">
                                @foreach (var subtype in CurrentSubtypes)
                                {
                                    <MudSelectItem Value="@subtype">@subtype</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="_model.DataEntrada" Label="Data de entrada"
                                           Required="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="string" @bind-Value="_model.SituacaoInicial"
                                             Label="Situação" Variant="Variant.Outlined"
                                             SearchFunc="SearchSituationsAsync"
                                             CoerceText="true" CoerceValue="true"
                                             Clearable="true"
                                             HelperText="Selecione uma situação ou digite uma nova." />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="_model.DataContrato" Label="Data do contrato"
                                           Required="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="decimal?" @bind-Value="_model.ValorContrato"
                                             Label="Valor do contrato" Required="true" Min="0"
                                             Format="C2" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="long?" @bind-Value="_model.CondicaoPagamentoId"
                                       Label="Condição de pagamento" Clearable="true"
                                       Variant="Variant.Outlined">
                                @foreach (var condition in _conditions)
                                {
                                    <MudSelectItem T="long?" Value="@condition.Id">@condition.Nome</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="decimal?" @bind-Value="_model.ValorNotaFiscal"
                                             Label="Desconto / retenção NF" Min="0"
                                             Format="C2" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
                <MudTabPanel Text="Parcelas" Icon="@Icons.Material.Filled.Payments">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <div>
                            <MudText Typo="Typo.h6">Plano financeiro</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Líquido: @Money(NetValue) • Parcelado: @Money(InstallmentTotal)
                            </MudText>
                        </div>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddInstallment">Adicionar parcela</MudButton>
                    </div>
                    @if (_model.Parcelas.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                            Informe ao menos uma parcela.
                        </MudAlert>
                    }
                    @for (var i = 0; i < _model.Parcelas.Count; i++)
                    {
                        var index = i;
                        var installment = _model.Parcelas[index];
                        <MudPaper Outlined="true" Class="pa-3 mb-3">
                            <MudGrid Spacing="2">
                                <MudItem xs="4" sm="2">
                                    <MudNumericField T="int?" @bind-Value="installment.Numero"
                                                     Label="Parcela" Min="1" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="8" sm="3">
                                    <MudNumericField T="decimal?" @bind-Value="installment.Valor"
                                                     Label="Valor" Min="0" Format="C2" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="10" sm="3">
                                    <MudDatePicker @bind-Date="installment.Vencimento"
                                                   Label="Vencimento" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="10" sm="3">
                                    <MudTextField @bind-Value="installment.FormaPagamento"
                                                  Label="Forma" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="2" sm="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                   Color="Color.Error" OnClick="@(() => RemoveInstallment(index))" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                    @if (_model.Parcelas.Count > 0 && InstallmentTotal != NetValue)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                            A soma das parcelas deve ser igual ao valor líquido. Diferença:
                            @Money(NetValue - InstallmentTotal)
                        </MudAlert>
                    }
                </MudTabPanel>
                <MudTabPanel Text="Prestadores e custos" Icon="@Icons.Material.Filled.Engineering">
                    <div class="d-flex flex-wrap justify-space-between align-center gap-2 mb-4">
                        <div>
                            <MudText Typo="Typo.h6">Prestadores vinculados</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Provisionado: @Money(ProviderProvisioned) • Efetivo: @Money(ProviderActual)</MudText>
                        </div>
                        <div>
                            <MudButton Href="/prestadores" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.PersonAdd">Cadastrar prestador</MudButton>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddProvider">Vincular</MudButton>
                        </div>
                    </div>
                    @if (_model.Prestadores.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Nenhum prestador vinculado a este serviço.</MudAlert>
                    }
                    @for (var i = 0; i < _model.Prestadores.Count; i++)
                    {
                        var index = i;
                        var provider = _model.Prestadores[index];
                        <MudPaper Outlined="true" Class="pa-4 mb-3">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="5">
                                    <MudSelect T="long?" Value="provider.PrestadorId" ValueChanged="@((long? value) => ProviderChanged(index, value))"
                                               Label="Prestador" Variant="Variant.Outlined" Clearable="true">
                                        @foreach (var item in _providers)
                                        {
                                            <MudSelectItem T="long?" Value="@item.Id">@item.Nome</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="6" md="3"><MudNumericField T="decimal?" @bind-Value="provider.ValorProvisionado" Label="Provisionado" Min="0" Format="C2" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="6" md="3"><MudNumericField T="decimal?" @bind-Value="provider.ValorEfetivo" Label="Efetivo" Min="0" Format="C2" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="10" md="4">
                                    <MudSelect T="PrestadorPagamentoDataTipo" @bind-Value="provider.DataPagamentoTipo" Label="Data de pagamento" Variant="Variant.Outlined">
                                        <MudSelectItem Value="PrestadorPagamentoDataTipo.A_DEFINIR">A definir</MudSelectItem>
                                        <MudSelectItem Value="PrestadorPagamentoDataTipo.TERMINO_SERVICO">No término do serviço</MudSelectItem>
                                        <MudSelectItem Value="PrestadorPagamentoDataTipo.DATA">Data específica</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                @if (provider.DataPagamentoTipo == PrestadorPagamentoDataTipo.DATA)
                                {
                                    <MudItem xs="10" md="4"><MudDatePicker @bind-Date="provider.DataPagamento" Label="Pagamento" Variant="Variant.Outlined" /></MudItem>
                                }
                                <MudItem xs="10" md="3" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="provider.Confirmado" Label="Confirmado" Color="Color.Success" /></MudItem>
                                <MudItem xs="2" md="1"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="@(() => RemoveProvider(index))" aria-label="Remover prestador" /></MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudTabPanel>
            </MudTabs>
        </MudForm>
        <MudDivider Class="my-5" />
        <MudStack Row="true" Justify="Justify.FlexEnd">
            <MudButton OnClick="@(() => _editorOpen = false)">Cancelar</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving"
                       StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">Salvar serviço</MudButton>
        </MudStack>
    </div>
</MudDrawer>

@code {
    private PagedResult<CadastroServicoDto> _result = new([], 1, 20, 0);
    private readonly IReadOnlyList<SmartFilterColumn<CadastroServicoDto>> _filterColumns =
    [
        new("codigo","Código",x=>x.Codigo),new("empresa","Empresa",x=>x.RazaoSocialEmpresa),
        new("documento","Documento",x=>x.DocumentoEmpresa),new("tipo","Tipo",x=>TypeLabel(x.TipoServico)),
        new("subtipo","Serviço",x=>x.Subtipo),new("situacao","Situação",x=>x.SituacaoInicial),
        new("contrato","Contrato",x=>x.ValorContrato),new("entrada","Entrada",x=>x.DataEntrada.ToString("dd/MM/yyyy"))
    ];
    private IReadOnlyList<ClienteDto> _clientes = [];
    private IReadOnlyList<CondicaoPagamentoDto> _conditions = [];
    private IReadOnlyList<CadastroServicoSubtipoConfigDto> _subtypes = [];
    private IReadOnlyList<OrcamentoDto> _budgets = [];
    private IReadOnlyList<PrestadorDto> _providers = [];
    private IReadOnlyList<SituacaoConfigDto> _situations = [];
    private ServiceModel _model = new();
    private MudForm? _form;
    private bool _valid;
    private bool _loading;
    private bool _saving;
    private bool _editorOpen;
    private string? _search;
    private AcompanhamentoServicoTipo? _tipo;
    private string? _situacao;
    private bool _ocultarConcluidos = true;
    private int _page = 1;

    private IEnumerable<string> AvailableSituations =>
        _situations.Where(x => x.Ativo && (_tipo is null || x.Tipo == _tipo))
            .Select(x => x.Nome)
            .Concat(_result.Items.Select(x => x.SituacaoInicial).OfType<string>())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x);
    private IEnumerable<string> CurrentSubtypes =>
        _subtypes.FirstOrDefault(x => x.TipoServico == _model.TipoServico)?.Subtipos ?? [];
    private decimal NetValue => Math.Max(0, (_model.ValorContrato ?? 0) - (_model.ValorNotaFiscal ?? 0));
    private decimal InstallmentTotal => _model.Parcelas.Sum(x => x.Valor ?? 0);
    private decimal ProviderProvisioned => _model.Prestadores.Sum(x => x.ValorProvisionado ?? 0);
    private decimal ProviderActual => _model.Prestadores.Sum(x => x.ValorEfetivo ?? 0);

    protected override async Task OnInitializedAsync()
    {
        await LoadReferencesAsync();
        await LoadAsync();
    }

    private async Task LoadReferencesAsync()
    {
        try
        {
            var clients = await ClienteService.ListAsync(new(
                null, null, null, null, null, null, null, 1, 2000));
            _clientes = clients.Items;
            _conditions = await CondicaoService.ListAsync();
            _subtypes = await Service.ListSubtiposAsync();
            _budgets = await OrcamentoService.ListAsync();
            _providers = await PrestadorService.ListAsync();
            _situations = await AcompanhamentoService.ListSituationsAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _result = await Service.ListAsync(new(
            _search, _search, _tipo, _page, 20, _situacao, _ocultarConcluidos)); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task ApplyFilterAsync() { _page = 1; await LoadAsync(); }
    private async Task PageChangedAsync(int page) { _page = page; await LoadAsync(); }
    private void New()
    {
        _model = new();
        AddInstallment();
        _editorOpen = true;
    }
    private void Edit(CadastroServicoDto x) { _model = ServiceModel.From(x); _editorOpen = true; }
    private void TypeChanged(AcompanhamentoServicoTipo value)
    {
        _model.TipoServico = value;
        _model.Subtipo = CurrentSubtypes.FirstOrDefault() ?? "";
        _model.SituacaoInicial = _situations
            .Where(x => x.Tipo == value && x.Ativo)
            .OrderByDescending(x => x.Inicial)
            .ThenBy(x => x.Ordem)
            .Select(x => x.Nome)
            .FirstOrDefault();
    }

    private Task<IEnumerable<string>> SearchSituationsAsync(string value, CancellationToken cancellationToken) =>
        Task.FromResult(_situations
            .Where(x => x.Tipo == _model.TipoServico && x.Ativo)
            .Select(x => x.Nome)
            .Where(x => string.IsNullOrWhiteSpace(value)
                || x.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .AsEnumerable());
    private void AddInstallment() => _model.Parcelas.Add(new()
    {
        Numero = _model.Parcelas.Count + 1,
        Vencimento = DateTime.Today.AddMonths(_model.Parcelas.Count + 1)
    });
    private void RemoveInstallment(int index) => _model.Parcelas.RemoveAt(index);
    private void AddProvider() => _model.Prestadores.Add(new());
    private void RemoveProvider(int index) => _model.Prestadores.RemoveAt(index);
    private void ProviderChanged(int index, long? id)
    {
        _model.Prestadores[index].PrestadorId = id;
        _model.Prestadores[index].NomePrestador = _providers.FirstOrDefault(x => x.Id == id)?.Nome;
    }
    private void BudgetChanged(long? id)
    {
        _model.OrcamentoId = id;
        var budget = _budgets.FirstOrDefault(x => x.Id == id);
        if (budget is null) return;
        _model.TipoServico = budget.TipoServico;
        _model.Subtipo = CurrentSubtypes.FirstOrDefault() ?? _model.Subtipo;
        _model.ValorContrato = budget.ValorTotal;
        if (!string.IsNullOrWhiteSpace(budget.Nome)) _model.RazaoSocialEmpresa = budget.Nome;
        if (!string.IsNullOrWhiteSpace(budget.Telefone)) _model.Telefone = budget.Telefone;
    }

    private async Task SaveAsync()
    {
        await (_form?.ValidateAsync() ?? Task.CompletedTask);
        if (!_valid) return;
        if (InstallmentTotal != NetValue)
        {
            Snackbar.Add("A soma das parcelas deve fechar com o valor líquido.", Severity.Warning);
            return;
        }
        _saving = true;
        try
        {
            var dto = _model.ToDto();
            if (_model.Id is null) await Service.CreateAsync(dto);
            else await Service.UpdateAsync(_model.Id.Value, dto);
            _editorOpen = false;
            Snackbar.Add("Serviço salvo com sucesso.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(CadastroServicoDto x)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Excluir serviço", $"Deseja excluir o cadastro {x.Codigo}?", "Excluir", cancelText: "Cancelar");
        if (confirm != true || x.Id is null) return;
        try { await Service.DeleteAsync(x.Id.Value); await LoadAsync(); Snackbar.Add("Serviço excluído.", Severity.Success); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private static string TypeLabel(AcompanhamentoServicoTipo type) => type switch
    {
        AcompanhamentoServicoTipo.PROCESSOS_ADM => "Processo administrativo",
        AcompanhamentoServicoTipo.OBRAS => "Obras",
        _ => type.ToString()
    };
    private static string Money(decimal value) => value.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));
    private static Color StatusColor(string? status) =>
        status?.Contains("conclu", StringComparison.OrdinalIgnoreCase) == true
        || status?.Contains("finaliz", StringComparison.OrdinalIgnoreCase) == true
            ? Color.Success
            : status?.Contains("análise", StringComparison.OrdinalIgnoreCase) == true
              || status?.Contains("analise", StringComparison.OrdinalIgnoreCase) == true
                ? Color.Warning
                : Color.Default;
    private static bool ClosedBudget(string status) =>
        status.Contains("fech", StringComparison.OrdinalIgnoreCase)
        || status.Contains("recus", StringComparison.OrdinalIgnoreCase);

    private sealed class ServiceModel
    {
        public long? Id { get; set; }
        public string? Codigo { get; set; }
        public long? ClienteId { get; set; }
        public long? OrcamentoId { get; set; }
        public long? CondicaoPagamentoId { get; set; }
        public AcompanhamentoServicoTipo TipoServico { get; set; } = AcompanhamentoServicoTipo.AVCB;
        public string Subtipo { get; set; } = "Projeto";
        public DateTime? DataEntrada { get; set; } = DateTime.Today;
        public string? SituacaoInicial { get; set; }
        public string DocumentoEmpresa { get; set; } = "";
        public string RazaoSocialEmpresa { get; set; } = "";
        public string? ContatoEmpresa { get; set; }
        public string? Telefone { get; set; }
        public string? Email { get; set; }
        public string? EnderecoEmpresa { get; set; }
        public string? EnderecoServico { get; set; }
        public bool MesmoEnderecoEmpresa { get; set; } = true;
        public decimal? ValorContrato { get; set; }
        public DateTime? DataContrato { get; set; } = DateTime.Today;
        public decimal? ValorNotaFiscal { get; set; }
        public List<InstallmentModel> Parcelas { get; set; } = [];
        public List<ProviderModel> Prestadores { get; set; } = [];

        public static ServiceModel From(CadastroServicoDto x) => new()
        {
            Id = x.Id, Codigo = x.Codigo, ClienteId = x.ClienteId, OrcamentoId = x.OrcamentoId,
            CondicaoPagamentoId = x.CondicaoPagamentoId, TipoServico = x.TipoServico,
            Subtipo = x.Subtipo, DataEntrada = x.DataEntrada.ToDateTime(TimeOnly.MinValue),
            SituacaoInicial = x.SituacaoInicial, DocumentoEmpresa = x.DocumentoEmpresa,
            RazaoSocialEmpresa = x.RazaoSocialEmpresa, ContatoEmpresa = x.ContatoEmpresa,
            Telefone = x.Telefone, Email = x.Email, EnderecoEmpresa = x.EnderecoEmpresa,
            EnderecoServico = x.EnderecoServico, MesmoEnderecoEmpresa = x.MesmoEnderecoEmpresa,
            ValorContrato = x.ValorContrato,
            DataContrato = x.DataContrato?.ToDateTime(TimeOnly.MinValue),
            ValorNotaFiscal = x.ValorNotaFiscal,
            Parcelas = x.Parcelas.Select(p => new InstallmentModel
            {
                Id = p.Id, Numero = p.NumeroParcela, Valor = p.Valor,
                Vencimento = p.DataVencimento?.ToDateTime(TimeOnly.MinValue),
                FormaPagamento = p.FormaPagamento
            }).ToList(),
            Prestadores = x.Prestadores.Select(p => new ProviderModel
            {
                Id = p.Id, PrestadorId = p.PrestadorId, NomePrestador = p.NomePrestador,
                ValorProvisionado = p.ValorProvisionado, ValorEfetivo = p.ValorEfetivo,
                Confirmado = p.Confirmado ?? false, DataPagamentoTipo = p.DataPagamentoTipo,
                DataPagamento = p.DataPagamento?.ToDateTime(TimeOnly.MinValue)
            }).ToList()
        };

        public CadastroServicoDto ToDto() => new(
            Id, Codigo, ClienteId, OrcamentoId, null, CondicaoPagamentoId, TipoServico, Subtipo,
            DateOnly.FromDateTime(DataEntrada!.Value), SituacaoInicial, DocumentoEmpresa,
            RazaoSocialEmpresa, ContatoEmpresa, Telefone, Email, EnderecoEmpresa, EnderecoServico,
            MesmoEnderecoEmpresa, ValorContrato, DateOnly.FromDateTime(DataContrato!.Value),
            null, ValorNotaFiscal,
            Parcelas.Select(p => new CadastroServicoParcelaDto(
                p.Id, p.Numero, p.Valor,
                p.Vencimento is null ? null : DateOnly.FromDateTime(p.Vencimento.Value),
                p.FormaPagamento)).ToList(),
            Prestadores.Select(p => new CadastroServicoPrestadorDto(
                p.Id, p.PrestadorId, p.NomePrestador, p.ValorProvisionado, p.ValorEfetivo,
                p.Confirmado, p.DataPagamento is null ? null : DateOnly.FromDateTime(p.DataPagamento.Value),
                p.DataPagamentoTipo)).ToList(), null);
    }

    private sealed class InstallmentModel
    {
        public long? Id { get; set; }
        public int? Numero { get; set; }
        public decimal? Valor { get; set; }
        public DateTime? Vencimento { get; set; }
        public string? FormaPagamento { get; set; }
    }

    private sealed class ProviderModel
    {
        public long? Id { get; set; }
        public long? PrestadorId { get; set; }
        public string? NomePrestador { get; set; }
        public decimal? ValorProvisionado { get; set; }
        public decimal? ValorEfetivo { get; set; }
        public bool Confirmado { get; set; }
        public DateTime? DataPagamento { get; set; }
        public PrestadorPagamentoDataTipo DataPagamentoTipo { get; set; } = PrestadorPagamentoDataTipo.A_DEFINIR;
    }
