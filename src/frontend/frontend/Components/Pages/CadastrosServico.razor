    {
        _loading = true;
        try
        {
            _result = await Service.ListAsync(new(
                _search, _search, _tipo, _page, 20, _situacao, _ocultarConcluidos, _cursors[_page - 1]));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task ApplyFilterAsync() { _page = 1; _cursors = new List<long?> { null }; await LoadAsync(); }
    private async Task PreviousAsync()
    {
        if (_page > 1)
        {
            _page--;
            await LoadAsync();
        }
    }
    private async Task NextAsync()
    {
        if (_result.HasNext)
        {
            _page++;
            _cursors.Add(_result.NextCursor);
            await LoadAsync();
        }
    }
