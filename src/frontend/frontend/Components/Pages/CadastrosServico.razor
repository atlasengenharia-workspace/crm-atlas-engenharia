    private void OnDocumentoBlur()
    {
        _model.DocumentoEmpresa = FormatCpfCnpj(_model.DocumentoEmpresa);
        if (!string.IsNullOrWhiteSpace(_model.DocumentoEmpresa) && !IsCpfOrCnpjValid(_model.DocumentoEmpresa))
            Snackbar.Add("CPF/CNPJ inválido.", Severity.Warning);
    }
    private static bool IsCpfOrCnpjValid(string? value)
    {
        var digits = new string((value ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length != 11 && digits.Length != 14) return false;
        if (new HashSet<char>(digits).Count == 1) return false;
        if (digits.Length == 11)
        {
            int[] w1 = [10, 9, 8, 7, 6, 5, 4, 3, 2];
            int[] w2 = [11, 10, 9, 8, 7, 6, 5, 4, 3, 2];
            var baseCpf = digits[..9];
            int calc(string input, int[] weights)
            {
                int s = 0;
                for (int i = 0; i < weights.Length; i++) s += (input[i] - '0') * weights[i];
                int r = s % 11;
                return r < 2 ? 0 : 11 - r;
            }
            int d1 = calc(baseCpf, w1);
            int d2 = calc(baseCpf + d1, w2);
            return digits[9] - '0' == d1 && digits[10] - '0' == d2;
        }
        else
        {
            int[] w1 = [5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2];
            int[] w2 = [6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2];
            var baseCnpj = digits[..12];
            int calc(string input, int[] weights)
            {
                int s = 0;
                for (int i = 0; i < weights.Length; i++) s += (input[i] - '0') * weights[i];
                int r = s % 11;
                return r < 2 ? 0 : 11 - r;
            }
            int d1 = calc(baseCnpj, w1);
            int d2 = calc(baseCnpj + d1, w2);
            return digits[12] - '0' == d1 && digits[13] - '0' == d2;
        }
    }
    private static string FormatCpfCnpj(string? value)
    {
        var digits = new string((value ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length == 11)
            return $"{digits[..3]}.{digits[3..6]}.{digits[6..9]}-{digits[9..]}";
        if (digits.Length == 14)
            return $"{digits[..2]}.{digits[2..5]}.{digits[5..8]}/{digits[8..12]}-{digits[12..]}";
        return value ?? "";
    }
    private sealed record ViaCepResult(string? logradouro, string? bairro, string? localidade, string? uf, bool? erro);
    private static string ServiceSaveError(Exception exception, string? code)
    {
        var detail = exception.GetBaseException().Message;
        if (detail.Contains("IX_cadastro_servicos_codigo", StringComparison.OrdinalIgnoreCase)
            || detail.Contains("duplicate key", StringComparison.OrdinalIgnoreCase))
            return $"Já existe um serviço com o código {code?.Trim()}. Informe outro código ou edite o cadastro existente.";
        return exception.Message;
    }
    private static int WeeksSince(DateOnly start) => Math.Max(0, (DateOnly.FromDateTime(DateTime.Today).DayNumber - start.DayNumber) / 7);
    private static Color StatusColor(string? status) =>
        status?.Contains("conclu", StringComparison.OrdinalIgnoreCase) == true
        || status?.Contains("finaliz", StringComparison.OrdinalIgnoreCase) == true
            ? Color.Success
            : status?.Contains("análise", StringComparison.OrdinalIgnoreCase) == true
              || status?.Contains("analise", StringComparison.OrdinalIgnoreCase) == true
                ? Color.Warning
                : Color.Default;
    private static bool ClosedBudget(string status) =>
        status.Contains("fech", StringComparison.OrdinalIgnoreCase)
        || status.Contains("recus", StringComparison.OrdinalIgnoreCase);

