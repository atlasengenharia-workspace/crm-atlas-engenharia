    }

    private async Task SaveAsync()
    {
        await (_form?.ValidateAsync() ?? Task.CompletedTask);
        if (!_valid) return;
        if (InstallmentTotal != NetValue)
        {
            Snackbar.Add("A soma das parcelas deve fechar com o valor líquido.", Severity.Warning);
            return;
        }
        _saving = true;
        try
        {
            var dto = _model.ToDto();
            if (_model.Id is null) await Service.CreateAsync(dto);
            else await Service.UpdateAsync(_model.Id.Value, dto);
            _editorOpen = false;
            Snackbar.Add("Serviço salvo com sucesso.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(CadastroServicoDto x)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Excluir serviço", $"Deseja excluir o cadastro {x.Codigo}?", "Excluir", cancelText: "Cancelar");
        if (confirm != true || x.Id is null) return;
        try { await Service.DeleteAsync(x.Id.Value); await LoadAsync(); Snackbar.Add("Serviço excluído.", Severity.Success); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

