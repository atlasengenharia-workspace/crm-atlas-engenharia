@page "/orcamentos"
@attribute [Authorize]
@inject IOrcamentoService Service
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Orçamentos | CRM Atlas</PageTitle>
<PageHeader Title="Orçamentos" Subtitle="Gerencie propostas e converta aprovações em serviços.">
    <Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="New">Novo orçamento</MudButton></Actions>
</PageHeader>

<GlobalSkeleton IsLoading="_loading" Layout="GlobalSkeleton.SkeletonLayoutType.Table" MetricCount="4" ColumnCount="6">
    <MudGrid Class="mb-4">
        <MudItem xs="6" md="3"><MetricCard Title="Em aberto" Value="@_items.Count(x => !Closed(x.Situacao)).ToString()" Icon="@Icons.Material.Filled.PendingActions" Color="Color.Info" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="Aprovados" Value="@_items.Count(x => x.Situacao.Contains("aprov", StringComparison.OrdinalIgnoreCase)).ToString()" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="Total" Value="@_items.Count.ToString()" Icon="@Icons.Material.Filled.RequestQuote" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="Em propostas" Value="@Money(_items.Sum(x => x.ValorTotal ?? 0))" Icon="@Icons.Material.Filled.Payments" Color="Color.Warning" /></MudItem>
    </MudGrid>

    <MudPaper Outlined="true" Class="pa-4">
        <MudTextField T="string" @bind-Value="_search" Placeholder="Buscar código, cliente ou descrição" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" />
        <MudTable Items="Filtered" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Loading="_loading">
            <HeaderContent><MudTh>Código</MudTh><MudTh>Cliente</MudTh><MudTh>Tipo</MudTh><MudTh>Situação</MudTh><MudTh>Valor</MudTh><MudTh>Ações</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código"><strong>@context.Codigo</strong></MudTd><MudTd DataLabel="Cliente">@context.Nome</MudTd>
                <MudTd DataLabel="Tipo">@context.TipoServico</MudTd><MudTd DataLabel="Situação"><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Situacao)">@context.Situacao</MudChip></MudTd>
                <MudTd DataLabel="Valor">@Money(context.ValorTotal ?? 0)</MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => Edit(context))" aria-label="@($"Editar orçamento {context.Codigo}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" aria-label="@($"Excluir orçamento {context.Codigo}")" /></MudTd>
            </RowTemplate>
            <NoRecordsContent><EmptyState Title="Nenhum orçamento" Message="Cadastre a primeira proposta comercial." /></NoRecordsContent>
        </MudTable>
    </MudPaper>
</GlobalSkeleton>

<MudDrawer @bind-Open="_open" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Width="min(560px, 100vw)" Elevation="8">
    <div class="pa-5">
        <MudToolBar Class="pa-0 mb-3">
            <MudText Typo="Typo.h5">@(_model.Id is null ? "Novo orçamento" : "Editar orçamento")</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _open=false)" aria-label="Fechar" />
        </MudToolBar>
        <MudDivider Class="mb-5" />
        <MudForm @ref="_form" @bind-IsValid="_valid"><MudGrid>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_model.Codigo" Label="Código" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudSelect T="AcompanhamentoServicoTipo" @bind-Value="_model.TipoServico" Label="Tipo" Variant="Variant.Outlined">@foreach(var t in Enum.GetValues<AcompanhamentoServicoTipo>()){<MudSelectItem Value="@t">@t</MudSelectItem>}</MudSelect></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_model.Nome" Label="Cliente / nome da proposta" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_model.Telefone" Label="Telefone" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudSelect T="string" @bind-Value="_model.Situacao" Label="Situação" Required="true" Variant="Variant.Outlined"><MudSelectItem Value="@("Em análise")">Em análise</MudSelectItem><MudSelectItem Value="@("Aguardando cliente")">Aguardando cliente</MudSelectItem><MudSelectItem Value="@("Aprovado")">Aprovado</MudSelectItem><MudSelectItem Value="@("Recusado")">Recusado</MudSelectItem></MudSelect></MudItem>
            <MudItem xs="12"><MudNumericField T="decimal?" @bind-Value="_model.ValorTotal" Label="Valor total" Variant="Variant.Outlined" Format="C2" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_model.Descricao" Label="Descrição" Variant="Variant.Outlined" Lines="4" /></MudItem>
        </MudGrid></MudForm>
        <MudDivider Class="mt-6 mb-4" />
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2"><MudButton OnClick="@(() => _open=false)">Cancelar</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_saving">Salvar</MudButton></MudStack>
    </div>
</MudDrawer>

@code {
    private List<OrcamentoDto> _items=[]; private BudgetModel _model=new(); private MudForm? _form;
    private bool _loading,_open,_saving,_valid; private string? _search;
    private IEnumerable<OrcamentoDto> Filtered => string.IsNullOrWhiteSpace(_search)?_items:_items.Where(x=>$"{x.Codigo} {x.Nome} {x.Descricao}".Contains(_search,StringComparison.OrdinalIgnoreCase));
    protected override async Task OnInitializedAsync()=>await LoadAsync();
    private async Task LoadAsync(){_loading=true;try{_items=(await Service.ListAsync()).ToList();}catch(Exception e){Snackbar.Add(e.Message,Severity.Error);}finally{_loading=false;}}
    private void New(){_model=new(){Codigo=$"ORC-{DateTime.Now:yyyyMMdd-HHmm}",Situacao="Em análise"};_open=true;}
    private void Edit(OrcamentoDto x){_model=BudgetModel.From(x);_open=true;}
    private async Task SaveAsync(){await(_form?.ValidateAsync()??Task.CompletedTask);if(!_valid)return;_saving=true;try{await Service.SaveAsync(_model.ToDto());Snackbar.Add("Orçamento salvo.",Severity.Success);_open=false;await LoadAsync();}catch(Exception e){Snackbar.Add(e.Message,Severity.Error);}finally{_saving=false;}}
    private async Task DeleteAsync(OrcamentoDto x){if(x.Id is null||await DialogService.ShowMessageBoxAsync("Excluir orçamento",$"Excluir {x.Codigo}?",yesText:"Excluir",cancelText:"Cancelar")!=true)return;await Service.DeleteAsync(x.Id.Value);await LoadAsync();}
    private static bool Closed(string s)=>s.Contains("aprov",StringComparison.OrdinalIgnoreCase)||s.Contains("recus",StringComparison.OrdinalIgnoreCase);
    private static Color StatusColor(string s)=>s.Contains("aprov",StringComparison.OrdinalIgnoreCase)?Color.Success:s.Contains("recus",StringComparison.OrdinalIgnoreCase)?Color.Error:Color.Info;
    private static string Money(decimal v)=>v.ToString("C2",new System.Globalization.CultureInfo("pt-BR"));
    private sealed class BudgetModel{public long? Id{get;set;}public string Codigo{get;set;}="";public string? Nome{get;set;}public string? Descricao{get;set;}public string Situacao{get;set;}="Em análise";public string? Telefone{get;set;}public AcompanhamentoServicoTipo TipoServico{get;set;}public decimal? ValorTotal{get;set;}
        public static BudgetModel From(OrcamentoDto x)=>new(){Id=x.Id,Codigo=x.Codigo,Nome=x.Nome,Descricao=x.Descricao,Situacao=x.Situacao,Telefone=x.Telefone,TipoServico=x.TipoServico,ValorTotal=x.ValorTotal};
        public OrcamentoDto ToDto()=>new(Id,Codigo,Nome,Descricao,Situacao,Telefone,TipoServico,ValorTotal);}
}
