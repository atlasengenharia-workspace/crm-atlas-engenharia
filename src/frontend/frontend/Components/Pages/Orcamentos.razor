@page "/orcamentos"
@attribute [Authorize]
@using Radzen.Blazor
@inject IOrcamentoService Service
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Orçamentos | CRM Atlas</PageTitle>
<PageHeader Title="Orçamentos" Subtitle="Gerencie propostas e converta aprovações em serviços.">
    <Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="New">Novo orçamento</MudButton></Actions>
</PageHeader>

<GlobalSkeleton IsLoading="_loading" Layout="GlobalSkeleton.SkeletonLayoutType.Table" MetricCount="4" ColumnCount="6">
    <MudGrid Class="mb-4">
        <MudItem xs="6" md="3"><MetricCard Title="Em aberto" Value="@_result.Items.Count(x => !Closed(x.Situacao)).ToString()" Icon="@Icons.Material.Filled.PendingActions" Color="Color.Info" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="Aprovados" Value="@_result.Items.Count(x => x.Situacao.Contains("aprov", StringComparison.OrdinalIgnoreCase)).ToString()" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="Total" Value="@_result.TotalItems.ToString()" Icon="@Icons.Material.Filled.RequestQuote" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="Em propostas" Value="@Money(_result.Items.Sum(x => x.ValorTotal ?? 0))" Icon="@Icons.Material.Filled.Payments" Color="Color.Warning" /></MudItem>
    </MudGrid>

    <MudPaper Outlined="true" Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3" Spacing="2">
            <MudTextField T="string" @bind-Value="_search" Placeholder="Buscar código, cliente ou descrição" Immediate="true" OnKeyDown="SearchOnEnter"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="flex:1" />
            <MudSwitch T="bool" Value="_ocultarConcluidos" ValueChanged="async (bool v) => { _ocultarConcluidos = v; await LoadAsync(); }" Color="Color.Primary" Label="Ocultar aprovados/recusados" />
        </MudStack>
        <SmartTableFilter TItem="OrcamentoDto" Items="_result.Items" Columns="_filterColumns"
                          ProcessOnClient="false" TotalCount="_result.TotalItems"
                          OnStateChanged="OnSmartTableStateChanged">
        <ChildContent Context="smartItems">
        <RadzenDataGrid @ref="_grid" Data="@_result.Items" TItem="OrcamentoDto"
                        Class="excel-grid" Style="width:100%;" AllowPaging="true" PageSize="50"
                        AllowColumnResize="true" AllowColumnPicking="true" AllowColumnReorder="true"
                        AllowSorting="true" AllowFiltering="true" AllowColumnFiltering="true" AllowGrouping="true" AllowAlternatingRows="true"
                        FilterMode="Radzen.FilterMode.CheckBoxList" Culture="@_ptBr" UICulture="@_ptBr"
                        Density="Radzen.Density.Compact" EmptyText="Nenhum orçamento encontrado"
                        GroupPanelText="Arraste um cabeçalho de coluna aqui para agrupar"
                        ColumnsShowingText="colunas visíveis">
            <Columns>
                <RadzenDataGridColumn TItem="OrcamentoDto" Property="Codigo" Title="Código">
                    <Template Context="context"><strong>@context.Codigo</strong></Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="OrcamentoDto" Property="Nome" Title="Cliente">
                    <Template Context="context">@context.Nome</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="OrcamentoDto" Property="Telefone" Title="Contato">
                    <Template Context="context">
                        <MudText Typo="Typo.body2">@(context.Telefone ?? "—")</MudText>
                        <MudText Typo="Typo.caption">@(context.Email ?? "—")</MudText>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="OrcamentoDto" Property="Data" Title="Data">
                    <Template Context="context">@context.Data?.ToString("dd/MM/yyyy")</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="OrcamentoDto" Title="Semanas" Sortable="false" Filterable="false">
                    <Template Context="context">@WeeksSince(context.Data)</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="OrcamentoDto" Property="TipoServico" Title="Tipo">
                    <Template Context="context">@context.TipoServico</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="OrcamentoDto" Property="Subtipo" Title="Subtipo">
                    <Template Context="context">@(context.Subtipo ?? "—")</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="OrcamentoDto" Property="Situacao" Title="Situação">
                    <Template Context="context">
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Situacao)">@context.Situacao</MudChip>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="OrcamentoDto" Property="ValorTotal" Title="Valor">
                    <Template Context="context">@Money(context.ValorTotal ?? 0)</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="OrcamentoDto" Title="Ações" Sortable="false" Resizable="false" TextAlign="Radzen.TextAlign.Right">
                    <Template Context="context">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => Edit(context))" aria-label="@($"Editar orçamento {context.Codigo}")" />
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" aria-label="@($"Excluir orçamento {context.Codigo}")" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <EmptyTemplate>
                <EmptyState Title="Nenhum orçamento" Message="Cadastre a primeira proposta comercial." />
            </EmptyTemplate>
        </RadzenDataGrid>
        </ChildContent>
        </SmartTableFilter>

        <MudDivider Class="my-3" />
    </MudPaper>
</GlobalSkeleton>

<MudDrawer @bind-Open="_open" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Width="min(560px, 100vw)" Elevation="8">
    <div class="pa-5" style="background-color: @TypeBackgroundColor(_model.TipoServico); min-height: 100%;">
        <MudToolBar Class="pa-0 mb-3">
            <MudText Typo="Typo.h5">@(_model.Id is null ? "Novo orçamento" : "Editar orçamento")</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _open=false)" aria-label="Fechar" />
        </MudToolBar>
        <MudDivider Class="mb-5" />
        <MudForm @ref="_form" @bind-IsValid="_valid"><MudGrid>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_model.Codigo" Label="Código" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudSelect T="AcompanhamentoServicoTipo" @bind-Value="_model.TipoServico" Label="Tipo" Variant="Variant.Outlined">@foreach(var t in Enum.GetValues<AcompanhamentoServicoTipo>()){<MudSelectItem Value="@t">@t</MudSelectItem>}</MudSelect></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_model.Subtipo" Label="Subtipo" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_model.Nome" Label="Cliente / nome da proposta" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_model.Telefone" Label="Telefone" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_model.Email" Label="E-mail" InputType="InputType.Email" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="_model.Data" Label="Data do orçamento" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudSelect T="string" @bind-Value="_model.Situacao" Label="Situação" Required="true" Variant="Variant.Outlined"><MudSelectItem Value="@("Em análise")">Em análise</MudSelectItem><MudSelectItem Value="@("Aguardando cliente")">Aguardando cliente</MudSelectItem><MudSelectItem Value="@("Aprovado")">Aprovado</MudSelectItem><MudSelectItem Value="@("Recusado")">Recusado</MudSelectItem></MudSelect></MudItem>
            <MudItem xs="12"><MudNumericField T="decimal?" @bind-Value="_model.ValorTotal" Label="Valor total" Variant="Variant.Outlined" Format="C2" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_model.Descricao" Label="Descrição" Variant="Variant.Outlined" Lines="4" /></MudItem>
        </MudGrid></MudForm>
        <MudDivider Class="mt-6 mb-4" />
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2"><MudButton OnClick="@(() => _open=false)">Cancelar</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_saving">Salvar</MudButton></MudStack>
    </div>
</MudDrawer>

<style>
    .excel-grid .rz-grid-table { border-collapse: collapse; border: 1px solid #d1d5db; width: 100%; }
    .excel-grid .rz-grid-table th { background: #e5e7eb !important; border: 1px solid #d1d5db; font-weight: 600; font-size: .78rem; padding: 4px 6px; }
    .excel-grid .rz-grid-table td { border: 1px solid #e5e7eb; font-size: .8rem; padding: 3px 6px; vertical-align: middle; }
    .excel-grid .rz-grid-table tr:nth-child(even) td { background: #f3f4f6; }
    .excel-grid .rz-grid-table tr:hover td { background: #e0e7ff; }
</style>

@code {
    private readonly System.Globalization.CultureInfo _ptBr = new("pt-BR");
    private RadzenDataGrid<OrcamentoDto>? _grid;
    private PagedResult<OrcamentoDto> _result = new([], 1, 1000, 0);
    private string? _sortKey;
    private bool _sortDescending;
    private BudgetModel _model=new(); private MudForm? _form;
    private readonly IReadOnlyList<SmartFilterColumn<OrcamentoDto>> _filterColumns =
    [
        new("codigo","Código",x=>x.Codigo,1),new("cliente","Cliente",x=>x.Nome,2),
        new("telefone","Telefone",x=>x.Telefone,3),new("email","E-mail",x=>x.Email,3),new("data","Data",x=>x.Data,4),
        new("semanas","Semanas",x=>WeeksSince(x.Data),5,false),new("tipo","Tipo",x=>x.TipoServico,6),new("subtipo","Subtipo",x=>x.Subtipo,7),new("situacao","Situação",x=>x.Situacao,8),new("valor","Valor",x=>x.ValorTotal,9,true)
    ];
    private bool _loading,_open,_saving,_valid,_ocultarConcluidos; private string? _search;
    protected override async Task OnInitializedAsync()=>await LoadAsync();
    private async Task LoadAsync()
    {
        _loading=true;
        try
        {
            _result = await Service.ListAsync(new OrcamentoFilter(_search, 1, 0, _sortKey, _sortDescending, _ocultarConcluidos));
        }
        catch(Exception e){Snackbar.Add(e.Message,Severity.Error);}
        finally{_loading=false;}
    }

    private async Task OnSmartTableStateChanged(SmartTableState state)
    {
        _search = state.Search;
        _sortKey = state.SortKey;
        _sortDescending = state.SortDescending;
        await LoadAsync();
    }

    private async Task SearchOnEnter(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") { await LoadAsync(); }
    }

    private void New(){_model=new(){Codigo=$"ORC-{BudgetTypeSigla(_model.TipoServico)}-{DateTime.Now:yyyyMMdd-HHmm}",Situacao="Em análise",Data=DateTime.Today};_open=true;}
    private void Edit(OrcamentoDto x){_model=BudgetModel.From(x);_open=true;}
    private async Task SaveAsync(){await(_form?.ValidateAsync()??Task.CompletedTask);if(!_valid)return;_saving=true;try{await Service.SaveAsync(_model.ToDto());Snackbar.Add("Orçamento salvo.",Severity.Success);_open=false;await LoadAsync();}catch(Exception e){Snackbar.Add(SaveError(e),Severity.Error);}finally{_saving=false;}}
    private static string SaveError(Exception exception){var detail=exception.GetBaseException().Message;return detail.Contains("IX_orcamentos_codigo",StringComparison.OrdinalIgnoreCase)||detail.Contains("duplicate key",StringComparison.OrdinalIgnoreCase)?"Já existe um orçamento com esse código. Informe outro código ou edite o orçamento existente.":exception.Message;}
    private async Task DeleteAsync(OrcamentoDto x){if(x.Id is null||await DialogService.ShowMessageBoxAsync("Excluir orçamento",$"Excluir {x.Codigo}?",yesText:"Excluir",cancelText:"Cancelar")!=true)return;await Service.DeleteAsync(x.Id.Value);await LoadAsync();}
    private static bool Closed(string s)=>s.Contains("aprov",StringComparison.OrdinalIgnoreCase)||s.Contains("recus",StringComparison.OrdinalIgnoreCase);
    private static Color StatusColor(string s)=>s.Contains("aprov",StringComparison.OrdinalIgnoreCase)?Color.Success:s.Contains("recus",StringComparison.OrdinalIgnoreCase)?Color.Error:Color.Info;
    private static string Money(decimal v)=>v.ToString("C2",new System.Globalization.CultureInfo("pt-BR"));
    private static int WeeksSince(DateOnly? start) => start is null ? 0 : Math.Max(0, (DateOnly.FromDateTime(DateTime.Today).DayNumber - start.Value.DayNumber) / 7);
    private static string BudgetTypeSigla(AcompanhamentoServicoTipo type) => type switch
    {
        AcompanhamentoServicoTipo.AVCB => "AVCB",
        AcompanhamentoServicoTipo.CLCB => "CLCB",
        AcompanhamentoServicoTipo.OBRAS => "OBRA",
        AcompanhamentoServicoTipo.PROCESSOS_ADM => "ADM",
        _ => type.ToString().ToUpperInvariant()
    };
    private static string TypeBackgroundColor(AcompanhamentoServicoTipo type) => type switch
    {
        AcompanhamentoServicoTipo.AVCB => "#FEF2F2",
        AcompanhamentoServicoTipo.CLCB => "#FFFBEB",
        AcompanhamentoServicoTipo.OBRAS => "#EFF6FF",
        _ => "#F3F4F6"
    };
    private sealed class BudgetModel{public long? Id{get;set;}public string Codigo{get;set;}="";public string? Nome{get;set;}public string? Descricao{get;set;}public string? Subtipo{get;set;}public string Situacao{get;set;}="Em análise";public string? Telefone{get;set;}public string? Email{get;set;}public DateTime? Data{get;set;}=DateTime.Today;public AcompanhamentoServicoTipo TipoServico{get;set;}public decimal? ValorTotal{get;set;}
        public static BudgetModel From(OrcamentoDto x)=>new(){Id=x.Id,Codigo=x.Codigo,Nome=x.Nome,Descricao=x.Descricao,Subtipo=x.Subtipo,Situacao=x.Situacao,Telefone=x.Telefone,Email=x.Email,Data=x.Data?.ToDateTime(TimeOnly.MinValue),TipoServico=x.TipoServico,ValorTotal=x.ValorTotal};
        public OrcamentoDto ToDto()=>new(Id,Codigo,Nome,Descricao,Situacao,Telefone,TipoServico,ValorTotal,Data is null?null:DateOnly.FromDateTime(Data.Value),Email, null, null, null, Subtipo);}
}
