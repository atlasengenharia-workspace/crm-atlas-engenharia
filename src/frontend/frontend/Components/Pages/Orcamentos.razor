@page "/orcamentos"
@attribute [Authorize]
@inject IOrcamentoService Service
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Orçamentos | CRM Atlas</PageTitle>
<PageHeader Title="Orçamentos" Subtitle="Gerencie propostas e converta aprovações em serviços.">
    <Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="New">Novo orçamento</MudButton></Actions>
</PageHeader>

<GlobalSkeleton IsLoading="_loading" Layout="GlobalSkeleton.SkeletonLayoutType.Table" MetricCount="4" ColumnCount="6">
    <MudGrid Class="mb-4">
        <MudItem xs="6" md="3"><MetricCard Title="Em aberto" Value="@_result.Items.Count(x => !Closed(x.Situacao)).ToString()" Icon="@Icons.Material.Filled.PendingActions" Color="Color.Info" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="Aprovados" Value="@_result.Items.Count(x => x.Situacao.Contains("aprov", StringComparison.OrdinalIgnoreCase)).ToString()" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="Total" Value="@_result.TotalItems.ToString()" Icon="@Icons.Material.Filled.RequestQuote" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="Em propostas" Value="@Money(_result.Items.Sum(x => x.ValorTotal ?? 0))" Icon="@Icons.Material.Filled.Payments" Color="Color.Warning" /></MudItem>
    </MudGrid>

    <MudPaper Outlined="true" Class="pa-4">
        <MudTextField T="string" @bind-Value="_search" Placeholder="Buscar código, cliente ou descrição" Immediate="true" OnKeyDown="SearchOnEnter"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" />
        <SmartTableFilter TItem="OrcamentoDto" Items="_result.Items" Columns="_filterColumns"
                          ProcessOnClient="false" TotalCount="_result.TotalItems"
                          OnStateChanged="OnSmartTableStateChanged">
        <ChildContent Context="smartItems">
        <MudTable Items="smartItems" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Loading="_loading" RowsPerPage="1000" Virtualize="true" ItemSize="52">
            <HeaderContent><MudTh>Código</MudTh><MudTh>Cliente</MudTh><MudTh>Contato</MudTh><MudTh>Data</MudTh><MudTh>Tipo</MudTh><MudTh>Situação</MudTh><MudTh>Valor</MudTh><MudTh>Ações</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código"><strong>@context.Codigo</strong></MudTd><MudTd DataLabel="Cliente">@context.Nome</MudTd>
                <MudTd DataLabel="Contato"><MudText Typo="Typo.body2">@(context.Telefone ?? "—")</MudText><MudText Typo="Typo.caption">@(context.Email ?? "—")</MudText></MudTd>
                <MudTd DataLabel="Data">@context.Data?.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Tipo">@context.TipoServico</MudTd><MudTd DataLabel="Situação"><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Situacao)">@context.Situacao</MudChip></MudTd>
                <MudTd DataLabel="Valor">@Money(context.ValorTotal ?? 0)</MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => Edit(context))" aria-label="@($"Editar orçamento {context.Codigo}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" aria-label="@($"Excluir orçamento {context.Codigo}")" /></MudTd>
            </RowTemplate>
            <NoRecordsContent><EmptyState Title="Nenhum orçamento" Message="Cadastre a primeira proposta comercial." /></NoRecordsContent>
        </MudTable>
        </ChildContent>
        </SmartTableFilter>

        <MudDivider Class="my-3" />
    </MudPaper>
</GlobalSkeleton>

<MudDrawer @bind-Open="_open" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Width="min(560px, 100vw)" Elevation="8">
    <div class="pa-5">
        <MudToolBar Class="pa-0 mb-3">
            <MudText Typo="Typo.h5">@(_model.Id is null ? "Novo orçamento" : "Editar orçamento")</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _open=false)" aria-label="Fechar" />
        </MudToolBar>
        <MudDivider Class="mb-5" />
        <MudForm @ref="_form" @bind-IsValid="_valid"><MudGrid>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_model.Codigo" Label="Código" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudSelect T="AcompanhamentoServicoTipo" @bind-Value="_model.TipoServico" Label="Tipo" Variant="Variant.Outlined">@foreach(var t in Enum.GetValues<AcompanhamentoServicoTipo>()){<MudSelectItem Value="@t">@t</MudSelectItem>}</MudSelect></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_model.Nome" Label="Cliente / nome da proposta" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_model.Telefone" Label="Telefone" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_model.Email" Label="E-mail" InputType="InputType.Email" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="_model.Data" Label="Data do orçamento" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudSelect T="string" @bind-Value="_model.Situacao" Label="Situação" Required="true" Variant="Variant.Outlined"><MudSelectItem Value="@("Em análise")">Em análise</MudSelectItem><MudSelectItem Value="@("Aguardando cliente")">Aguardando cliente</MudSelectItem><MudSelectItem Value="@("Aprovado")">Aprovado</MudSelectItem><MudSelectItem Value="@("Recusado")">Recusado</MudSelectItem></MudSelect></MudItem>
            <MudItem xs="12"><MudNumericField T="decimal?" @bind-Value="_model.ValorTotal" Label="Valor total" Variant="Variant.Outlined" Format="C2" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_model.Descricao" Label="Descrição" Variant="Variant.Outlined" Lines="4" /></MudItem>
        </MudGrid></MudForm>
        <MudDivider Class="mt-6 mb-4" />
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2"><MudButton OnClick="@(() => _open=false)">Cancelar</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_saving">Salvar</MudButton></MudStack>
    </div>
</MudDrawer>

@code {
    private PagedResult<OrcamentoDto> _result = new([], 1, 1000, 0);
    private string? _sortKey;
    private bool _sortDescending;
    private BudgetModel _model=new(); private MudForm? _form;
    private readonly IReadOnlyList<SmartFilterColumn<OrcamentoDto>> _filterColumns =
    [
        new("codigo","Código",x=>x.Codigo,1),new("cliente","Cliente",x=>x.Nome,2),
        new("telefone","Telefone",x=>x.Telefone,3),new("email","E-mail",x=>x.Email,3),new("data","Data",x=>x.Data,4),
        new("tipo","Tipo",x=>x.TipoServico,5),new("situacao","Situação",x=>x.Situacao,6),new("valor","Valor",x=>x.ValorTotal,7,true)
    ];
    private bool _loading,_open,_saving,_valid; private string? _search;
    private const int PageSize = 1000;
    protected override async Task OnInitializedAsync()=>await LoadAsync();
    private async Task LoadAsync()
    {
        _loading=true;
        try
        {
            _result = await Service.ListAsync(new OrcamentoFilter(_search, 1, PageSize, _sortKey, _sortDescending));
        }
        catch(Exception e){Snackbar.Add(e.Message,Severity.Error);}
        finally{_loading=false;}
    }

    private async Task OnSmartTableStateChanged(SmartTableState state)
    {
        _search = state.Search;
        _sortKey = state.SortKey;
        _sortDescending = state.SortDescending;
        await LoadAsync();
    }

    private async Task SearchOnEnter(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") { await LoadAsync(); }
    }

    private void New(){_model=new(){Codigo=$"ORC-{DateTime.Now:yyyyMMdd-HHmm}",Situacao="Em análise",Data=DateTime.Today};_open=true;}
    private void Edit(OrcamentoDto x){_model=BudgetModel.From(x);_open=true;}
    private async Task SaveAsync(){await(_form?.ValidateAsync()??Task.CompletedTask);if(!_valid)return;_saving=true;try{await Service.SaveAsync(_model.ToDto());Snackbar.Add("Orçamento salvo.",Severity.Success);_open=false;await LoadAsync();}catch(Exception e){Snackbar.Add(SaveError(e),Severity.Error);}finally{_saving=false;}}
    private static string SaveError(Exception exception){var detail=exception.GetBaseException().Message;return detail.Contains("IX_orcamentos_codigo",StringComparison.OrdinalIgnoreCase)||detail.Contains("duplicate key",StringComparison.OrdinalIgnoreCase)?"Já existe um orçamento com esse código. Informe outro código ou edite o orçamento existente.":exception.Message;}
    private async Task DeleteAsync(OrcamentoDto x){if(x.Id is null||await DialogService.ShowMessageBoxAsync("Excluir orçamento",$"Excluir {x.Codigo}?",yesText:"Excluir",cancelText:"Cancelar")!=true)return;await Service.DeleteAsync(x.Id.Value);await LoadAsync();}
    private static bool Closed(string s)=>s.Contains("aprov",StringComparison.OrdinalIgnoreCase)||s.Contains("recus",StringComparison.OrdinalIgnoreCase);
    private static Color StatusColor(string s)=>s.Contains("aprov",StringComparison.OrdinalIgnoreCase)?Color.Success:s.Contains("recus",StringComparison.OrdinalIgnoreCase)?Color.Error:Color.Info;
    private static string Money(decimal v)=>v.ToString("C2",new System.Globalization.CultureInfo("pt-BR"));
    private sealed class BudgetModel{public long? Id{get;set;}public string Codigo{get;set;}="";public string? Nome{get;set;}public string? Descricao{get;set;}public string Situacao{get;set;}="Em análise";public string? Telefone{get;set;}public string? Email{get;set;}public DateTime? Data{get;set;}=DateTime.Today;public AcompanhamentoServicoTipo TipoServico{get;set;}public decimal? ValorTotal{get;set;}
        public static BudgetModel From(OrcamentoDto x)=>new(){Id=x.Id,Codigo=x.Codigo,Nome=x.Nome,Descricao=x.Descricao,Situacao=x.Situacao,Telefone=x.Telefone,Email=x.Email,Data=x.Data?.ToDateTime(TimeOnly.MinValue),TipoServico=x.TipoServico,ValorTotal=x.ValorTotal};
        public OrcamentoDto ToDto()=>new(Id,Codigo,Nome,Descricao,Situacao,Telefone,TipoServico,ValorTotal,Data is null?null:DateOnly.FromDateTime(Data.Value),Email);}
}
