@page "/atlas-ai"
@attribute [Authorize]

<PageTitle>Atlas IA | CRM Atlas</PageTitle>
<PageHeader Title="Atlas IA" Subtitle="Assistente para consultar a operação e acelerar tarefas repetitivas." />
<MudGrid>
    <MudItem xs="12" lg="8">
        <MudPaper Outlined="true" Class="pa-5" Style="min-height:520px">
            <div class="d-flex align-center gap-3 mb-5"><MudAvatar Color="Color.Primary"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" /></MudAvatar><div><MudText Typo="Typo.subtitle1"><strong>Assistente Atlas</strong></MudText><MudText Typo="Typo.caption" Color="Color.Success">Pronto para ajudar</MudText></div></div>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">A IA pode resumir informações autorizadas do CRM, mas alterações continuam exigindo sua confirmação.</MudAlert>
            <MudPaper Class="pa-4 mt-5" Elevation="0" Style="background:var(--mud-palette-background)">
                <MudText>Olá! Posso ajudar a localizar serviços com pendências, resumir o financeiro ou preparar um relatório.</MudText>
            </MudPaper>
            <div class="d-flex align-end gap-2 mt-6">
                <MudTextField T="string" @bind-Value="_prompt" Label="Pergunte sobre sua operação" Variant="Variant.Outlined" Lines="2" FullWidth="true" />
                <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary" Size="Size.Large" aria-label="Enviar pergunta" />
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="4">
        <MudPaper Outlined="true" Class="pa-5"><MudText Typo="Typo.h6">Sugestões</MudText>
            <MudList T="string" Class="mt-3">
                <MudListItem Icon="@Icons.Material.Filled.Warning">Serviços com pendências críticas</MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Summarize">Resumo financeiro deste mês</MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.CalendarMonth">Vistorias dos próximos 7 dias</MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.RequestQuote">Orçamentos sem retorno</MudListItem>
            </MudList>
        </MudPaper>
    </MudItem>
</MudGrid>
@code { private string? _prompt; }
