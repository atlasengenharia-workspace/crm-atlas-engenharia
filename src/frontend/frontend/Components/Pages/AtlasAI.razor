@page "/atlas-ai"
@attribute [Authorize]
@using CrmAtlas.ApplicationCore.IA
@using Radzen.Blazor
@inject IAtlasAiService AiService
@inject ISnackbar Snackbar

<PageTitle>Atlas IA | CRM Atlas</PageTitle>
<PageHeader Title="Atlas IA" Subtitle="Assistente inteligente para consultar a operação e acelerar tarefas." />

<MudGrid>
    <MudItem xs="12" lg="8">
        <RadzenCard Variant="Radzen.Variant.Outlined" Class="rz-p-4" Style="height: 620px;">
            <RadzenAIChat @ref="_chat"
                          Title="Assistente Atlas"
                          Placeholder="Pergunte sobre sua operação..."
                          EmptyMessage="Olá! Posso ajudar a localizar serviços com pendências, resumir o financeiro ou conferir orçamentos."
                          UserAvatarText="EU"
                          AssistantAvatarText="AI"
                          ShowClearButton="true"
                          Style="height: 100%;"
                          MessageSent="@OnMessageSent" />
        </RadzenCard>
    </MudItem>

    <MudItem xs="12" lg="4">
        <MudPaper Outlined="true" Class="pa-5">
            <MudText Typo="Typo.h6">Sugestões</MudText>
            <MudList T="string" Class="mt-3">
                <MudListItem Icon="@Icons.Material.Filled.Warning" OnClick="AskPendencias">Serviços com pendências críticas</MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Summarize" OnClick="AskFinanceiro">Resumo financeiro deste mês</MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.CalendarMonth" OnClick="AskVistorias">Vistorias dos próximos 7 dias</MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.RequestQuote" OnClick="AskOrcamentos">Orçamentos sem retorno</MudListItem>
            </MudList>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private RadzenAIChat? _chat;
    private bool _responding;

    private async Task AskPendencias() => await SendSuggestion("Quais serviços têm pendências críticas?");
    private async Task AskFinanceiro() => await SendSuggestion("Resuma o financeiro deste mês");
    private async Task AskVistorias() => await SendSuggestion("Quais vistorias estão previstas para os próximos 7 dias?");
    private async Task AskOrcamentos() => await SendSuggestion("Quais orçamentos estão sem retorno?");

    private async Task SendSuggestion(string question)
    {
        if (_chat is null) return;
        await _chat.SendMessage(question);
    }

    private async Task OnMessageSent(string message)
    {
        if (_chat is null || string.IsNullOrWhiteSpace(message) || _responding) return;

        _responding = true;
        var assistantMessage = _chat.AddMessage("", isUser: false);
        assistantMessage.IsStreaming = true;

        try
        {
            var sb = new System.Text.StringBuilder();
            await foreach (var chunk in AiService.AskAsync(message.Trim()))
            {
                sb.Append(chunk);
                assistantMessage.Content = sb.ToString();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            assistantMessage.Content = $"Erro ao consultar a IA: {ex.Message}";
            Snackbar.Add($"Erro ao consultar a IA: {ex.Message}", Severity.Error);
        }
        finally
        {
            assistantMessage.IsStreaming = false;
            _responding = false;
        }
    }
}
