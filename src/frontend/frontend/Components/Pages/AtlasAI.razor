@page "/atlas-ai"
@attribute [Authorize]
@inject IAcompanhamentoService AcompanhamentoService
@inject IOrcamentoService OrcamentoService
@inject ILancamentoService LancamentoService
@inject ISnackbar Snackbar

<PageTitle>Atlas IA | CRM Atlas</PageTitle>
<PageHeader Title="Atlas IA" Subtitle="Assistente para consultar a operação e acelerar tarefas repetitivas." />
<MudGrid>
    <MudItem xs="12" lg="8">
        <MudPaper Outlined="true" Class="pa-5" Style="min-height:520px">
            <div class="d-flex align-center gap-3 mb-5"><MudAvatar Color="Color.Primary"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" /></MudAvatar><div><MudText Typo="Typo.subtitle1"><strong>Assistente Atlas</strong></MudText><MudText Typo="Typo.caption" Color="Color.Success">Pronto para ajudar</MudText></div></div>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">A IA pode resumir informações autorizadas do CRM, mas alterações continuam exigindo sua confirmação.</MudAlert>
            <MudPaper Class="pa-4 mt-5" Elevation="0" Style="background:var(--mud-palette-background)">
                <MudText>@_answer</MudText>
            </MudPaper>
            <div class="d-flex align-end gap-2 mt-6">
                <MudTextField T="string" @bind-Value="_prompt" Label="Pergunte sobre sua operação" Variant="Variant.Outlined" Lines="2" FullWidth="true" />
                <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary" Size="Size.Large"
                               OnClick="AskAsync" Disabled="_loading" aria-label="Enviar pergunta" />
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="4">
        <MudPaper Outlined="true" Class="pa-5"><MudText Typo="Typo.h6">Sugestões</MudText>
            <MudList T="string" Class="mt-3">
                <MudListItem Icon="@Icons.Material.Filled.Warning">Serviços com pendências críticas</MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Summarize">Resumo financeiro deste mês</MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.CalendarMonth">Vistorias dos próximos 7 dias</MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.RequestQuote">Orçamentos sem retorno</MudListItem>
            </MudList>
        </MudPaper>
    </MudItem>
</MudGrid>
@code {
    private string? _prompt;
    private string _answer = "Olá! Posso ajudar a localizar serviços com pendências, resumir o financeiro ou conferir orçamentos.";
    private bool _loading;

    private async Task AskAsync()
    {
        if (string.IsNullOrWhiteSpace(_prompt)) return;
        _loading = true;
        try
        {
            var question = _prompt.Trim();
            if (question.Contains("finance", StringComparison.OrdinalIgnoreCase)
                || question.Contains("fatur", StringComparison.OrdinalIgnoreCase)
                || question.Contains("saldo", StringComparison.OrdinalIgnoreCase))
            {
                var start = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);
                var end = DateOnly.FromDateTime(DateTime.Today);
                var entries = (await LancamentoService.ListAsync(new(null, null, start, end, null, null, 1, 5000))).Items;
                var income = entries.Where(x => x.Tipo == LancamentoTipo.ENTRADA && x.Status == LancamentoStatus.PAGO).Sum(x => x.Valor);
                var expense = entries.Where(x => x.Tipo == LancamentoTipo.SAIDA && x.Status == LancamentoStatus.PAGO).Sum(x => x.Valor);
                _answer = $"Neste mês há {income:C2} em entradas pagas, {expense:C2} em saídas pagas e saldo de {(income-expense):C2}.";
            }
            else if (question.Contains("orçamento", StringComparison.OrdinalIgnoreCase)
                     || question.Contains("orcamento", StringComparison.OrdinalIgnoreCase))
            {
                var budgets = await OrcamentoService.ListAsync();
                var open = budgets.Count(x => !x.Situacao.Contains("aprov", StringComparison.OrdinalIgnoreCase)
                    && !x.Situacao.Contains("recus", StringComparison.OrdinalIgnoreCase)
                    && !x.Situacao.Contains("fech", StringComparison.OrdinalIgnoreCase));
                _answer = $"Existem {budgets.Count} orçamentos cadastrados; {open} ainda estão em aberto.";
            }
            else
            {
                var services = await AcompanhamentoService.ListAsync();
                var withPending = services.Count(x => x.Pendencias > x.Concluidas);
                _answer = $"Existem {services.Count} serviços em acompanhamento; {withPending} possuem pendências abertas. Use os filtros da fila operacional para localizar os casos.";
            }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }
}
