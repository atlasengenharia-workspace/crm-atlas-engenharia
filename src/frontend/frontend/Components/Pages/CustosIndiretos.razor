@page "/financeiro/custos-indiretos"
@attribute [Authorize]
@inject ICustoIndiretoService Service
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Custos Indiretos | CRM Atlas</PageTitle>

<PageHeader Title="Custos indiretos" Subtitle="Acompanhamento e controle de despesas administrativas, operacionais e fixas do escritório.">
    <Actions>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile"
                   OnClick="@(() => _importOpen = true)" Class="mr-2">Importar CSV</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="New">Novo custo</MudButton>
    </Actions>
</PageHeader>

<GlobalSkeleton IsLoading="_loading" Layout="GlobalSkeleton.SkeletonLayoutType.Dashboard" MetricCount="4">
    <!-- Top Metric Cards (4 Cards for Symmetry and Clarity) -->
    <MudGrid Class="mb-5" Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MetricCard Title="Total no período" Value="@Money(_analytics.Sum(x => x.Valor))"
                        FooterText="Soma das despesas filtradas" Icon="@Icons.Material.Filled.Payments" Color="Color.Error" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MetricCard Title="Média por custo" Value="@Money(_analytics.Count == 0 ? 0 : _analytics.Average(x => x.Valor))"
                        FooterText="Valor médio por lançamento" Icon="@Icons.Material.Filled.Analytics" Color="Color.Info" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MetricCard Title="Maior categoria" Value="@TopCategory"
                        FooterText="Maior impacto no orçamento" Icon="@Icons.Material.Filled.Category" Color="Color.Warning" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MetricCard Title="Total de lançamentos" Value="@_analytics.Count.ToString("N0", PtBr)"
                        FooterText="Registros no período" Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" />
        </MudItem>
    </MudGrid>

    <!-- Analytics & Interactive Category Chips Panel -->
    <MudGrid Class="mb-5" Spacing="4">
        <MudItem xs="12" lg="7">
            <MudPaper Outlined="true" Class="pa-5 atlas-panel h-100">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Distribuição por Categoria</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Participação proporcional das despesas no período selecionado</MudText>
                    </div>
                </MudStack>
                @if (_chartSeries.Count > 0 && _chartLabels.Length > 0 && _chartSeries[0].Data != null && _chartSeries[0].Data.Count == _chartLabels.Length)
                {
                    <div class="d-flex justify-center align-center py-2" style="min-height: 280px;">
                        <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="_chartSeries"
                                  ChartLabels="_chartLabels" Width="100%" Height="270px" />
                    </div>
                }
                else
                {
                    <EmptyState Title="Sem dados para exibição do gráfico" Message="Ajuste o filtro de datas ou cadastre um novo custo." />
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudPaper Outlined="true" Class="pa-5 atlas-panel h-100">
                <MudText Typo="Typo.h6" Class="font-weight-bold">Filtrar por Categoria</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">Clique em uma categoria para filtrar a listagem rapidamente</MudText>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    <MudChip T="string" Color="@(string.IsNullOrWhiteSpace(_selectedCategory) ? Color.Primary : Color.Default)"
                             Variant="@(string.IsNullOrWhiteSpace(_selectedCategory) ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => SelectCategoryAsync(null))">
                        Todas (@_analytics.Count)
                    </MudChip>

                    @foreach (var category in Categories)
                    {
                        var catCount = _analytics.Count(x => string.Equals(x.Categoria, category, StringComparison.OrdinalIgnoreCase));
                        var isSelected = string.Equals(_selectedCategory, category, StringComparison.OrdinalIgnoreCase);

                        <MudChip T="string" Color="@(isSelected ? Color.Primary : Color.Default)"
                                 Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => SelectCategoryAsync(category))">
                            @category @(catCount > 0 ? $"({catCount})" : "")
                        </MudChip>
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Search & Filter Controls -->
    <MudPaper Outlined="true" Class="atlas-filter-panel pa-4 mb-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_search" Placeholder="Buscar por descrição ou categoria..."
                              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              OnClearButtonClick="@ClearSearchAsync" Immediate="true" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudDatePicker @bind-Date="_start" Label="Data Inicial"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudDatePicker @bind-Date="_end" Label="Data Final"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex gap-2 align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterAlt"
                           OnClick="ApplyFilterAsync" Class="flex-grow-1">Filtrar</MudButton>
                @if (HasActiveFilters)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff" Color="Color.Secondary" OnClick="ResetFiltersAsync" aria-label="Limpar Filtros" />
                }
            </MudItem>
        </MudGrid>

        <!-- Quick Date Range Presets -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-3 gap-2 flex-wrap">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Atalhos de Período:</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SetDatePreset(0))">Este Mês</MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SetDatePreset(1))">Mês Anterior</MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SetDatePreset(2))">Este Ano</MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SetDatePreset(3))">Todo o Histórico</MudChip>
        </MudStack>
    </MudPaper>

    <!-- Main Data Table -->
    <MudPaper Outlined="true" Class="atlas-panel">
        <SmartTableFilter TItem="CustoIndiretoDto" Items="_result.Items" Columns="_filterColumns">
        <ChildContent Context="smartItems">
        <MudTable Items="smartItems" Hover="true" Striped="true" Loading="_loading" Elevation="0">
            <HeaderContent>
                <MudTh style="width: 70px;">#ID</MudTh>
                <MudTh>Data</MudTh>
                <MudTh>Descrição</MudTh>
                <MudTh>Categoria</MudTh>
                <MudTh Class="text-right">Valor (R$)</MudTh>
                <MudTh Class="text-right" style="width: 110px;">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="#ID" Class="font-mono text-caption">#@context.Id</MudTd>
                <MudTd DataLabel="Data">@context.Data.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Descrição">
                    <MudText Typo="Typo.body2" Class="font-weight-bold">@context.Descricao</MudText>
                </MudTd>
                <MudTd DataLabel="Categoria">
                    <MudChip T="string" Size="Size.Small" Color="@GetCategoryChipColor(context.Categoria)" Variant="Variant.Outlined">
                        @context.Categoria
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Valor" Class="text-right font-weight-bold color-error">
                    @Money(context.Valor)
                </MudTd>
                <MudTd DataLabel="Ações" Class="text-right">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => Edit(context))" aria-label="Editar custo" />
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => DeleteAsync(context))" aria-label="Excluir custo" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Title="Nenhum custo indireto encontrado"
                            Message="Ajuste os filtros de busca ou cadastre uma nova despesa." />
            </NoRecordsContent>
        </MudTable>
        </ChildContent>
        </SmartTableFilter>

        <MudDivider />
        <MudToolBar Class="justify-space-between flex-wrap gap-2 pa-2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Página @_page</MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" OnClick="PreviousAsync" Disabled="_page == 1">Anterior</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="NextAsync" Disabled="!_result.HasNext">Próxima</MudButton>
            </MudStack>
        </MudToolBar>
    </MudPaper>
</GlobalSkeleton>

<!-- Create / Edit Drawer -->
<MudDrawer @bind-Open="_editorOpen" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary"
           Width="min(480px, 100vw)" Elevation="8">
    <div class="pa-5">
        <MudToolBar Class="pa-0 mb-3">
            <MudText Typo="Typo.h5" Class="font-weight-bold">@(_model.Id is null ? "Novo Custo Indireto" : "Editar Custo Indireto")</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _editorOpen = false)" />
        </MudToolBar>
        <MudDivider Class="mb-5" />

        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudStack Spacing="3">
                <MudDatePicker @bind-Date="_model.Data" Label="Data do Lançamento" Required="true"
                               Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Culture="PtBr" />
                
                <MudTextField @bind-Value="_model.Descricao" Label="Descrição do Custo" Required="true"
                               RequiredError="Informe a descrição da despesa." Variant="Variant.Outlined"
                               Placeholder="Ex: Aluguel da sede - Mês 07" />

                <MudSelect T="string" @bind-Value="_model.Categoria" Label="Categoria" Required="true"
                           RequiredError="Informe a categoria." Variant="Variant.Outlined">
                    @foreach (var category in Categories)
                    {
                        <MudSelectItem Value="@category">@category</MudSelectItem>
                    }
                </MudSelect>

                <MudNumericField T="decimal" @bind-Value="_model.Valor" Label="Valor (R$)"
                                 Min="0.01M" Format="C2" Culture="PtBr" Required="true"
                                 Variant="Variant.Outlined" HelperText="Informe o valor em Reais" />
            </MudStack>
        </MudForm>

        <MudDivider Class="mt-6 mb-4" />
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton OnClick="@(() => _editorOpen = false)">Cancelar</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_saving" OnClick="SaveAsync">Salvar Custo</MudButton>
        </MudStack>
    </div>
</MudDrawer>

<!-- CSV Import Drawer with Animated Overlay -->
<MudDrawer @bind-Open="_importOpen" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary"
           Width="min(760px, 100vw)" Elevation="8">
    <div class="pa-5 position-relative" style="min-height: 480px;">
        <ImportingAnimationOverlay IsVisible="_importing" Title="Importando custos indiretos..." Subtitle="Processando registros CSV e salvando despesas no financeiro." />

        <MudToolBar Class="pa-0 mb-3">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5" Class="font-weight-bold">Importar Custos via CSV</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Pré-visualize e valide a estrutura do arquivo antes de gravar.</MudText>
            </MudStack>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _importOpen = false)" Disabled="_importing" />
        </MudToolBar>
        <MudDivider Class="mb-4" />

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
            Estrutura CSV requerida (separado por <strong>;</strong> ou <strong>,</strong>):<br />
            <code>data;descricao;categoria;valor</code><br />
            Exemplo: <code>25/07/2026;Aluguel Escritório;Aluguel;2500,00</code>
        </MudAlert>

        <InputFile OnChange="ParseImportAsync" accept=".csv,text/csv" />

        @if (_preview.Count > 0)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="my-4">
                <MudText Typo="Typo.subtitle2">@_preview.Count linha(s) encontrada(s) • @_preview.Count(x => x.Valid) válida(s)</MudText>
                @if (_preview.Any(x => !x.Valid))
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Corrija o arquivo antes de confirmar</MudChip>
                }
            </MudStack>

            <MudTable Items="_preview" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                <HeaderContent>
                    <MudTh>Linha</MudTh>
                    <MudTh>Data</MudTh>
                    <MudTh>Descrição</MudTh>
                    <MudTh>Categoria</MudTh>
                    <MudTh Class="text-right">Valor</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Linha">@context.Line</MudTd>
                    <MudTd DataLabel="Data">@context.Date</MudTd>
                    <MudTd DataLabel="Descrição">@context.Description</MudTd>
                    <MudTd DataLabel="Categoria">@context.Category</MudTd>
                    <MudTd DataLabel="Valor" Class="text-right">@context.Value</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@(context.Valid ? Color.Success : Color.Error)">
                            @(context.Valid ? "Válida" : context.Error)
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        <MudDivider Class="mt-6 mb-4" />
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton OnClick="@(() => _importOpen = false)" Disabled="_importing">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check"
                       Disabled="@(_importing || _preview.Count == 0 || _preview.Any(x => !x.Valid))" OnClick="ConfirmImportAsync">
                Confirmar Importação
            </MudButton>
        </MudStack>
    </div>
</MudDrawer>

@code {
    private static readonly System.Globalization.CultureInfo PtBr = new("pt-BR");

    private static readonly string[] Categories =
        ["Aluguel", "Energia", "Água", "Internet e telefonia", "Software", "Combustível", "Materiais", "Marketing", "Contabilidade", "Impostos", "Outros"];

    private CursorResult<CustoIndiretoDto> _result = new([], 1, 20, null, false);
    private List<long?> _cursors = new List<long?> { null };
    private readonly IReadOnlyList<SmartFilterColumn<CustoIndiretoDto>> _filterColumns =
    [
        new("id","ID",x=>x.Id,1),new("data","Data",x=>x.Data,2),
        new("descricao","Descrição",x=>x.Descricao,3),new("categoria","Categoria",x=>x.Categoria,4),
        new("valor","Valor",x=>x.Valor,5,true)
    ];
    private IReadOnlyList<CustoIndiretoDto> _analytics = [];
    private List<ChartSeries<double>> _chartSeries = [];
    private string[] _chartLabels = [];
    private readonly List<ImportPreviewRow> _preview = [];
    private CostModel _model = new();
    private MudForm? _form;
    private bool _valid;
    private bool _loading = true;
    private bool _saving;
    private bool _editorOpen;
    private bool _importOpen;
    private bool _importing;
    private string? _search;
    private string? _selectedCategory;
    private DateTime? _start;
    private DateTime? _end;
    private int _page = 1;

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_search) || !string.IsNullOrWhiteSpace(_selectedCategory) || _start.HasValue || _end.HasValue;

    private string TopCategory => _analytics
        .GroupBy(x => x.Categoria)
        .OrderByDescending(x => x.Sum(y => y.Valor))
        .Select(x => x.Key)
        .FirstOrDefault() ?? "Sem dados";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ApplyFilterAsync() { _page = 1; await LoadAsync(); }
    private async Task PreviousAsync()
    {
        if (_page > 1)
        {
            _page--;
            await LoadAsync();
        }
    }
    private async Task NextAsync()
    {
        if (_result.HasNext)
        {
            _page++;
            _cursors.Add(_result.NextCursor);
            await LoadAsync();
        }
    }

    private async Task SelectCategoryAsync(string? category)
    {
        _selectedCategory = category;
        _page = 1; _cursors = new List<long?> { null };
        await LoadAsync();
    }

    private async Task ClearSearchAsync()
    {
        _search = null;
        _page = 1; _cursors = new List<long?> { null };
        await LoadAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _search = null;
        _selectedCategory = null;
        _start = null;
        _end = null;
        _page = 1; _cursors = new List<long?> { null };
        await LoadAsync();
    }

    private async Task SetDatePreset(int preset)
    {
        var now = DateTime.Today;
        switch (preset)
        {
            case 0: // Este Mês
                _start = new DateTime(now.Year, now.Month, 1);
                _end = new DateTime(now.Year, now.Month, DateTime.DaysInMonth(now.Year, now.Month));
                break;
            case 1: // Mês Anterior
                var prevMonth = now.AddMonths(-1);
                _start = new DateTime(prevMonth.Year, prevMonth.Month, 1);
                _end = new DateTime(prevMonth.Year, prevMonth.Month, DateTime.DaysInMonth(prevMonth.Year, prevMonth.Month));
                break;
            case 2: // Este Ano
                _start = new DateTime(now.Year, 1, 1);
                _end = new DateTime(now.Year, 12, 31);
                break;
            case 3: // Todo o Histórico
                _start = null;
                _end = null;
                break;
        }
        _page = 1; _cursors = new List<long?> { null };
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var searchCategoryFilter = !string.IsNullOrWhiteSpace(_selectedCategory) ? _selectedCategory : _search;

            _result = await Service.ListAsync(new(
                ToDateOnly(_start), ToDateOnly(_end), _search, searchCategoryFilter, _page, 20, _cursors[_page - 1]));

            _analytics = (await Service.ListAsync(new(
                ToDateOnly(_start), ToDateOnly(_end), _search, searchCategoryFilter, 1, 1000, null))).Items;

            var allGroups = _analytics
                .Where(x => !string.IsNullOrWhiteSpace(x.Categoria))
                .GroupBy(x => x.Categoria)
                .Select(x => new { Label = x.Key, Total = x.Sum(y => y.Valor) })
                .Where(x => x.Total > 0)
                .OrderByDescending(x => x.Total).ToList();

            var groups = allGroups.Take(7).ToList();
            if (allGroups.Count > 7)
            {
                groups.Add(new { Label = "Outras categorias", Total = allGroups.Skip(7).Sum(x => x.Total) });
            }

            if (groups.Count > 0)
            {
                _chartLabels = groups.Select(x => x.Label).ToArray();
                _chartSeries = [new ChartSeries<double> { Name = "Custos (R$)", Data = groups.Select(x => (double)x.Total).ToArray() }];
            }
            else
            {
                _chartLabels = Array.Empty<string>();
                _chartSeries = new List<ChartSeries<double>>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void New() { _model = new(); _editorOpen = true; }

    private void Edit(CustoIndiretoDto x)
    {
        _model = new()
        {
            Id = x.Id,
            Data = x.Data.ToDateTime(TimeOnly.MinValue),
            Descricao = x.Descricao,
            Categoria = x.Categoria,
            Valor = x.Valor
        };
        _editorOpen = true;
    }

    private async Task SaveAsync()
    {
        await (_form?.ValidateAsync() ?? Task.CompletedTask);
        if (!_valid || _model.Data is null) return;
        _saving = true;
        try
        {
            var dto = new CustoIndiretoDto(
                _model.Id, DateOnly.FromDateTime(_model.Data.Value),
                _model.Descricao, _model.Valor, _model.Categoria);

            if (_model.Id is null) await Service.CreateAsync(dto);
            else await Service.UpdateAsync(_model.Id.Value, dto);

            _editorOpen = false;
            Snackbar.Add("Custo indireto salvo com sucesso.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(CustoIndiretoDto x)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Excluir custo indireto", $"Deseja realmente excluir a despesa “{x.Descricao}” ({Money(x.Valor)})?",
            yesText: "Excluir", cancelText: "Cancelar");

        if (confirm != true || x.Id is null) return;
        try
        {
            await Service.DeleteAsync(x.Id.Value);
            await LoadAsync();
            Snackbar.Add("Custo indireto excluído com sucesso.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ParseImportAsync(InputFileChangeEventArgs args)
    {
        _preview.Clear();
        try
        {
            await using var stream = args.File.OpenReadStream(100 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var lineNumber = 0;
            while (await reader.ReadLineAsync() is { } line)
            {
                lineNumber++;
                if (string.IsNullOrWhiteSpace(line)) continue;
                var fields = SplitCsv(line);
                if (lineNumber == 1 && fields.Count > 0 && fields[0].Contains("data", StringComparison.OrdinalIgnoreCase))
                    continue;
                _preview.Add(ParseRow(lineNumber, fields));
            }
            if (_preview.Count == 0) Snackbar.Add("O arquivo não possui linhas válidas para importar.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Não foi possível ler o arquivo CSV: {ex.Message}", Severity.Error);
        }
    }

    private async Task ConfirmImportAsync()
    {
        if (_preview.Count == 0 || _preview.Any(x => !x.Valid)) return;
        _importing = true;
        try
        {
            await Service.ImportAsync(_preview.Select(x => x.Dto!).ToList());
            Snackbar.Add($"{_preview.Count} custo(s) indireto(s) importados com sucesso.", Severity.Success);
            _preview.Clear();
            _importOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private static ImportPreviewRow ParseRow(int line, IReadOnlyList<string> fields)
    {
        if (fields.Count != 4) return new(line, "", "", "", "", false, "Esperadas 4 colunas", null);

        var validDate = DateOnly.TryParseExact(fields[0].Trim(), "dd/MM/yyyy", PtBr,
            System.Globalization.DateTimeStyles.None, out var date);

        var validValue = decimal.TryParse(fields[3].Trim(), System.Globalization.NumberStyles.Number, PtBr, out var value)
            || decimal.TryParse(fields[3].Trim(), System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out value);

        var description = fields[1].Trim();
        var category = fields[2].Trim();

        var error = !validDate ? "Data inválida" : string.IsNullOrWhiteSpace(description) ? "Descrição obrigatória"
            : string.IsNullOrWhiteSpace(category) ? "Categoria obrigatória" : !validValue || value <= 0 ? "Valor inválido" : null;

        var dto = error is null ? new CustoIndiretoDto(null, date, description, value, category) : null;
        return new(line, fields[0], description, category, fields[3], error is null, error, dto);
    }

    private static List<string> SplitCsv(string line)
    {
        var separator = line.Count(x => x == ';') >= line.Count(x => x == ',') ? ';' : ',';
        var result = new List<string>();
        var value = new System.Text.StringBuilder();
        var quoted = false;
        for (var i = 0; i < line.Length; i++)
        {
            var c = line[i];
            if (c == '"' && i + 1 < line.Length && line[i + 1] == '"') { value.Append('"'); i++; }
            else if (c == '"') quoted = !quoted;
            else if (c == separator && !quoted) { result.Add(value.ToString()); value.Clear(); }
            else value.Append(c);
        }
        result.Add(value.ToString());
        return result;
    }

    private static Color GetCategoryChipColor(string category) => category.ToLowerInvariant() switch
    {
        "aluguel" or "energia" or "água" => Color.Warning,
        "internet e telefonia" or "software" => Color.Info,
        "combustível" or "materiais" => Color.Secondary,
        "impostos" or "contabilidade" => Color.Error,
        _ => Color.Primary
    };

    private static DateOnly? ToDateOnly(DateTime? value) =>
        value is null ? null : DateOnly.FromDateTime(value.Value);

    private static string Money(decimal value) => value.ToString("C2", PtBr);

