@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">
    <MudPaper Outlined="true" Class="pa-6">
        <MudStack Spacing="3" AlignItems="AlignItems.Start">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
            <MudText Typo="Typo.h4" Color="Color.Error">Ocorreu um erro</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Não foi possível processar a requisição atual.
            </MudText>

            @if (ShowRequestId)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="w-100 mt-2">
                    <strong>ID da requisição:</strong> <code>@RequestId</code>
                </MudAlert>
            }

            <MudDivider Class="my-3 w-100" />

            <MudText Typo="Typo.subtitle2">Modo de desenvolvimento</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Para depuração local, verifique a variável de ambiente <strong>ASPNETCORE_ENVIRONMENT=Development</strong>.
            </MudText>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" StartIcon="@Icons.Material.Filled.Home" Class="mt-4">
                Voltar ao início
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
