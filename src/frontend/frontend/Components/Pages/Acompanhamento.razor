    </div>
</MudDrawer>

<MudDrawer @bind-Open="_importOpen" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Width="min(820px,100vw)" Elevation="8">
    <div class="atlas-import-drawer position-relative">
        <ImportingAnimationOverlay IsVisible="_importing" Title="Importando dados" Subtitle="Aguarde enquanto os dados são gravados com segurança." />

        <div class="atlas-import-header pa-5 pb-3">
            <MudToolBar Class="pa-0">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h5">Importação em lote</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Selecione, valide e confirme a planilha.</MudText>
                </MudStack>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseImportDrawer" Disabled="@(_importing || _parsingImport)" />
            </MudToolBar>
        </div>

        <div class="atlas-import-content px-5 pb-5">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                 No XLSX ou XLSB, uma única confirmação preenche Clientes, Serviços, Acompanhamento, Lançamentos e Custos Indiretos. As abas AVCB, CLCB, OBRAS, PROCESSOS ADM, LANÇAMENTOS e CUSTOS INDIRETOS são vinculadas pelo código.
            </MudAlert>

            <MudFileUpload T="IBrowserFile"
                           FilesChanged="ParseImportAsync"
                             Accept=".xlsx,.xlsb,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel.sheet.binary.macroEnabled.12,text/csv"
                           MaxFileSize="@(100L * 1024 * 1024)"
                           MaximumFileCount="1"
                           DragAndDrop="true"
                           Disabled="@(_importing || _parsingImport)">
                <CustomContent>
                    <MudPaper Outlined="true" Class="atlas-upload-zone pa-5" @onclick="context.OpenFilePickerAsync">
                        <MudStack AlignItems="AlignItems.Center" Spacing="1">
                            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Large">
                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" />
                            </MudAvatar>
                            <MudText Typo="Typo.subtitle1" Align="Align.Center">Arraste a planilha aqui ou clique para selecionar</MudText>
                             <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">XLSX, XLSB ou CSV • tamanho máximo de 100 MB</MudText>
                        </MudStack>
                    </MudPaper>
                </CustomContent>
            </MudFileUpload>

            @if (_parsingImport)
            {
                <MudPaper Outlined="true" Class="pa-4 mt-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle2">Lendo e validando a planilha...</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Arquivos maiores podem levar alguns instantes.</MudText>
                        </MudStack>
                    </MudStack>
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
                </MudPaper>
            }
            else if (!string.IsNullOrWhiteSpace(_uploadedFileName))
            {
                <MudPaper Outlined="true" Class="pa-3 mt-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudAvatar Color="Color.Success" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Description" />
                        </MudAvatar>
                        <MudStack Spacing="0" Class="atlas-file-info">
                            <MudText Typo="Typo.subtitle2">@_uploadedFileName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatFileSize(_uploadedFileSize) • @_preview.Count linha(s) localizada(s)</MudText>
                        </MudStack>
                        <MudSpacer />
                        <MudTooltip Text="Remover arquivo">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="ClearImportFile" />
                        </MudTooltip>
                    </MudStack>
                </MudPaper>
            }

            @if (_preview.Count > 0)
            {
                var invalidCount = _preview.Count(x => !x.Valid);
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-5 mb-2" Spacing="1">
                    <MudText Typo="Typo.h6">Pré-visualização</MudText>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@(_preview.Count - invalidCount) válida(s)</MudChip>
                    @if (invalidCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">@invalidCount com erro</MudChip>
                    }
                </MudStack>
                <MudTable Items="_preview" Dense="true" Hover="true" FixedHeader="true" Height="min(42vh, 420px)" Breakpoint="Breakpoint.Sm" Class="atlas-import-preview">
                     <HeaderContent><MudTh>Linha</MudTh><MudTh>Código</MudTh><MudTh>Tipo</MudTh><MudTh>Situação</MudTh><MudTh>Cliente</MudTh><MudTh>Validação</MudTh></HeaderContent>
                     <RowTemplate><MudTd DataLabel="Linha">@context.Line</MudTd><MudTd DataLabel="Código">@context.Code</MudTd><MudTd DataLabel="Tipo">@context.Type</MudTd><MudTd DataLabel="Situação">@(context.Dto?.Situacao ?? "—")</MudTd><MudTd DataLabel="Cliente">@context.Client</MudTd><MudTd DataLabel="Validação"><MudChip T="string" Size="Size.Small" Color="@(context.Valid ? Color.Success : Color.Error)">@(context.Valid ? "Válida" : context.Error)</MudChip></MudTd></RowTemplate>
                </MudTable>
            }
        </div>

        <div class="atlas-import-footer pa-4 px-5">
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton OnClick="CloseImportDrawer" Disabled="@(_importing || _parsingImport)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CheckCircle" Disabled="@(_preview.Count == 0 || _preview.Any(x => !x.Valid) || _importing || _parsingImport)" OnClick="ConfirmImportAsync">Confirmar importação</MudButton>
            </MudStack>
        </div>
    </div>
</MudDrawer>

