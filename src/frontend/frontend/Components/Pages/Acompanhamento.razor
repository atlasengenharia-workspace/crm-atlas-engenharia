@page "/acompanhamento"
@attribute [Authorize]
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IAcompanhamentoService Service
@inject IAcompanhamentoSpreadsheetReader SpreadsheetReader
@inject IAtlasWorkbookImportService WorkbookImportService
@inject ISnackbar Snackbar

<PageTitle>Serviços | CRM Atlas</PageTitle>
<PageHeader Title="Serviços" Subtitle="Acompanhe, filtre e gerencie todos os serviços em uma única tela.">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirFormularioNovo">
            Novo serviço
        </MudButton>
        <MudTooltip Text="Mostrar opções para importação em lote" Placement="Placement.Bottom">
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.UploadFile"
                       OnClick="@(() => _importOpen = true)"
                       Style="background-color: #F59E0B; color: #FFFFFF; box-shadow: 0 3px 8px rgba(245, 158, 11, 0.28);" Class="ml-2">
                Importar planilha
            </MudButton>
        </MudTooltip>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SimCardDownload" Class="ml-2" OnClick="ExportarExcelAsync">Exportar Excel</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Settings" Class="ml-2" OnClick="OpenSettings">Situações</MudButton>
    </Actions>
</PageHeader>

<GlobalSkeleton IsLoading="_loading" Layout="GlobalSkeleton.SkeletonLayoutType.Table" MetricCount="4" ColumnCount="6">
    <MudGrid Class="mb-4">
        <MudItem xs="6" md="3"><MetricCard Title="Serviços" Value="@Filtered.Count().ToString()" Icon="@Icons.Material.Filled.Assignment" Color="Color.Info" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="Com pendências" Value="@Filtered.Count(x=>x.Pendencias>x.Concluidas).ToString()" Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="Pendências abertas" Value="@Filtered.Sum(x=>x.Pendencias-x.Concluidas).ToString()" Icon="@Icons.Material.Filled.PendingActions" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="Sem pendências" Value="@Filtered.Count(x=>x.Pendencias==x.Concluidas).ToString()" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" /></MudItem>
    </MudGrid>

    <MudPaper Outlined="true" Class="pa-4">
        <MudGrid Class="mb-3">
            <MudItem xs="12" md="5">
                <MudTextField T="string" @bind-Value="_search" Placeholder="Buscar código, cliente, serviço, endereço ou situação" Immediate="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="AcompanhamentoServicoTipo?" @bind-Value="_tipoFiltro"
                           Label="Tipo de serviço" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    @foreach (var type in Enum.GetValues<AcompanhamentoServicoTipo>())
                    {
                        <MudSelectItem T="AcompanhamentoServicoTipo?" Value="@(new AcompanhamentoServicoTipo?(type))">@TypeLabel(type)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSwitch T="bool" @bind-Value="_hideCompleted" Color="Color.Primary"
                           Label="Ocultar concluídos" />
            </MudItem>
        </MudGrid>
        <SmartTableFilter TItem="AcompanhamentoDto" Items="Filtered" Columns="_filterColumns"
                          HiddenColumns="_hiddenColumns" HiddenColumnsChanged="OnHiddenColumnsChanged">
        <ChildContent Context="smartItems">
        <div class="atlas-operational-table-scroll">
        @if (_selectedIds.Count > 0)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudText Class="font-weight-bold">@_selectedIds.Count selecionado(s)</MudText>
                    <MudSelect T="string" @bind-Value="_bulkSituacao" Label="Nova situação" Clearable="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 180px;">
                        @foreach (var status in _situations.Where(x => x.Ativo).Select(x => x.Nome).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x))
                        {
                            <MudSelectItem T="string" Value="@status">@status</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" @bind-Value="_bulkDescricao" Label="Nova observação"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 220px;" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                               OnClick="@(() => AplicarBulkAsync())" Disabled="_bulkApplying">Aplicar em massa</MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Clear" OnClick="@(() => _selectedIds.Clear())">Limpar</MudButton>
                </MudStack>
            </MudPaper>
        }
        <MudTable Items="smartItems" Hover="true" Breakpoint="Breakpoint.Md" Elevation="0" Loading="_loading" Class="atlas-operational-table">
            <HeaderContent>
                <MudTh Style="width: 40px;"><MudCheckBox T="bool" Value="@(smartItems.All(x => _selectedIds.Contains(x.Id)))" ValueChanged="@(async (bool b) => ToggleSelectAll(smartItems, b))" Dense="true" /></MudTh>
                <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.Codigo)">Código</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="Código" Items="Filtered" GetValue='x=>x.Codigo' Selected='@GetColumnFilter("codigo")' SelectedChanged='(v)=>OnColumnFilterChanged("codigo", v)' />
                    </MudStack>
                </MudTh>
                <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.Cliente??string.Empty)">Cliente</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="Cliente" Items="Filtered" GetValue='x=>x.Cliente' Selected='@GetColumnFilter("cliente")' SelectedChanged='(v)=>OnColumnFilterChanged("cliente", v)' />
                    </MudStack>
                </MudTh>
                <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.Endereco??string.Empty)">Endereço</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="Endereço" Items="Filtered" GetValue='x=>x.Endereco' Selected='@GetColumnFilter("endereco")' SelectedChanged='(v)=>OnColumnFilterChanged("endereco", v)' />
                    </MudStack>
                </MudTh>
                <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.Telefone??string.Empty)">Telefone</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="Telefone" Items="Filtered" GetValue='x=>x.Telefone' Selected='@GetColumnFilter("telefone")' SelectedChanged='(v)=>OnColumnFilterChanged("telefone", v)' />
                    </MudStack>
                </MudTh>
                 <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.Servico??string.Empty)">Serviço</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="Tipo" Items="Filtered" GetValue='x=>TypeLabel(x.Tipo)' Selected='@GetColumnFilter("tipo")' SelectedChanged='(v)=>OnColumnFilterChanged("tipo", v)' />
                    </MudStack>
                 </MudTh>
                  <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.ValorContrato??0)">R$ Contrato</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="R$ Contrato" Items="Filtered" GetValue='x=>Money(x.ValorContrato)' Selected='@GetColumnFilter("valorContrato")' SelectedChanged='(v)=>OnColumnFilterChanged("valorContrato", v)' />
                    </MudStack>
                </MudTh>
                  <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.DataContrato??DateOnly.MinValue)">Data Contrato</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="Data Contrato" Items="Filtered" GetValue='x=>x.DataContrato?.ToString("dd/MM/yyyy")' Selected='@GetColumnFilter("dataContrato")' SelectedChanged='(v)=>OnColumnFilterChanged("dataContrato", v)' />
                    </MudStack>
                </MudTh>
                   <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.NotaFiscal??string.Empty)">NF</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="NF" Items="Filtered" GetValue='x=>x.NotaFiscal' Selected='@GetColumnFilter("nf")' SelectedChanged='(v)=>OnColumnFilterChanged("nf", v)' />
                    </MudStack>
                </MudTh>
                   <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.CondicaoPagamento??string.Empty)">Condição pag.</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="Condição pag." Items="Filtered" GetValue='x=>x.CondicaoPagamento' Selected='@GetColumnFilter("condicaoPagamento")' SelectedChanged='(v)=>OnColumnFilterChanged("condicaoPagamento", v)' />
                    </MudStack>
                </MudTh>
                   <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.ProximaParcela??DateOnly.MinValue)">Prox. Parcela</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="Prox. Parcela" Items="Filtered" GetValue='x=>x.ProximaParcela?.ToString("dd/MM/yyyy") ?? x.ProximaParcelaTexto' Selected='@GetColumnFilter("proximaParcela")' SelectedChanged='(v)=>OnColumnFilterChanged("proximaParcela", v)' />
                    </MudStack>
                </MudTh>
                <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.Situacao)">Situação</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="Situação" Items="Filtered" GetValue='x=>x.Situacao' Selected='@GetColumnFilter("situacao")' SelectedChanged='(v)=>OnColumnFilterChanged("situacao", v)' />
                    </MudStack>
                </MudTh>
                 <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.Descricao??string.Empty)">Observações</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="Observações" Items="Filtered" GetValue='x=>x.Descricao' Selected='@GetColumnFilter("observacoes")' SelectedChanged='(v)=>OnColumnFilterChanged("observacoes", v)' />
                    </MudStack>
                </MudTh>
                <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.ObservacaoMudanca??string.Empty)">Observação da mudança</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="Observação da mudança" Items="Filtered" GetValue='x=>x.ObservacaoMudanca' Selected='@GetColumnFilter("observacaoMudanca")' SelectedChanged='(v)=>OnColumnFilterChanged("observacaoMudanca", v)' />
                    </MudStack>
                </MudTh>
                 <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.AReceber??0)">A receber</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="A receber" Items="Filtered" GetValue='x=>Money(x.AReceber)' Selected='@GetColumnFilter("areceber")' SelectedChanged='(v)=>OnColumnFilterChanged("areceber", v)' />
                    </MudStack>
                </MudTh>
                 <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.Recebido??0)">Recebido</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="Recebido" Items="Filtered" GetValue='x=>Money(x.Recebido)' Selected='@GetColumnFilter("recebido")' SelectedChanged='(v)=>OnColumnFilterChanged("recebido", v)' />
                    </MudStack>
                </MudTh>
                 <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.Custos??0)">Custos</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="Custos" Items="Filtered" GetValue='x=>Money(x.Custos)' Selected='@GetColumnFilter("custos")' SelectedChanged='(v)=>OnColumnFilterChanged("custos", v)' />
                    </MudStack>
                </MudTh>
                 <MudTh>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                        <MudTableSortLabel SortBy="new Func<AcompanhamentoDto, object>(x=>x.AtualizadoEm??DateTime.MinValue)">Atualização</MudTableSortLabel>
                        <ColumnFilter TItem="AcompanhamentoDto" OnHide="ToggleHiddenColumn" OnPin="TogglePinColumn" Label="Atualização" Items="Filtered" GetValue='x=>x.AtualizadoEm?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")' Selected='@GetColumnFilter("atualizacao")' SelectedChanged='(v)=>OnColumnFilterChanged("atualizacao", v)' />
                    </MudStack>
                </MudTh><MudTh>Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudCheckBox T="bool" Value="@(_selectedIds.Contains(context.Id))" ValueChanged="@((bool b) => ToggleSelect(context, b))" Dense="true" /></MudTd>
                <MudTd DataLabel="Código"><strong>@context.Codigo</strong></MudTd>
                <MudTd DataLabel="Cliente">@context.Cliente</MudTd>
                <MudTd DataLabel="Endereço">@(string.IsNullOrWhiteSpace(context.Endereco) ? "—" : context.Endereco)</MudTd>
                <MudTd DataLabel="Telefone">@(string.IsNullOrWhiteSpace(context.Telefone) ? "—" : context.Telefone)</MudTd>
                <MudTd DataLabel="Serviço">
                    <MudText Typo="Typo.body2" Class="font-weight-medium">@(string.IsNullOrWhiteSpace(context.Servico) ? TypeLabel(context.Tipo) : context.Servico)</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@TypeColor(context.Tipo)">@TypeLabel(context.Tipo)</MudChip>
                 </MudTd>
                  <MudTd DataLabel="R$ Contrato">@Money(context.ValorContrato)</MudTd>
                  <MudTd DataLabel="Data Contrato">@(context.DataContrato?.ToString("dd/MM/yyyy") ?? "—")</MudTd>
                   <MudTd DataLabel="NF">@(string.IsNullOrWhiteSpace(context.NotaFiscal) ? "—" : context.NotaFiscal)</MudTd>
                   <MudTd DataLabel="Condição pag.">@(string.IsNullOrWhiteSpace(context.CondicaoPagamento) ? "—" : context.CondicaoPagamento)</MudTd>
                   <MudTd DataLabel="Prox. Parcela">@(context.ProximaParcela?.ToString("dd/MM/yyyy") ?? context.ProximaParcelaTexto ?? "—")</MudTd>
                 <MudTd DataLabel="Situação">
                     @if (_editStatusId == context.Id)
                     {
                         <MudSelect T="string" Value="_editingSituacao" ValueChanged="@(async (string s) => await SaveSituacaoAsync(context, s))"
                                    Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                             @foreach (var status in StatusesFor(context.Tipo))
                             {
                                 <MudSelectItem T="string" Value="@status">@status</MudSelectItem>
                             }
                         </MudSelect>
                     }
                     else
                     {
                         <span class="atlas-status-pill" style="@SituationStyle(context)" @onclick="@(() => StartEditSituacao(context))">@context.Situacao</span>
                     }
                 </MudTd>
                 <MudTd DataLabel="Observações" Class="atlas-observation-cell">
                     @if (_editDescId == context.Id)
                     {
                         <MudTextField @bind-Value="_editingDescricao"
                                       OnBlur="@(async () => await SaveDescricaoAsync(context))"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                     }
                     else
                     {
                         <MudText Typo="Typo.body2" @onclick="@(() => StartEditDescricao(context))" Style="cursor:pointer;">@(string.IsNullOrWhiteSpace(context.Descricao) ? "—" : context.Descricao)</MudText>
                     }
                 </MudTd>
                 <MudTd DataLabel="Observação da mudança" Class="atlas-observation-cell">
                     <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(context.ObservacaoMudanca) ? "—" : context.ObservacaoMudanca)</MudText>
                 </MudTd>
                 <MudTd DataLabel="A receber">@Money(context.AReceber)</MudTd>
                 <MudTd DataLabel="Recebido">@Money(context.Recebido)</MudTd>
                 <MudTd DataLabel="Custos">@Money(context.Custos)</MudTd>
                 <MudTd DataLabel="Atualização">@context.AtualizadoEm?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(()=>OpenDetail(context))" aria-label="@($"Editar andamento de {context.Codigo}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.ManageAccounts" OnClick="@(async () => await _servicoForm.Open(context.Codigo))" Color="Color.Primary" aria-label="@($"Editar cadastro completo de {context.Codigo}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Href="@($"/api/acompanhamentos/{context.Id}/relatorio")" Target="_blank" aria-label="@($"Relatório de {context.Codigo}")" /></MudTd>
            </RowTemplate>
            <NoRecordsContent><EmptyState Title="Nenhum acompanhamento" Message="Importe serviços ou ajuste os filtros." /></NoRecordsContent>
        </MudTable>
        </div>
        </ChildContent>
        </SmartTableFilter>
    </MudPaper>
</GlobalSkeleton>

<ServicoForm @ref="_servicoForm" OnSaved="OnServicoSalvoAsync" />

<MudDrawer @bind-Open="_detailOpen" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Width="min(720px, 100vw)" Elevation="8">
    @if (_selected is not null)
    {
        <div class="pa-5">
            <MudToolBar Class="pa-0 mb-3">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h5">@_selected.Codigo</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_selected.Cliente</MudText>
                </MudStack>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(()=>_detailOpen=false)" aria-label="Fechar" />
            </MudToolBar>
            <MudButton OnClick="@(async () => await _servicoForm.Open(_selected.Codigo))"
                       Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.EditNote" Class="mb-4">
                Editar cadastro completo
            </MudButton>
            <MudDivider Class="mb-4" />
            <MudPaper Outlined="true" Class="pa-4 mt-4">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6"><MudText Typo="Typo.caption" Color="Color.Secondary">CPF / CNPJ</MudText><MudText Typo="Typo.body2">@(_selected.CnpjCpf??"—")</MudText></MudItem>
                    <MudItem xs="12" sm="6"><MudText Typo="Typo.caption" Color="Color.Secondary">Endereço</MudText><MudText Typo="Typo.body2">@(_selected.Endereco??"—")</MudText></MudItem>
                    <MudItem xs="12" sm="6"><MudText Typo="Typo.caption" Color="Color.Secondary">Telefone</MudText><MudText Typo="Typo.body2">@(_selected.Telefone??"—")</MudText></MudItem>
                    <MudItem xs="12" sm="6"><MudText Typo="Typo.caption" Color="Color.Secondary">Serviço</MudText><MudText Typo="Typo.body2">@(_selected.Servico??"—")</MudText></MudItem>
                    <MudItem xs="12" sm="6"><MudText Typo="Typo.caption" Color="Color.Secondary">Condição de pagamento</MudText><MudText Typo="Typo.body2">@(_selected.CondicaoPagamento??"—")</MudText></MudItem>
                     <MudItem xs="12" sm="6"><MudText Typo="Typo.caption" Color="Color.Secondary">R$ Contrato</MudText><MudText Typo="Typo.body2">@(_selected.ValorContrato?.ToString("C",new System.Globalization.CultureInfo("pt-BR"))??"—")</MudText></MudItem>
                     <MudItem xs="12" sm="6"><MudText Typo="Typo.caption" Color="Color.Secondary">Data contrato</MudText><MudText Typo="Typo.body2">@(_selected.DataContrato?.ToString("dd/MM/yyyy")??"—")</MudText></MudItem>
                     <MudItem xs="12" sm="6"><MudText Typo="Typo.caption" Color="Color.Secondary">Prox. parcela</MudText><MudText Typo="Typo.body2">@(_selected.ProximaParcela?.ToString("dd/MM/yyyy")??_selected.ProximaParcelaTexto??"—")</MudText></MudItem>
                     <MudItem xs="12" sm="6"><MudText Typo="Typo.caption" Color="Color.Secondary">Nota fiscal</MudText><MudText Typo="Typo.body2">@(_selected.NotaFiscal??"—")</MudText></MudItem>
                     <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Color="Color.Secondary">A receber</MudText><MudText Typo="Typo.body2">@Money(_selected.AReceber)</MudText></MudItem>
                     <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Recebido</MudText><MudText Typo="Typo.body2">@Money(_selected.Recebido)</MudText></MudItem>
                     <MudItem xs="12" sm="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Custos</MudText><MudText Typo="Typo.body2">@Money(_selected.Custos)</MudText></MudItem>
                </MudGrid>
            </MudPaper>
            <MudGrid Class="mt-4">
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="string" @bind-Value="_newStatus"
                                     Label="Nova situação" Variant="Variant.Outlined"
                                     SearchFunc="SearchStatusesAsync"
                                     CoerceText="true" CoerceValue="true"
                                     Clearable="true"
                                     HelperText="Selecione uma opção ou digite uma nova situação." />
                </MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_actor" Label="Responsável" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_statusNote" Label="Observação da mudança" Variant="Variant.Outlined" Lines="2" /></MudItem>
                <MudItem xs="12"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ChangeStatusAsync">Atualizar situação</MudButton></MudItem>
            </MudGrid>
            <MudDivider Class="my-5" />
            <MudText Typo="Typo.h6">Pendências</MudText>
            @if (_selected.Itens.Count==0){<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">Nenhuma pendência para a situação atual.</MudAlert>}
            else
            {
                <MudList T="string">@foreach(var item in _selected.Itens){<MudListItem><MudCheckBox T="bool" Value="@item.Concluida" ValueChanged="@((bool value)=>TogglePendingAsync(item.Id,value))" Label="@item.Label" Color="Color.Success" /></MudListItem>}</MudList>
            }
            <MudDivider Class="my-5" />
            <MudText Typo="Typo.h6">Histórico</MudText>
            <MudTimeline TimelinePosition="TimelinePosition.Start" Class="mt-3">
                @foreach(var history in _selected.Historicos)
                {
                    <MudTimelineItem Color="Color.Primary" Variant="Variant.Outlined">
                        <MudText Typo="Typo.subtitle2">@history.Nova</MudText>
                        <MudText Typo="Typo.body2">@history.Descricao</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@history.Em.ToLocalTime().ToString("dd/MM/yyyy HH:mm") • @history.Responsavel</MudText>
                    </MudTimelineItem>
                }
            </MudTimeline>
        </div>
    }
</MudDrawer>

<MudDrawer @bind-Open="_settingsOpen" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Width="min(620px,100vw)" Elevation="8">
    <div class="pa-5">
        <MudToolBar Class="pa-0 mb-3">
            <MudText Typo="Typo.h5">Configurar situações</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(()=>_settingsOpen=false)" />
        </MudToolBar>
        <MudDivider Class="mb-4" />
        <MudGrid>
            <MudItem xs="12" sm="6"><MudSelect T="AcompanhamentoServicoTipo" @bind-Value="_config.Tipo" Label="Tipo" Variant="Variant.Outlined">@foreach(var type in Enum.GetValues<AcompanhamentoServicoTipo>()){<MudSelectItem Value="@type">@TypeLabel(type)</MudSelectItem>}</MudSelect></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_config.Nome" Label="Nome" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="4"><MudNumericField T="int" @bind-Value="_config.Ordem" Label="Ordem" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6" sm="4"><MudSwitch T="bool" @bind-Value="_config.Inicial" Label="Inicial" /></MudItem><MudItem xs="6" sm="4"><MudSwitch T="bool" @bind-Value="_config.Ativo" Label="Ativa" /></MudItem>
            <MudItem xs="12">
                <MudColorPicker @bind-Text="_config.Cor" Label="Cor da situação" Variant="Variant.Outlined"
                                PickerVariant="PickerVariant.Inline" ColorPickerView="ColorPickerView.Grid"
                                ColorPickerMode="ColorPickerMode.HEX" ShowAlpha="false" ShowModeSwitch="false"
                                Clearable="true" HelperText="Escolha uma cor para identificar rapidamente esta situação." />
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_pendingLabels" Label="Pendências automáticas" HelperText="Uma por linha" Lines="5" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSituationAsync">Salvar situação</MudButton></MudItem>
        </MudGrid>
        <MudDivider Class="my-5" />
        <MudList T="string">@foreach(var item in _situations){<MudListItem OnClick="@(()=>EditSituation(item))"><MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="w-100"><MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"><span class="atlas-color-dot" style="background:@SituationColor(item.Tipo,item.Nome,item.Cor)"></span><MudText Typo="Typo.body2">@TypeLabel(item.Tipo) • @item.Nome</MudText></MudStack><MudChip T="string" Size="Size.Small">@(item.Pendencias.Count) pendência(s)</MudChip></MudStack></MudListItem>}</MudList>
    </div>
</MudDrawer>

<MudDrawer @bind-Open="_importOpen" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" Width="min(820px,100vw)" Elevation="8">
    <div class="atlas-import-drawer position-relative">
        <ImportingAnimationOverlay IsVisible="_importing" Title="Importando dados" Subtitle="Aguarde enquanto os dados são gravados com segurança." />

        <div class="atlas-import-header pa-5 pb-3">
            <MudToolBar Class="pa-0">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h5">Importação em lote</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Selecione, valide e confirme a planilha.</MudText>
                </MudStack>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseImportDrawer" Disabled="@(_importing || _parsingImport)" />
            </MudToolBar>
        </div>

        <div class="atlas-import-content px-5 pb-5">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                 No XLSX ou XLSB, uma única confirmação preenche Clientes, Serviços, Acompanhamento, Lançamentos e Custos Indiretos. As abas AVCB, CLCB, OBRAS, PROCESSOS ADM, LANÇAMENTOS e CUSTOS INDIRETOS são vinculadas pelo código.
            </MudAlert>

            <MudFileUpload T="IBrowserFile"
                           FilesChanged="ParseImportAsync"
                             Accept=".xlsx,.xlsb,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel.sheet.binary.macroEnabled.12,text/csv"
                           MaxFileSize="@(100L * 1024 * 1024)"
                           MaximumFileCount="1"
                           DragAndDrop="true"
                           Disabled="@(_importing || _parsingImport)">
                <CustomContent>
                    <MudPaper Outlined="true" Class="atlas-upload-zone pa-5" @onclick="context.OpenFilePickerAsync">
                        <MudStack AlignItems="AlignItems.Center" Spacing="1">
                            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Large">
                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" />
                            </MudAvatar>
                            <MudText Typo="Typo.subtitle1" Align="Align.Center">Arraste a planilha aqui ou clique para selecionar</MudText>
                             <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">XLSX, XLSB ou CSV • tamanho máximo de 100 MB</MudText>
                        </MudStack>
                    </MudPaper>
                </CustomContent>
            </MudFileUpload>

            @if (_parsingImport)
            {
                <MudPaper Outlined="true" Class="pa-4 mt-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle2">Lendo e validando a planilha...</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Arquivos maiores podem levar alguns instantes.</MudText>
                        </MudStack>
                    </MudStack>
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
                </MudPaper>
            }
            else if (!string.IsNullOrWhiteSpace(_uploadedFileName))
            {
                <MudPaper Outlined="true" Class="pa-3 mt-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudAvatar Color="Color.Success" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Description" />
                        </MudAvatar>
                        <MudStack Spacing="0" Class="atlas-file-info">
                            <MudText Typo="Typo.subtitle2">@_uploadedFileName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatFileSize(_uploadedFileSize) • @_preview.Count linha(s) localizada(s)</MudText>
                        </MudStack>
                        <MudSpacer />
                        <MudTooltip Text="Remover arquivo">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="ClearImportFile" />
                        </MudTooltip>
                    </MudStack>
                </MudPaper>
            }

            @if (_preview.Count > 0)
            {
                var invalidCount = _preview.Count(x => !x.Valid);
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-5 mb-2" Spacing="1">
                    <MudText Typo="Typo.h6">Pré-visualização</MudText>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@(_preview.Count - invalidCount) válida(s)</MudChip>
                    @if (invalidCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">@invalidCount com erro</MudChip>
                    }
                </MudStack>
                <MudTable Items="_preview" Dense="true" Hover="true" FixedHeader="true" Height="min(42vh, 420px)" Breakpoint="Breakpoint.Sm" Class="atlas-import-preview">
                     <HeaderContent><MudTh>Linha</MudTh><MudTh>Código</MudTh><MudTh>Tipo</MudTh><MudTh>Situação</MudTh><MudTh>Cliente</MudTh><MudTh>Validação</MudTh></HeaderContent>
                     <RowTemplate><MudTd DataLabel="Linha">@context.Line</MudTd><MudTd DataLabel="Código">@context.Code</MudTd><MudTd DataLabel="Tipo">@context.Type</MudTd><MudTd DataLabel="Situação">@(context.Dto?.Situacao ?? "—")</MudTd><MudTd DataLabel="Cliente">@context.Client</MudTd><MudTd DataLabel="Validação"><MudChip T="string" Size="Size.Small" Color="@(context.Valid ? Color.Success : Color.Error)">@(context.Valid ? "Válida" : context.Error)</MudChip></MudTd></RowTemplate>
                </MudTable>
            }
        </div>

        <div class="atlas-import-footer pa-4 px-5">
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton OnClick="CloseImportDrawer" Disabled="@(_importing || _parsingImport)">Cancelar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CheckCircle" Disabled="@(_preview.Count == 0 || _preview.Any(x => !x.Valid) || _importing || _parsingImport)" OnClick="ConfirmImportAsync">Confirmar importação</MudButton>
            </MudStack>
        </div>
    </div>
</MudDrawer>

<style>
