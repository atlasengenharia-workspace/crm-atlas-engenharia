@code {
    private List<AcompanhamentoDto> _items=[]; private List<SituacaoConfigDto> _situations=[]; private List<ImportRow> _preview=[];
    private readonly IReadOnlyList<SmartFilterColumn<AcompanhamentoDto>> _filterColumns =
    [
        new("codigo","Código",x=>x.Codigo,1), new("cliente","Cliente",x=>x.Cliente,2),
        new("endereco","Endereço",x=>x.Endereco,3), new("telefone","Telefone",x=>x.Telefone,4),
        new("servico","Serviço",x=>x.Servico,5), new("valorContrato","R$ Contrato",x=>x.ValorContrato,6),
        new("dataContrato","Data Contrato",x=>x.DataContrato,7), new("nf","NF",x=>x.NotaFiscal,8),
        new("condicaoPagamento","Condição pag.",x=>x.CondicaoPagamento,9),
        new("proximaParcela","Prox. Parcela",x=>x.ProximaParcela,10),
        new("situacao","Situação",x=>x.Situacao,11), new("observacoes","Observações",x=>x.Descricao,12),
        new("observacaoMudanca","Observação da mudança",x=>x.ObservacaoMudanca,13),
        new("areceber","A receber",x=>x.AReceber,14), new("recebido","Recebido",x=>x.Recebido,15),
        new("custos","Custos",x=>x.Custos,15), new("atualizacao","Atualização",x=>x.AtualizadoEm?.ToLocalTime(),16)
    ];
    private AcompanhamentoDto? _selected; private SituationModel _config=new(); private bool _loading,_detailOpen,_settingsOpen,_importOpen,_importing,_parsingImport;
    private bool _hideCompleted=true;
    private string? _search,_newStatus,_statusNote,_actor,_pendingLabels,_uploadedFileName;
    private byte[]? _uploadedFileBytes;
    private long _uploadedFileSize;
    private AcompanhamentoServicoTipo? _tipoFiltro;
    private ServicoForm _servicoForm = default!;
    private long? _editStatusId,_editDescId;
    private string? _editingSituacao,_editingDescricao;
    private readonly HashSet<long> _selectedIds = [];
    private string? _bulkSituacao,_bulkDescricao;
    private bool _bulkApplying;
    private readonly Dictionary<string, HashSet<string>> _columnFilters = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _hiddenColumns = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _pinnedColumns = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, Func<AcompanhamentoDto, object?>> _columnValueGetters = new(StringComparer.OrdinalIgnoreCase)
    {
        ["codigo"] = x => x.Codigo,
        ["cliente"] = x => x.Cliente,
        ["endereco"] = x => x.Endereco,
        ["telefone"] = x => x.Telefone,
        ["tipo"] = x => TypeLabel(x.Tipo),
        ["valorContrato"] = x => Money(x.ValorContrato),
        ["dataContrato"] = x => x.DataContrato?.ToString("dd/MM/yyyy"),
        ["nf"] = x => x.NotaFiscal,
        ["condicaoPagamento"] = x => x.CondicaoPagamento,
        ["proximaParcela"] = x => x.ProximaParcela?.ToString("dd/MM/yyyy") ?? x.ProximaParcelaTexto,
        ["situacao"] = x => x.Situacao,
        ["observacoes"] = x => x.Descricao,
        ["observacaoMudanca"] = x => x.ObservacaoMudanca,
        ["areceber"] = x => Money(x.AReceber),
        ["recebido"] = x => Money(x.Recebido),
        ["custos"] = x => Money(x.Custos),
        ["atualizacao"] = x => x.AtualizadoEm?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
    };
    private IReadOnlySet<string> GetColumnFilter(string key) => _columnFilters.TryGetValue(key, out var values) ? values : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private void OnColumnFilterChanged(string key, IReadOnlySet<string> values)
    {
        if (values.Count == 0) _columnFilters.Remove(key);
        else _columnFilters[key] = [.. values];
    }
    private void OnHiddenColumnsChanged(IReadOnlySet<string> hidden)
    {
        _hiddenColumns.Clear();
        foreach (var key in hidden) _hiddenColumns.Add(key);
    }
    private void ToggleHiddenColumn(string key)
    {
        if (!_hiddenColumns.Add(key)) _hiddenColumns.Remove(key);
    }
    private void TogglePinColumn(string key)
    {
        if (!_pinnedColumns.Add(key)) _pinnedColumns.Remove(key);
    }
    private IEnumerable<AcompanhamentoDto> Filtered=>_items
        .Where(x=>_tipoFiltro is null||x.Tipo==_tipoFiltro)
        .Where(x=>!_hideCompleted||!IsCompleted(x.Situacao))
        .Where(x=>string.IsNullOrWhiteSpace(_search)||$"{x.Codigo} {x.Cliente} {x.CnpjCpf} {x.Endereco} {x.Telefone} {x.Servico} {x.Situacao} {x.Descricao} {x.ObservacaoMudanca} {x.ValorContrato} {x.ProximaParcela} {x.ProximaParcelaTexto}".Contains(_search,StringComparison.OrdinalIgnoreCase))
        .Where(x=>_columnFilters.All(f=>!_columnValueGetters.TryGetValue(f.Key,out var getter)||f.Value.Count==0||f.Value.Contains(Text(getter(x)))));
    private static bool IsCompleted(string? status) =>
        !string.IsNullOrEmpty(status) &&
        (status!.StartsWith("Concluído", StringComparison.OrdinalIgnoreCase) ||
         status!.StartsWith("Concluido", StringComparison.OrdinalIgnoreCase));
    private static Color StatusColor(string? status)
    {
        var value=status??"";
        if(value.Contains("conclu",StringComparison.OrdinalIgnoreCase))return Color.Success;
        if(value.Contains("aguard",StringComparison.OrdinalIgnoreCase))return Color.Warning;
        if(value.Contains("comunic",StringComparison.OrdinalIgnoreCase)||value.Contains("reprov",StringComparison.OrdinalIgnoreCase))return Color.Error;
        if(value.Contains("vistoria",StringComparison.OrdinalIgnoreCase)||value.Contains("protoc",StringComparison.OrdinalIgnoreCase))return Color.Secondary;
        return Color.Info;
    }
    protected override async Task OnInitializedAsync()=>await LoadAsync();
    private async Task LoadAsync(){_loading=true;try{_items=(await Service.ListAsync()).ToList();_situations=(await Service.ListSituationsAsync()).ToList();}catch(Exception e){Snackbar.Add(e.Message,Severity.Error);}finally{_loading=false;}}
    private void OpenDetail(AcompanhamentoDto item){_selected=item;_newStatus=item.Situacao;_detailOpen=true;}
    private async Task AbrirFormularioNovo()=>await _servicoForm.Open();
    private async Task OnServicoSalvoAsync()=>await LoadAsync();
    private void StartEditSituacao(AcompanhamentoDto item){_editStatusId=item.Id;_editingSituacao=item.Situacao;_editDescId=null;}
    private async Task SaveSituacaoAsync(AcompanhamentoDto item,string status)
    {
        if(string.Equals(item.Situacao,status,StringComparison.OrdinalIgnoreCase)){_editStatusId=null;return;}
        try{await Service.ChangeStatusAsync(item.Id,status,null,null);Snackbar.Add("Situação atualizada.",Severity.Success);await LoadAsync();}
        catch(Exception e){Snackbar.Add(e.Message,Severity.Error);}
        finally{_editStatusId=null;}
    }
    private void StartEditDescricao(AcompanhamentoDto item){_editDescId=item.Id;_editingDescricao=item.Descricao;_editStatusId=null;}
    private async Task SaveDescricaoAsync(AcompanhamentoDto item)
    {
        if(string.Equals(item.Descricao,_editingDescricao,StringComparison.OrdinalIgnoreCase)){_editDescId=null;return;}
        try{await Service.UpdateDescricaoAsync(item.Id,_editingDescricao);Snackbar.Add("Observação atualizada.",Severity.Success);await LoadAsync();}
        catch(Exception e){Snackbar.Add(e.Message,Severity.Error);}
        finally{_editDescId=null;}
    }
    private IEnumerable<string> StatusesFor(AcompanhamentoServicoTipo tipo)=>
        _situations.Where(x=>x.Tipo==tipo&&x.Ativo).Select(x=>x.Nome)
            .Concat(_items.Where(x=>x.Tipo==tipo).Select(x=>x.Situacao))
            .Concat(DefaultStatuses(tipo))
            .Where(x=>!string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x=>x);
    private void ToggleSelect(AcompanhamentoDto item,bool selected){if(selected)_selectedIds.Add(item.Id);else _selectedIds.Remove(item.Id);}
    private void ToggleSelectAll(IEnumerable<AcompanhamentoDto> items,bool selected)
    {
        foreach(var item in items)
            if(selected)_selectedIds.Add(item.Id);else _selectedIds.Remove(item.Id);
    }
    private async Task AplicarBulkAsync()
    {
        if(_selectedIds.Count==0)return;
        _bulkApplying=true;
        try
        {
            await Service.BulkUpdateAsync(_selectedIds.ToList(),_bulkSituacao,_bulkDescricao,null);
            Snackbar.Add("Atualização em massa aplicada.",Severity.Success);
            _selectedIds.Clear();
            _bulkSituacao=null;
            _bulkDescricao=null;
            await LoadAsync();
        }
        catch(Exception e){Snackbar.Add(e.Message,Severity.Error);}
        finally{_bulkApplying=false;}
    }
    private async Task ExportarExcelAsync()=>await JS.InvokeVoidAsync("downloadUrl","/api/acompanhamentos/export/excel","acompanhamentos.xlsx");
    private Task<IEnumerable<string>> SearchStatusesAsync(string value,CancellationToken cancellationToken)
    {
        if(_selected is null)return Task.FromResult(Enumerable.Empty<string>());
        var statuses=_situations.Where(x=>x.Tipo==_selected.Tipo&&x.Ativo).Select(x=>x.Nome)
            .Concat(_items.Where(x=>x.Tipo==_selected.Tipo).Select(x=>x.Situacao))
            .Concat(DefaultStatuses(_selected.Tipo))
            .Where(x=>!string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(x=>string.IsNullOrWhiteSpace(value)||x.Contains(value,StringComparison.OrdinalIgnoreCase))
            .OrderBy(x=>x)
            .AsEnumerable();
        return Task.FromResult(statuses);
    }
    private static IEnumerable<string> DefaultStatuses(AcompanhamentoServicoTipo type) => type == AcompanhamentoServicoTipo.AVCB
        ? ["Aguar. Contratante", "Aguar. Documentos", "Comunicado", "Concluído", "Concluído - Aguar. Pag.", "Em análise", "Executar"]
        : ["Em análise", "Em andamento", "Aguardando cliente", "Aguardando documentos", "Aguardando vistoria", "Concluído", "Cancelado"];
    private async Task RefreshSelected(){if(_selected is null)return;_selected=await Service.GetAsync(_selected.Id);_items=(await Service.ListAsync()).ToList();}
    private async Task ChangeStatusAsync(){if(_selected is null||string.IsNullOrWhiteSpace(_newStatus))return;await Service.ChangeStatusAsync(_selected.Id,_newStatus,_statusNote,_actor);Snackbar.Add("Situação atualizada.",Severity.Success);await RefreshSelected();}
    private async Task TogglePendingAsync(long id,bool value){if(_selected is null)return;await Service.TogglePendingAsync(_selected.Id,id,value);await RefreshSelected();}
    private void OpenSettings(){_config=new(){Tipo=_tipoFiltro??AcompanhamentoServicoTipo.AVCB,Ativo=true,Cor="#BFDBFE"};_pendingLabels="";_settingsOpen=true;}
    private void EditSituation(SituacaoConfigDto item){_config=SituationModel.From(item);_pendingLabels=string.Join(Environment.NewLine,item.Pendencias);}
    private async Task SaveSituationAsync(){var dto=_config.ToDto((_pendingLabels??"").Split(['\r','\n'],StringSplitOptions.RemoveEmptyEntries));await Service.SaveSituationAsync(dto);Snackbar.Add("Situação salva.",Severity.Success);_situations=(await Service.ListSituationsAsync()).ToList();}
    private async Task ParseImportAsync(IBrowserFile? file)
    {
        if (file is null) return;
        ClearImportFile();
        _parsingImport = true;
        try
        {
            var extension = Path.GetExtension(file.Name);
             if (!string.Equals(extension, ".xlsx", StringComparison.OrdinalIgnoreCase) &&
                 !string.Equals(extension, ".xlsb", StringComparison.OrdinalIgnoreCase) &&
                 !string.Equals(extension, ".csv", StringComparison.OrdinalIgnoreCase))
                 throw new InvalidOperationException("Selecione uma planilha no formato XLSX, XLSB ou CSV.");

            await using var upload = file.OpenReadStream(100 * 1024 * 1024);
            await using var buffer = new MemoryStream();
            await upload.CopyToAsync(buffer);
            _uploadedFileBytes = buffer.ToArray();
            _uploadedFileName = file.Name;
            _uploadedFileSize = file.Size;
            await using var readStream = new MemoryStream(_uploadedFileBytes, false);
            var rows = await SpreadsheetReader.ReadAsync(readStream, file.Name, _tipoFiltro);
            _preview = rows.Select(x => new ImportRow(x.Linha, x.Codigo, x.Tipo, x.Cliente ?? "", x.Valido, x.Erro, x.Item)).ToList();
            Snackbar.Add($"{_preview.Count} linha(s) carregada(s) para validação.", Severity.Info);
        }
        catch (Exception ex)
        {
            ClearImportFile();
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _parsingImport = false; }
    }
     private async Task ConfirmImportAsync(){_importing=true;try{var extension=Path.GetExtension(_uploadedFileName);if(_uploadedFileBytes is not null&&(string.Equals(extension,".xlsx",StringComparison.OrdinalIgnoreCase)||string.Equals(extension,".xlsb",StringComparison.OrdinalIgnoreCase))){await using var stream=new MemoryStream(_uploadedFileBytes,false);var result=await WorkbookImportService.ImportAsync(stream,_uploadedFileName!);Snackbar.Add($"Importação concluída: {result.ClientesCriados} clientes, {result.CondicoesPagamentoCriadas} condições, {result.ServicosCriados} serviços, {result.AcompanhamentosCriados} acompanhamentos, {result.LancamentosCriados} lançamentos e {result.CustosIndiretosCriados} custos.",Severity.Success);}else{await Service.ImportAsync(_preview.Select(x=>x.Dto!).ToList());Snackbar.Add($"{_preview.Count} serviço(s) importado(s).",Severity.Success);}_preview.Clear();_uploadedFileBytes=null;_uploadedFileName=null;_importOpen=false;await LoadAsync();}catch(Exception e){Snackbar.Add(ImportErrorMessage(e),Severity.Error);}finally{_importing=false;}}
    private void ClearImportFile(){_preview.Clear();_uploadedFileBytes=null;_uploadedFileName=null;_uploadedFileSize=0;}
    private void CloseImportDrawer(){if(_importing||_parsingImport)return;ClearImportFile();_importOpen=false;}
     private static string FormatFileSize(long bytes)=>bytes switch{>=1024L*1024L=>$"{bytes/(1024d*1024d):N1} MB",>=1024=>$"{bytes/1024d:N1} KB",_=>$"{bytes} bytes"};
     private static string Money(decimal? value)=>value?.ToString("C2",new System.Globalization.CultureInfo("pt-BR"))??"—";
    private static string Text(object? value)=>value?.ToString()?.Trim()??"";
     private static string ImportErrorMessage(Exception exception){var root=exception.GetBaseException();return root==exception?exception.Message:$"{exception.Message} Causa: {root.Message}";}
    private static string TypeLabel(AcompanhamentoServicoTipo t)=>t switch{AcompanhamentoServicoTipo.PROCESSOS_ADM=>"Processos administrativos",AcompanhamentoServicoTipo.OBRAS=>"Obras",_=>t.ToString()};
    private static Color TypeColor(AcompanhamentoServicoTipo t)=>t switch{AcompanhamentoServicoTipo.AVCB=>Color.Error,AcompanhamentoServicoTipo.CLCB=>Color.Warning,AcompanhamentoServicoTipo.OBRAS=>Color.Info,_=>Color.Secondary};
    private string SituationStyle(AcompanhamentoDto item){var color=SituationColor(item.Tipo,item.Situacao);return $"background:{color};color:{ContrastColor(color)}";}
    private string SituationColor(AcompanhamentoServicoTipo type,string status,string? configured=null)=>configured??_situations.FirstOrDefault(x=>x.Tipo==type&&x.Nome.Equals(status,StringComparison.OrdinalIgnoreCase))?.Cor??DefaultSituationColor(status);
    private static string DefaultSituationColor(string? status){var value=status??"";if(value.Contains("contrat",StringComparison.OrdinalIgnoreCase))return "#FDE68A";if(value.Contains("document",StringComparison.OrdinalIgnoreCase))return "#FDBA74";if(value.Contains("comunic",StringComparison.OrdinalIgnoreCase))return "#FCA5A5";if(value.Contains("conclu",StringComparison.OrdinalIgnoreCase)&&value.Contains("pag",StringComparison.OrdinalIgnoreCase))return "#93C5FD";if(value.Contains("conclu",StringComparison.OrdinalIgnoreCase))return "#86EFAC";if(value.Contains("análise",StringComparison.OrdinalIgnoreCase)||value.Contains("analise",StringComparison.OrdinalIgnoreCase))return "#D1D5DB";if(value.Contains("execut",StringComparison.OrdinalIgnoreCase))return "#C4B5FD";if(value.Contains("vistoria",StringComparison.OrdinalIgnoreCase))return "#67E8F9";if(value.Contains("agend",StringComparison.OrdinalIgnoreCase))return "#C7D2FE";return "#BFDBFE";}
    private static string ContrastColor(string color){if(color.Length!=7||!int.TryParse(color[1..3],System.Globalization.NumberStyles.HexNumber,null,out var r)||!int.TryParse(color[3..5],System.Globalization.NumberStyles.HexNumber,null,out var g)||!int.TryParse(color[5..7],System.Globalization.NumberStyles.HexNumber,null,out var b))return "#0F172A";return (r*299+g*587+b*114)/1000>=150?"#0F172A":"#FFFFFF";}
    private sealed record ImportRow(int Line,string Code,string Type,string Client,bool Valid,string? Error,AcompanhamentoImportDto? Dto);
    private sealed class SituationModel{public long? Id{get;set;}public AcompanhamentoServicoTipo Tipo{get;set;}public string Nome{get;set;}="";public string? Cor{get;set;}="#BFDBFE";public int Ordem{get;set;}public bool Inicial{get;set;}public bool Ativo{get;set;}=true;public static SituationModel From(SituacaoConfigDto x)=>new(){Id=x.Id,Tipo=x.Tipo,Nome=x.Nome,Cor=x.Cor??DefaultSituationColor(x.Nome),Ordem=x.Ordem,Inicial=x.Inicial,Ativo=x.Ativo};public SituacaoConfigDto ToDto(IEnumerable<string> p)=>new(Id,Tipo,Nome,Ordem,Inicial,Ativo,p.ToList(),Cor);}
