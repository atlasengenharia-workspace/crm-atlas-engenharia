    private void BuildCharts(DashboardSnapshot data)
    {
        _periodLabels = data.Periods.Select(x => x.Label).ToArray();
        _financialSeries =
        [
            new() { Name = "Faturamento", Data = data.Periods.Select(x => (double)x.Revenue).ToArray() },
            new() { Name = "Custos diretos", Data = data.Periods.Select(x => (double)x.DirectCosts).ToArray() },
            new() { Name = "Custos indiretos", Data = data.Periods.Select(x => (double)x.IndirectCosts).ToArray() },
            new() { Name = "Resultado", Data = data.Periods.Select(x => (double)x.Result).ToArray() }
        ];

        (_revenueLabels, _revenueSeries) = Donut(data.RevenueByService);
        (_contractLabels, _contractSeries) = Bars("Contratos", data.ContractsByService);
        (_costLabels, _costSeries) = Donut(data.IndirectCostsByCategory);
    }

    private static (string[], List<ChartSeries<double>>) Donut(IReadOnlyList<DashboardBreakdownPoint> data) =>
        (data.Select(x => x.Label).ToArray(),
         data.Count == 0 ? [] : [new() { Name = "Valor", Data = data.Select(x => (double)x.Value).ToArray() }]);

    private static (string[], List<ChartSeries<double>>) Bars(string name, IReadOnlyList<DashboardBreakdownPoint> data) =>
        (data.Select(x => x.Label).ToArray(),
         data.Count == 0 ? [] : [new() { Name = name, Data = data.Select(x => (double)x.Value).ToArray() }]);

    private static Color AgeColor(int days) => days switch
    {
        <= 30 => Color.Success,
        <= 90 => Color.Warning,
        <= 180 => Color.Error,
        _ => Color.Dark
    };

    private string Money(decimal value) => _hideValues ? "R$ ••••••" : value.ToString("C0", PtBr);

    private string FmtCompactMoney(decimal val)
    {
        if (_hideValues) return "R$ ••••••";
        if (val == 0) return "R$ 0,00";
        var abs = Math.Abs(val);
        if (abs >= 1_000_000m)
            return $"R$ {(val / 1_000_000m):N2} Mi";
        if (abs >= 1_000m)
            return $"R$ {(val / 1_000m):N2} mil";
        return val.ToString("C2", PtBr);
    }

    private RenderFragment RenderDelta(decimal current, decimal previous) => builder =>
    {
        if (previous == 0)
        {
            builder.AddContent(0, "—");
            return;
        }
        var deltaPct = ((current / previous) - 1m) * 100m;
        var isUp = deltaPct >= 0;
        var arrow = isUp ? "▲" : "▼";
        var colorHex = isUp ? "#1F9D66" : "#C8432F";

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "style", $"font-size: 0.78rem; color: {colorHex}; font-weight: bold; margin-right: 4px;");
        builder.AddContent(2, $"{arrow} {Math.Abs(deltaPct):F1}%");
        builder.CloseElement();

        builder.OpenElement(3, "span");
        builder.AddAttribute(4, "style", "font-size: 0.78rem; color: #718096;");
        builder.AddContent(5, "vs período anterior");
        builder.CloseElement();
    };

    private static readonly HashSet<string> ThirdPartyWaitStatuses = new(StringComparer.OrdinalIgnoreCase)
    {
        "Aguar. contratante",
        "Aguardando contratante",
        "Aguar. documentos",
        "Aguardando documentos",
        "Comunicado"
    };

    private static bool IsConcluded(string? status) =>
        !string.IsNullOrEmpty(status) &&
        (status!.StartsWith("Concluído", StringComparison.OrdinalIgnoreCase) ||
         status!.StartsWith("Concluido", StringComparison.OrdinalIgnoreCase));

    private static bool IsThirdPartyWait(string status) =>
        !string.IsNullOrEmpty(status) && (ThirdPartyWaitStatuses.Contains(status) || status.ToLower().Contains("terceiro"));

    private static (string bg, string color) AgePillStyle(int days) => days switch
    {
        <= 30 => ("#E6F4EA", "#137333"),
        <= 90 => ("#FEF7E0", "#B06000"),
        <= 180 => ("#FFE8D6", "#C5221F"),
        _ => ("#FCE8E6", "#C5221F")
    };

