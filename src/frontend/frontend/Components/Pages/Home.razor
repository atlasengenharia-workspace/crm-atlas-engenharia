@code {
    private static readonly System.Globalization.CultureInfo PtBr = new("pt-BR");
    private readonly SemaphoreSlim _dashboardLoadGate = new(1, 1);
    private bool _loading = true;
    private bool _hideValues;
    private int _activeTabIndex;
    private bool _chartsNeedRender;
    private bool _renderingCharts;

    private DateTime? _startDate;
    private DateTime? _endDate;

    private decimal? _minContract;
    private decimal? _maxContract;
    private bool _includeProLabore = true;
    private DashboardGranularity _granularity = DashboardGranularity.Mes;
    private bool _qtdByPeriod = true;

    private readonly HashSet<AcompanhamentoServicoTipo> _activeLines = [
        AcompanhamentoServicoTipo.AVCB,
        AcompanhamentoServicoTipo.CLCB,
        AcompanhamentoServicoTipo.PROCESSOS_ADM,
        AcompanhamentoServicoTipo.OBRAS
    ];

    private string? _selectedStatusFilter;
    private string _prioritySearch = string.Empty;
    private readonly IReadOnlyList<SmartFilterColumn<DashboardPriorityItem>> _priorityColumns =
    [
        new("codigo", "Código", x => x.Code, 1), new("dias", "Em aberto há", x => x.DaysInStatus, 2),
        new("cliente", "Cliente", x => x.Client, 3), new("servico", "Serviço", x => ServiceLabel(x.ServiceType), 4),
        new("situacao", "Situação", x => x.Status, 5), new("cidade", "Cidade", x => x.City, 6),
        new("contrato", "Contrato", x => x.ContractValue, 7, true), new("receber", "A receber", x => x.ReceivableValue, 8, true)
    ];
    private readonly IReadOnlyList<SmartFilterColumn<DashboardTopClientItem>> _topClientColumns =
    [
        new("rank", "#", x => x.Rank, 1), new("cliente", "Cliente", x => x.ClientName, 2),
        new("linha", "Linha principal", x => x.PrimaryLine, 3), new("contratado", "Contratado", x => x.TotalContracted, 4),
        new("contratos", "Contratos", x => x.ContractCount, 5), new("receber", "A receber", x => x.Receivable, 6)
    ];

    private DashboardSnapshot? _data;
    private List<ChartSeries<double>> _financialSeries = [], _revenueSeries = [], _contractSeries = [], _costSeries = [];
    private string[] _periodLabels = [], _revenueLabels = [], _contractLabels = [], _costLabels = [];

    protected override Task OnInitializedAsync()
    {
        _startDate = DateTime.Today.AddMonths(-11);
        _endDate = DateTime.Today;
        return LoadAsync();
    }

    private IEnumerable<DashboardPriorityItem> FilteredPriorities =>
        _data?.Priorities.Where(p =>
            (string.IsNullOrEmpty(_selectedStatusFilter)
                ? !IsConcluded(p.Status)
                : p.Status.Equals(_selectedStatusFilter, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_prioritySearch) ||
             p.Code.Contains(_prioritySearch, StringComparison.OrdinalIgnoreCase) ||
             p.Client.Contains(_prioritySearch, StringComparison.OrdinalIgnoreCase) ||
             p.Status.Contains(_prioritySearch, StringComparison.OrdinalIgnoreCase) ||
             (p.City != null && p.City.Contains(_prioritySearch, StringComparison.OrdinalIgnoreCase)))
        ) ?? [];

    private IEnumerable<(string Status, int Count)> StatusGroups =>
        _data?.Priorities.GroupBy(x => x.Status)
            .Select(g => (Status: g.Key, Count: g.Count()))
            .OrderByDescending(x => x.Count)
            .AsEnumerable() ?? Enumerable.Empty<(string Status, int Count)>();

    private async Task OnStartDateChangedAsync(DateTime? date)
    {
        _startDate = date;
        if (!DatesAreValid()) return;
        await LoadAsync();
    }

    private async Task OnEndDateChangedAsync(DateTime? date)
    {
        _endDate = date;
        if (!DatesAreValid()) return;
        await LoadAsync();
    }

    private async Task OnMinContractChangedAsync(decimal? val)
    {
        _minContract = val;
        await LoadAsync();
    }

    private async Task OnMaxContractChangedAsync(decimal? val)
    {
        _maxContract = val;
        await LoadAsync();
    }

    private async Task OnProLaboreChangedAsync(bool include)
    {
        _includeProLabore = include;
        await LoadAsync();
    }

    private async Task OnGranularityChangedAsync(DashboardGranularity value)
    {
        _granularity = value;
        await LoadAsync();
    }

    private async Task ToggleLineAsync(AcompanhamentoServicoTipo type)
    {
        if (_activeLines.Contains(type))
        {
            if (_activeLines.Count > 1) _activeLines.Remove(type);
        }
        else
        {
            _activeLines.Add(type);
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!DatesAreValid()) return;
        await _dashboardLoadGate.WaitAsync();
        _loading = true;
        try
        {
            var start = _startDate.HasValue ? DateOnly.FromDateTime(_startDate.Value) : new DateOnly(2020, 1, 1);
            var end = _endDate.HasValue ? DateOnly.FromDateTime(_endDate.Value) : DateOnly.FromDateTime(DateTime.Today);

            var filter = new DashboardFilter(
                start, end, _activeLines.ToList(), _includeProLabore, _minContract, _maxContract, _granularity);

            _data = await Dashboard.GetAsync(filter);
            BuildCharts(_data);
            _chartsNeedRender = _activeTabIndex == 0;
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Não foi possível carregar o painel executivo: {exception.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            _dashboardLoadGate.Release();
        }
    }

    private bool DatesAreValid()
    {
        if (_startDate.HasValue && _endDate.HasValue && _startDate.Value.Date > _endDate.Value.Date)
        {
            Snackbar.Add("A data inicial não pode ser posterior à data final.", Severity.Warning);
            return false;
        }
        return true;
    }

    private bool _isMasterFullscreen = false;
    private bool _isVendasFullscreen = false;
    private bool _isQtdFullscreen = false;
    private bool _isEvoFullscreen = false;
    private bool _isStackFullscreen = false;
    private bool _isCostEvoFullscreen = false;
    private bool _isCostCatFullscreen = false;
    private bool _isArecFullscreen = false;
    private bool _isContratoFullscreen = false;
    private bool _isDonutFullscreen = false;

