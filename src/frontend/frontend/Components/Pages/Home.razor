        await RenderDonutChartAsync("donutChartCanvas");
    }

    private async Task RenderContratoChartAsync(string canvasId)
    {
        if (_data?.ContractsByService == null || _data.ContractsByService.Count == 0) return;

        var labels = _data.ContractsByService.Select(x => x.Label).ToArray();
        var values = _data.ContractsByService.Select(x => (double)x.Value).ToArray();
        var counts = _data.ContractsByService.Select(x => x.Count).ToArray();

        for (int attempt = 0; attempt < 5; attempt++)
        {
            try
            {
                var success = await JS.InvokeAsync<bool>(
                    "dashboardCharts.renderContratoChart", canvasId, labels, values, counts);
                if (success) break;
            }
            catch { }
            await Task.Delay(100);
        }
    }

