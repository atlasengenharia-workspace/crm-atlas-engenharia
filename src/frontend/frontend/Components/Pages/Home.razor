    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_activeTabIndex != 0 || _data is null || _loading || !_chartsNeedRender || _renderingCharts) return;

        _chartsNeedRender = false;
        _renderingCharts = true;
        try { await RenderAllChartsAsync(); }
        finally { _renderingCharts = false; }
    }

