@page "/"
@attribute [Authorize]
@using CrmAtlas.ApplicationCore.Dashboard
@inject IDashboardQueryService Dashboard
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Painel Executivo | CRM Atlas</PageTitle>

<PageHeader Title="Painel executivo" Subtitle="Visão geral financeira e gerencial baseada em dados em tempo real.">
    <Actions>
        <ValuesVisibilityToggle @bind-Hidden="_hideValues" />
        <MudButton Href="/acompanhamento" Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add">Novo serviço</MudButton>
    </Actions>
</PageHeader>

<!-- NAVEGAÇÃO DE ABAS & BARRA DE FILTROS GLOBAIS -->
<MudPaper Outlined="true" Class="pa-4 mb-5 atlas-enter">
    <MudStack Spacing="3">
        <!-- SELETOR DE ABAS E ALTERNADOR PRÓ-LABORE -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="gap-3">
            <div class="d-inline-flex pa-1 rounded-lg border" style="background: var(--mud-palette-background-grey);">
                <MudButton Size="Size.Small" Variant="@(_activeTabIndex == 0 ? Variant.Filled : Variant.Text)"
                           Color="@(_activeTabIndex == 0 ? Color.Primary : Color.Default)"
                           StartIcon="@Icons.Material.Filled.AttachMoney"
                           OnClick="SelectFinanceiroTabAsync" Class="px-4 font-weight-bold">
                    FINANCEIRO
                </MudButton>
                <MudButton Size="Size.Small" Variant="@(_activeTabIndex == 1 ? Variant.Filled : Variant.Text)"
                           Color="@(_activeTabIndex == 1 ? Color.Primary : Color.Default)"
                           StartIcon="@Icons.Material.Filled.Assessment"
                           OnClick="SelectGerencialTab" Class="px-4 font-weight-bold">
                    GERENCIAL
                </MudButton>
            </div>

            <MudCheckBox T="bool" Value="_includeProLabore" ValueChanged="OnProLaboreChangedAsync"
                         Label="Pró-labore nos custos" Color="Color.Primary" Dense="true" Class="my-0" />
        </MudStack>

        <MudDivider />

        <!-- FILTROS DE PERÍODO, DATAS E VALORES -->
        <MudGrid Spacing="2" Style="flex-wrap: nowrap; overflow-x: auto; align-items: flex-end;">
            <MudItem xs="6" sm="3" lg="2">
                <MudDatePicker Date="_startDate" DateChanged="OnStartDateChangedAsync" Label="Data inicial" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6" sm="3" lg="2">
                <MudDatePicker Date="_endDate" DateChanged="OnEndDateChangedAsync" Label="Data final" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="6" sm="3" lg="2">
                <MudNumericField T="decimal?" Value="_minContract" ValueChanged="OnMinContractChangedAsync" Label="Valor mín. (R$)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" Clearable="true" HideSpinButtons="true" />
            </MudItem>
            <MudItem xs="6" sm="3" lg="2">
                <MudNumericField T="decimal?" Value="_maxContract" ValueChanged="OnMaxContractChangedAsync" Label="Valor máx. (R$)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" Clearable="true" HideSpinButtons="true" />
            </MudItem>

            <MudItem xs="6" sm="3" lg="2">
                <MudSelect T="DashboardGranularity" Value="_granularity" ValueChanged="OnGranularityChangedAsync" Label="Agrupar por" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" FullWidth="true">
                    <MudSelectItem Value="@(DashboardGranularity.Semana)">Semana</MudSelectItem>
                    <MudSelectItem Value="@(DashboardGranularity.Mes)">Mês</MudSelectItem>
                    <MudSelectItem Value="@(DashboardGranularity.Trimestre)">Trimestre</MudSelectItem>
                    <MudSelectItem Value="@(DashboardGranularity.Ano)">Ano</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        <!-- SELEÇÃO DE LINHAS DE SERVIÇO E BOTÃO REFRESH -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="gap-2 pt-1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-2 font-weight-bold">Linhas de serviço:</MudText>
                <MudChip T="string" Variant="_activeLines.Contains(AcompanhamentoServicoTipo.AVCB) ? Variant.Filled : Variant.Outlined"
                         Color="Color.Error" Size="Size.Small" OnClick="@(() => ToggleLineAsync(AcompanhamentoServicoTipo.AVCB))">AVCB</MudChip>
                <MudChip T="string" Variant="_activeLines.Contains(AcompanhamentoServicoTipo.CLCB) ? Variant.Filled : Variant.Outlined"
                         Color="Color.Warning" Size="Size.Small" OnClick="@(() => ToggleLineAsync(AcompanhamentoServicoTipo.CLCB))">CLCB</MudChip>
                <MudChip T="string" Variant="_activeLines.Contains(AcompanhamentoServicoTipo.PROCESSOS_ADM) ? Variant.Filled : Variant.Outlined"
                         Color="Color.Secondary" Size="Size.Small" OnClick="@(() => ToggleLineAsync(AcompanhamentoServicoTipo.PROCESSOS_ADM))">Proc. Adm</MudChip>
                <MudChip T="string" Variant="_activeLines.Contains(AcompanhamentoServicoTipo.OBRAS) ? Variant.Filled : Variant.Outlined"
                         Color="Color.Info" Size="Size.Small" OnClick="@(() => ToggleLineAsync(AcompanhamentoServicoTipo.OBRAS))">Obras</MudChip>
            </MudStack>
            
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="LoadAsync" Disabled="_loading"
                       StartIcon="@Icons.Material.Filled.Refresh">Atualizar painel</MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

<GlobalSkeleton IsLoading="_loading" Layout="GlobalSkeleton.SkeletonLayoutType.Dashboard">
    @if (_data is not null)
    {
        @if (_activeTabIndex == 0)
        {
            <!-- ========================================== -->
            <!-- TAB 1: PAINEL FINANCEIRO                 -->
            <!-- ========================================== -->
            <section class="atlas-enter">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                    <strong>Qualidade de dados:</strong> O faturamento refere-se às entradas em regime de caixa. Os custos indiretos são apurados no período filtrado.
                </MudAlert>

                <!-- KPIS PRINCIPAIS DO FINANCEIRO (7 CARDS EXECUTIVOS) -->
                <MudGrid Spacing="3">
                    <!-- 1. Faturamento -->
                    <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex flex-column">
                        <MetricCard Title="Faturamento" Value="@FmtCompactMoney(_data.Kpis.Revenue)" Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Primary">
                            <FooterContent>
                                @RenderDelta(_data.Kpis.Revenue, _data.Kpis.RevenuePrevious)
                            </FooterContent>
                        </MetricCard>
                    </MudItem>

                    <!-- 2. Custo direto -->
                    <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex flex-column">
                        <MetricCard Title="Custo direto" Value="@FmtCompactMoney(_data.Kpis.DirectCosts)" Icon="@Icons.Material.Filled.TrendingDown" Color="Color.Error" FooterText="vinculado aos serviços" />
                    </MudItem>

                    <!-- 3. Custo indireto -->
                    <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex flex-column">
                        <MetricCard Title="Custo indireto" Value="@FmtCompactMoney(_data.Kpis.IndirectCosts)" Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Warning" FooterText="@(_includeProLabore ? "com pró-labore" : "sem pró-labore")" />
                    </MudItem>

                    <!-- 4. Resultado -->
                    <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex flex-column">
                        <MetricCard Title="Resultado" Value="@FmtCompactMoney(_data.Kpis.Result)" Icon="@Icons.Material.Filled.PieChart" Color="@(_data.Kpis.Result >= 0 ? Color.Success : Color.Error)">
                            <FooterContent>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.78rem;">
                                    margem <strong style="color: @(_data.Kpis.Margin >= 0 ? "#1F9D66" : "#C8432F");">@((_data.Kpis.Margin * 100).ToString("F1", PtBr))%</strong>
                                </MudText>
                            </FooterContent>
                        </MetricCard>
                    </MudItem>

                    <!-- 5. A receber (carteira) -->
                    <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex flex-column">
                        <MetricCard Title="A receber (carteira)" Value="@FmtCompactMoney(_data.Kpis.Receivable)" Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Info" FooterText="saldo de contratos" />
                    </MudItem>

                    <!-- 6. Contratado (vendas) -->
                    <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex flex-column">
                        <MetricCard Title="Contratado (vendas)" Value="@FmtCompactMoney(_data.Kpis.ClosedContractsValue)" Icon="@Icons.Material.Filled.Handshake" Color="Color.Dark">
                            <FooterContent>
                                @RenderDelta(_data.Kpis.ClosedContractsValue, _data.Kpis.ClosedContractsValuePrevious)
                            </FooterContent>
                        </MetricCard>
                    </MudItem>

                    <!-- 7. Novos contratos -->
                    <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex flex-column">
                        <MetricCard Title="Novos contratos" Value="@_data.Kpis.ClosedContractsCount.ToString("N0", PtBr)" Icon="@Icons.Material.Filled.Description" Color="Color.Secondary">
                            <FooterContent>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.78rem;">
                                    ticket médio <strong>@FmtCompactMoney(_data.Kpis.ClosedContractsCount > 0 ? _data.Kpis.ClosedContractsValue / _data.Kpis.ClosedContractsCount : 0)</strong>
                                </MudText>
                            </FooterContent>
                        </MetricCard>
                    </MudItem>
                </MudGrid>

                <!-- VISÃO MESTRE - FATURAMENTO vs CUSTOS vs RESULTADO -->
                <MudGrid Class="mt-3">
                    <MudItem xs="12">
                        <MudPaper Outlined="true" Class="pa-5">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">Visão mestre — faturamento, custos e resultado</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Visão por período: barra de faturamento (caixa) ao lado da barra empilhada de custo direto + indireto, e linha de resultado.</MudText>
                                </MudStack>
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Color="Color.Default" OnClick="OpenMasterFullscreenAsync" aria-label="Expandir gráfico" />
                            </MudStack>
                            <div style="height: 380px; position: relative; width: 100%;">
                                <canvas id="masterChartCanvas"></canvas>
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <!-- VENDAS — CONTRATOS FECHADOS (TERMÔMETRO RÁPIDO) -->
                <div class="mt-5 mb-2">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="font-weight-bold" Style="letter-spacing: 1px;">VENDAS — CONTRATOS FECHADOS (TERMÔMETRO RÁPIDO)</MudText>
                </div>
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="7">
                        <MudPaper Outlined="true" Class="pa-5 h-100">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">Contratos fechados por linha de serviço</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Valor contratado mensal pela data de assinatura, empilhado por linha · vermelho: média móvel 3 períodos</MudText>
                                </MudStack>
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Color="Color.Default" OnClick="OpenVendasFullscreenAsync" aria-label="Expandir gráfico" />
                            </MudStack>
                            <div style="height: 320px; position: relative; width: 100%;">
                                <canvas id="vendasChartCanvas"></canvas>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="5">
                        <MudPaper Outlined="true" Class="pa-5 h-100">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">Quantidade fechada por serviço</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(_qtdByPeriod ? "Evolução por período" : "Total no período × período anterior")</MudText>
                                </MudStack>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudButton Size="Size.Small" Variant="@(_qtdByPeriod ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="ToggleQtdViewAsync">Por período</MudButton>
                                    <MudButton Size="Size.Small" Variant="@(_qtdByPeriod ? Variant.Outlined : Variant.Filled)" Color="Color.Primary" OnClick="ToggleQtdViewAsync">Total</MudButton>
                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Color="Color.Default" OnClick="OpenQtdFullscreenAsync" aria-label="Expandir gráfico" />
                                </MudStack>
                            </MudStack>
                            <div style="height: 320px; position: relative; width: 100%;">
                                <canvas id="qtdChartCanvas"></canvas>
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <!-- CAIXA — FATURAMENTO E CUSTOS -->
                <div class="mt-5 mb-2">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="font-weight-bold" Style="letter-spacing: 1px;">CAIXA — FATURAMENTO E CUSTOS</MudText>
                </div>
                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <MudPaper Outlined="true" Class="pa-5 h-100" Style="overflow: hidden;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-4 gap-3">
                                <MudStack Spacing="0">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudText Typo="Typo.h6" Class="font-weight-bold">Resultado operacional mensal</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Visão consolidada</MudChip>
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Receita e lucro em linhas · custos diretos e indiretos em barras empilhadas</MudText>
                                </MudStack>
                                <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Faturamento</MudText>
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@FmtCompactMoney(_data.Kpis.Revenue)</MudText>
                                    </div>
                                    <MudDivider Vertical="true" FlexItem="true" />
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Custos totais</MudText>
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@FmtCompactMoney(_data.Kpis.DirectCosts + _data.Kpis.IndirectCosts)</MudText>
                                    </div>
                                    <MudDivider Vertical="true" FlexItem="true" />
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Lucro · margem</MudText>
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="@($"color: {(_data.Kpis.Result >= 0 ? "#15803D" : "#B91C1C")};")">
                                            @FmtCompactMoney(_data.Kpis.Result) · @((_data.Kpis.Margin * 100).ToString("F1", PtBr))%
                                        </MudText>
                                    </div>
                                </MudStack>
                            </MudStack>
                            <MudDivider Class="mb-4" />
                            <div style="height: 360px; position: relative; width: 100%;">
                                <canvas id="operationalResultChartCanvas"></canvas>
                            </div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Class="pa-5 h-100">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">Evolução do faturamento</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Faturamento mensal · linha: média móvel 3 períodos · tracejado: período anterior</MudText>
                                </MudStack>
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Color="Color.Default" OnClick="OpenEvoFullscreenAsync" aria-label="Expandir gráfico" />
                            </MudStack>
                            <div style="height: 320px; position: relative; width: 100%;">
                                <canvas id="evoChartCanvas"></canvas>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Class="pa-5 h-100">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">Faturamento por linha de serviço</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Composição da receita em cada período</MudText>
                                </MudStack>
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Color="Color.Default" OnClick="OpenStackFullscreenAsync" aria-label="Expandir gráfico" />
                            </MudStack>
                            <div style="height: 320px; position: relative; width: 100%;">
                                <canvas id="stackChartCanvas"></canvas>
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <!-- CUSTOS INDIRETOS -->
                <div class="mt-5 mb-2">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="font-weight-bold" Style="letter-spacing: 1px;">CUSTOS INDIRETOS</MudText>
                </div>
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Class="pa-5 h-100">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">Evolução dos custos indiretos</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Empilhado por categoria — mostra o que está crescendo</MudText>
                                </MudStack>
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Color="Color.Default" OnClick="OpenCostEvoFullscreenAsync" aria-label="Expandir gráfico" />
                            </MudStack>
                            <div style="height: 320px; position: relative; width: 100%;">
                                <canvas id="costEvoChartCanvas"></canvas>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Class="pa-5 h-100">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">Custos indiretos por categoria</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total do período — @(_includeProLabore ? "com" : "sem") pró-labore</MudText>
                                </MudStack>
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Color="Color.Default" OnClick="OpenCostCatFullscreenAsync" aria-label="Expandir gráfico" />
                            </MudStack>
                            <div style="height: 320px; position: relative; width: 100%;">
                                <canvas id="costCatChartCanvas"></canvas>
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <!-- CARTEIRA E CLIENTES -->
                <div class="mt-5 mb-2">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="font-weight-bold" Style="letter-spacing: 1px;">CONTRATO TODOS OS SERVIÇOS</MudText>
                </div>
                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <MudPaper Outlined="true" Class="pa-5 h-100">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">Contrato todos os serviços</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total contratado por linha, pela data de assinatura dentro do período filtrado</MudText>
                                </MudStack>
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Color="Color.Default" OnClick="OpenContratoFullscreenAsync" aria-label="Expandir gráfico" />
                            </MudStack>
                            <div style="height: 360px; position: relative; width: 100%;">
                                <canvas id="contratoChartCanvas"></canvas>
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <div class="mt-5 mb-2">
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="font-weight-bold" Style="letter-spacing: 1px;">CARTEIRA E CLIENTES</MudText>
                </div>
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Class="pa-5 h-100">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">A receber por linha</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Saldo atual de contratos (independe do período)</MudText>
                                </MudStack>
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Color="Color.Default" OnClick="OpenArecFullscreenAsync" aria-label="Expandir gráfico" />
                            </MudStack>
                            <div style="height: 320px; position: relative; width: 100%;">
                                <canvas id="arecChartCanvas"></canvas>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Class="pa-5 h-100">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">Participação por linha</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Faturamento do período filtrado</MudText>
                                </MudStack>
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Color="Color.Default" OnClick="OpenDonutFullscreenAsync" aria-label="Expandir gráfico" />
                            </MudStack>
                            <div style="height: 320px; position: relative; width: 100%;">
                                <canvas id="donutChartCanvas"></canvas>
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <!-- MAIORES CLIENTES DA CARTEIRA -->
                <MudGrid Class="mt-5 mb-6">
                    <MudItem xs="12">
                        <MudPaper Outlined="true" Class="pa-5">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">Maiores clientes</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Recalculado pelos filtros: @string.Join(", ", _activeLines.Select(ServiceLabel)) · @(_startDate?.ToString("dd/MM/yyyy") ?? "-") a @(_endDate?.ToString("dd/MM/yyyy") ?? "-")
                                    </MudText>
                                </MudStack>
                                <MudButton Href="/clientes" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">Ver todos clientes</MudButton>
                            </MudStack>

                            <SmartTableFilter TItem="DashboardTopClientItem" Items="_data.TopClients" Columns="_topClientColumns" TableKey="home-topclients">
                            <ChildContent Context="topItems">
                            <MudTable Items="topItems" Hover="true" Elevation="0" Class="atlas-data-table">
                                <HeaderContent>
                                    <MudTh Style="width: 45px; color: var(--mud-palette-text-secondary);">#</MudTh>
                                    <MudTh>CLIENTE / CÓDIGOS DOS SERVIÇOS</MudTh>
                                    <MudTh>LINHA PRINCIPAL</MudTh>
                                    <MudTh Class="text-right">CONTRATADO ▼</MudTh>
                                    <MudTh Class="text-center">CONTRATOS</MudTh>
                                    <MudTh Class="text-right">A RECEBER</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="#" Style="color: var(--mud-palette-text-secondary); font-size: 0.85rem;">@context.Rank</MudTd>
                                    <MudTd DataLabel="Cliente">
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">@context.ClientName</MudText>
                                        @if (!string.IsNullOrEmpty(context.ServiceCodes))
                                        {
                                            <div style="font-size: 0.72rem; color: #718096; margin-top: 2px; font-family: Archivo, sans-serif;">@context.ServiceCodes</div>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Linha principal">
                                        <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background-color:@LineDotColor(context.PrimaryLine); margin-right:6px;"></span>
                                        <span style="font-size: 0.85rem;">@context.PrimaryLine</span>
                                    </MudTd>
                                    <MudTd DataLabel="Contratado" Class="text-right">
                                        <strong style="font-size: 0.9rem;">@FmtCompactMoney(context.TotalContracted)</strong>
                                    </MudTd>
                                    <MudTd DataLabel="Contratos" Class="text-center" Style="font-size: 0.85rem;">@context.ContractCount</MudTd>
                                    <MudTd DataLabel="A receber" Class="text-right" Style="font-size: 0.85rem;">
                                        @FmtCompactMoney(context.Receivable)
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                            </ChildContent>
                            </SmartTableFilter>

                            <details style="margin-top: 16px; font-size: 0.82rem; color: #718096; border-top: 1px dashed #E2E8F0; padding-top: 12px;">
                                <summary style="cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; font-size: 0.75rem; color: #4A5568;">v ESPECIFICAÇÃO</summary>
                                <p style="margin-top: 6px; line-height: 1.4; color: #718096;">Ranking recalculado com todos os filtros globais, com os códigos dos serviços que compõem o valor listados abaixo do nome do cliente: linhas de serviço, faixa de valor e período (pela data de assinatura; preset "Tudo" mostra o histórico completo). "Linha principal" é a linha com maior valor contratado pelo cliente. Clique no cliente abre a ficha com histórico (no sistema).</p>
                            </details>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </section>
        }
        else
        {
            <!-- ========================================== -->
            <!-- TAB 2: PAINEL GERENCIAL / OPERACIONAL     -->
            <!-- ========================================== -->
            <section class="atlas-enter">
                <!-- KPIS GERENCIAIS (5 CARDS EXECUTIVOS) -->
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6" md="4" lg="2" Class="d-flex flex-column flex-grow-1">
                        <MetricCard Title="Serviços em aberto" Value="@FilteredPriorities.Count().ToString("N0", PtBr)" Icon="@Icons.Material.Filled.Assignment" Color="Color.Info" FooterText="@($"{_hiddenIds.Count} ocultado(s)")" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex flex-column flex-grow-1">
                        <MetricCard Title="A receber (carteira)" Value="@FmtCompactMoney(_data.Kpis.Receivable)" Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary" FooterText="@($"contratado {FmtCompactMoney(_data.Kpis.ClosedContractsValue)}")" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="2" Class="d-flex flex-column flex-grow-1">
                        <MetricCard Title="Atrasados (+90 dias)" Value="@FilteredPriorities.Count(x => x.DaysInStatus > 90 && !IsThirdPartyWait(x.Status)).ToString("N0", PtBr)" Icon="@Icons.Material.Filled.Warning" Color="Color.Error" FooterText="sem contar esperas de terceiros" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex flex-column flex-grow-1">
                        <MetricCard Title="Aguardando terceiros" Value="@FilteredPriorities.Count(x => IsThirdPartyWait(x.Status)).ToString("N0", PtBr)" Icon="@Icons.Material.Filled.PauseCircle" Color="Color.Warning" FooterText="contratante, documentos, órgãos" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="2" Class="d-flex flex-column flex-grow-1">
                        <MetricCard Title="Mais antigo em aberto" Value="@((FilteredPriorities.Any() ? FilteredPriorities.Max(x => x.DaysInStatus) : 0) + " dias")" Icon="@Icons.Material.Filled.Schedule" Color="Color.Secondary" FooterText="desde a assinatura" />
                    </MudItem>
                </MudGrid>

                <!-- FILA DE PRIORIDADES -->
                <MudGrid Class="mt-5 mb-6">
                    <MudItem xs="12">
                        <MudPaper Outlined="true" Class="pa-5">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">Fila de prioridades — do mais antigo para o mais novo</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @FilteredPriorities.Count() serviço(s)@(!string.IsNullOrEmpty(_selectedStatusFilter) ? $" · situação: {_selectedStatusFilter}" : "") · idade contada desde a assinatura do contrato
                                    </MudText>
                                </MudStack>
                                <MudButton Href="/acompanhamento" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">Ver na operação</MudButton>
                            </MudStack>

                            <!-- FILTROS DE SITUAÇÃO (PILLS COM COUNTS) -->
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                <MudButton Variant="string.IsNullOrEmpty(_selectedStatusFilter) ? Variant.Filled : Variant.Outlined"
                                           Color="Color.Dark" Size="Size.Small" OnClick="@(() => _selectedStatusFilter = null)" Class="rounded-pill">
                                    Todas <span class="ml-1 px-1 rounded bg-grey-lighten-2 text-dark font-weight-bold" style="font-size: 0.72rem;">@(_data.Priorities.Count)</span>
                                </MudButton>
                                @foreach (var statusGroup in StatusGroups)
                                {
                                    var isWait = IsThirdPartyWait(statusGroup.Status);
                                    <MudButton Variant="_selectedStatusFilter == statusGroup.Status ? Variant.Filled : Variant.Outlined"
                                               Color="Color.Default" Size="Size.Small" OnClick="@(() => _selectedStatusFilter = statusGroup.Status)" Class="rounded-pill" Style="border-color: #CBD5E1;">
                                        @if (isWait)
                                        {
                                            <span style="margin-right: 4px; font-size: 0.75rem;">⏸</span>
                                        }
                                        @statusGroup.Status <span class="ml-1 px-1 rounded bg-grey-lighten-3 text-secondary font-weight-bold" style="font-size: 0.72rem;">@statusGroup.Count</span>
                                    </MudButton>
                                }
                            </div>

                            <!-- BUSCA DE TEXTO & OCULTADOS -->
                            <MudGrid Class="mb-4">
                                <MudItem xs="12" sm="8" md="9">
                                    <MudTextField T="string" @bind-Value="_prioritySearch" Placeholder="Buscar por código, cliente, serviço ou cidade..."
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                                </MudItem>
                                <MudItem xs="12" sm="4" md="3" Class="d-flex justify-sm-end">
                                    <MudCheckBox T="bool" @bind-Value="_showHidden" Color="Color.Primary" Label="@($"Mostrar ocultados ( {_hiddenIds.Count} )")" Dense="true" />
                                </MudItem>
                            </MudGrid>

                            <SmartTableFilter TItem="DashboardPriorityItem" Items="FilteredPriorities" Columns="_priorityColumns" TableKey="dashboard-fila">
                            <ChildContent Context="smartPriorities">
                            <MudTable Items="smartPriorities" Hover="true" Elevation="0" Class="atlas-data-table" RowsPerPage="20" Breakpoint="Breakpoint.Md">
                                <HeaderContent>
                                    <MudTh>CÓDIGO</MudTh>
                                    <MudTh>EM ABERTO HÁ</MudTh>
                                    <MudTh>CLIENTE</MudTh>
                                    <MudTh>SERVIÇO</MudTh>
                                    <MudTh>SITUAÇÃO</MudTh>
                                    <MudTh>CIDADE</MudTh>
                                    <MudTh Class="text-right">CONTRATO</MudTh>
                                    <MudTh Class="text-right">A RECEBER</MudTh>
                                    <MudTh Class="text-center">AÇÃO</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    @{
                                        var isHidden = _hiddenIds.Contains(context.Id);
                                        var ageStyle = AgePillStyle(context.DaysInStatus);
                                        var isWait = IsThirdPartyWait(context.Status);
                                        var rowStyle = isHidden ? "opacity: 0.5;" : "";
                                    }
                                    <MudTd DataLabel="Código" Style="@($"font-weight: 600; color: #4A5568; {rowStyle}")">@(context.Code ?? "—")</MudTd>
                                    <MudTd DataLabel="Em aberto há" Style="@rowStyle">
                                        <span style="display:inline-block; padding: 2px 8px; border-radius: 12px; font-weight: 600; font-size: 0.78rem; background-color: @ageStyle.bg; color: @ageStyle.color;">
                                            @context.DaysInStatus dias
                                        </span>
                                    </MudTd>
                                    <MudTd DataLabel="Cliente" Style="@rowStyle">
                                        <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background-color:@LineDotColor(context.ServiceType.ToString()); margin-right:6px;"></span>
                                        <strong>@context.Client</strong>
                                    </MudTd>
                                    <MudTd DataLabel="Serviço" Style="@rowStyle">@ServiceLabel(context.ServiceType)</MudTd>
                                    <MudTd DataLabel="Situação" Style="@rowStyle">
                                        <span>@context.Status</span>
                                        @if (isWait)
                                        {
                                            <span style="display:inline-block; margin-left: 6px; font-size: 0.72rem; color: #718096; background: #EDF2F7; padding: 1px 6px; border-radius: 4px;">⏸ aguardando terceiros</span>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Cidade" Style="@rowStyle">@(context.City ?? "—")</MudTd>
                                    <MudTd DataLabel="Contrato" Class="text-right" Style="@rowStyle">@FmtCompactMoney(context.ContractValue)</MudTd>
                                    <MudTd DataLabel="A receber" Class="text-right" Style="@rowStyle">@FmtCompactMoney(context.ReceivableValue)</MudTd>
                                    <MudTd DataLabel="Ação" Class="text-center" Style="@rowStyle">
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => ToggleHide(context.Id))">
                                            @(isHidden ? "Reexibir" : "Ocultar")
                                        </MudButton>
                                    </MudTd>
                                </RowTemplate>
                                <PagerContent>
                                    <MudTablePager PageSizeOptions="new int[] { 20, 50, 100 }" />
                                </PagerContent>
                            </MudTable>
                            </ChildContent>
                            </SmartTableFilter>

                            <details style="margin-top: 16px; font-size: 0.82rem; color: #718096; border-top: 1px dashed #E2E8F0; padding-top: 12px;">
                                <summary style="cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; font-size: 0.75rem; color: #4A5568;">v ESPECIFICAÇÃO</summary>
                                <p style="margin-top: 6px; line-height: 1.4; color: #718096;"><strong>Coração do painel gerencial.</strong> Lista todos os serviços não concluídos com o código do serviço (mesmo da planilha/sistema, para localizar o registro) e badge de idade: verde até 30 dias, âmber 31–90, laranja 91–180, vermelho +180 (idade contada da assinatura, pois não há data de término no processo atual). <strong>Filtro por situação:</strong> os botões acima da tabela mostram cada situação com a quantidade; aceitam seleção múltipla; "Todas" limpa. Situações de espera recebem a etiqueta "aguardando terceiros" — o atraso não é da equipe. <strong>Ordenação:</strong> clique em qualquer cabeçalho de coluna para ordenar de A a Z / do maior para o menor. <strong>Ocultar:</strong> remove o serviço da fila e dos indicadores. Clique na linha abre o serviço (no sistema).</p>
                            </details>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </section>
        }
    }
</GlobalSkeleton>

