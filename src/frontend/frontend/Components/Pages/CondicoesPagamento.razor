@page "/condicoes-pagamento"
@attribute [Authorize]
@using Radzen.Blazor
@inject ICondicaoPagamentoService Service
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Condições de pagamento | CRM Atlas</PageTitle>

<PageHeader Title="Condições de pagamento"
            Subtitle="Configure parcelamentos reutilizáveis nos cadastros de serviço.">
    <Actions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="New">Nova condição</MudButton>
    </Actions>
</PageHeader>

<GlobalSkeleton IsLoading="_loading" Layout="GlobalSkeleton.SkeletonLayoutType.Table" MetricCount="0" ColumnCount="4">
    <MudGrid>
        <MudItem xs="12" md="@(_editing ? 7 : 12)">
            <MudPaper Outlined="true">
                <SmartTableFilter TItem="CondicaoPagamentoDto" Items="_result.Items" Columns="_filterColumns"
                                  ProcessOnClient="false" TotalCount="_result.TotalItems"
                                  OnStateChanged="OnSmartTableStateChanged">
                <ChildContent Context="smartItems">
                <RadzenDataGrid @ref="_grid" Data="@_result.Items" TItem="CondicaoPagamentoDto"
                                Class="excel-grid" Style="width:100%;" AllowPaging="true" PageSize="50"
                                AllowColumnResize="true" AllowColumnPicking="true" AllowColumnReorder="true"
                                AllowSorting="true" AllowFiltering="true" AllowColumnFiltering="true" AllowGrouping="true" AllowAlternatingRows="true"
                                FilterMode="Radzen.FilterMode.CheckBoxList" Culture="@_ptBr" UICulture="@_ptBr"
                                Density="Radzen.Density.Compact" EmptyText="Nenhuma condição cadastrada"
                                GroupPanelText="Arraste um cabeçalho de coluna aqui para agrupar"
                                ColumnsShowingText="colunas visíveis">
                    <Columns>
                        <RadzenDataGridColumn TItem="CondicaoPagamentoDto" Property="Nome" Title="Nome">
                            <Template Context="context"><strong>@context.Nome</strong></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CondicaoPagamentoDto" Property="QuantidadeParcelas" Title="Parcelas" />
                        <RadzenDataGridColumn TItem="CondicaoPagamentoDto" Property="IntervaloDias" Title="Intervalo">
                            <Template Context="context">
                                @if (context.Indefinido)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default">A definir</MudChip>
                                }
                                else
                                {
                                    <span>@context.IntervaloDias dias</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CondicaoPagamentoDto" Title="Valor parcela">
                            <Template Context="context">
                                @if (context.ValorParcela is null)
                                {
                                    <span>—</span>
                                }
                                else if (context.TipoValorParcela == CondicaoPagamentoValorTipo.Reais)
                                {
                                    <span>@Money(context.ValorParcela.Value)</span>
                                }
                                else
                                {
                                    <span>@context.ValorParcela.Value.ToString("F2") %</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CondicaoPagamentoDto" Property="Entrada" Title="Entrada">
                            <Template Context="context">@(context.Entrada ? "Sim" : "Não")</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CondicaoPagamentoDto" Title="Ações" Sortable="false" Filterable="false" Resizable="false" TextAlign="Radzen.TextAlign.Right" Width="120px">
                            <Template Context="context">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Edit(context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAsync(context))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
                </ChildContent>
                </SmartTableFilter>

                <MudDivider Class="my-3" />
            </MudPaper>
        </MudItem>
        @if (_editing)
        {
            <MudItem xs="12" md="5">
                <MudPaper Outlined="true" Class="pa-5 atlas-sticky-card">
                    <MudToolBar Class="pa-0 mb-3">
                        <MudText Typo="Typo.h6">@(_model.Id is null ? "Nova condição" : "Editar condição")</MudText>
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Cancel" />
                    </MudToolBar>
                    <MudDivider Class="mb-4" />
                    <MudForm @ref="_form" @bind-IsValid="_valid">
                        <MudStack Spacing="3">
                            <MudTextField @bind-Value="_model.Nome" Label="Nome" Required="true"
                                          RequiredError="Informe o nome." Variant="Variant.Outlined" />
                            <MudNumericField T="int" @bind-Value="_model.QuantidadeParcelas"
                                             Label="Quantidade de parcelas" Min="1"
                                             Variant="Variant.Outlined" />
                            <MudSwitch T="bool" @bind-Value="_model.Indefinido" Color="Color.Primary">
                                Datas a definir
                            </MudSwitch>
                            <MudSwitch T="bool" @bind-Value="_model.Entrada" Color="Color.Primary">
                                Possui entrada (paga no início)
                            </MudSwitch>
                            <MudNumericField T="int?" @bind-Value="_model.IntervaloDias"
                                             Label="Intervalo entre parcelas (dias)" Min="1"
                                             Disabled="_model.Indefinido" Variant="Variant.Outlined" />
                            <MudSelect T="CondicaoPagamentoValorTipo" @bind-Value="_model.TipoValorParcela" Label="Valor da parcela" Variant="Variant.Outlined">
                                <MudSelectItem Value="@CondicaoPagamentoValorTipo.Reais">Reais</MudSelectItem>
                                <MudSelectItem Value="@CondicaoPagamentoValorTipo.Percentual">Percentual (%)</MudSelectItem>
                            </MudSelect>
                            <MudNumericField T="decimal?" @bind-Value="_model.ValorParcela"
                                             Label="@(_model.TipoValorParcela == CondicaoPagamentoValorTipo.Reais ? "Valor de cada parcela (R$)" : "Percentual de cada parcela (%)")"
                                             Min="0.01M" Step="0.01M" Format="@(_model.TipoValorParcela == CondicaoPagamentoValorTipo.Reais ? "C2" : "N2")" Variant="Variant.Outlined" />
                        </MudStack>
                    </MudForm>
                    <MudDivider Class="mt-5 mb-4" />
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton OnClick="Cancel">Cancelar</MudButton>
                        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                                   Disabled="_saving" OnClick="SaveAsync">Salvar</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</GlobalSkeleton>

@code {
    private RadzenDataGrid<CondicaoPagamentoDto>? _grid;
    private PagedResult<CondicaoPagamentoDto> _result = new([], 1, 1000, 0);
    private readonly System.Globalization.CultureInfo _ptBr = new("pt-BR");
    private string? _sortKey;
    private bool _sortDescending;
    private readonly IReadOnlyList<SmartFilterColumn<CondicaoPagamentoDto>> _filterColumns =
    [
        new("nome","Nome",x=>x.Nome,1),new("parcelas","Parcelas",x=>x.QuantidadeParcelas,2,true),
        new("intervalo","Intervalo",x=>x.Indefinido?"A definir":$"{x.IntervaloDias} dias",3),
        new("valor","Valor parcela",x=>x.ValorParcela is null?"—":x.TipoValorParcela==CondicaoPagamentoValorTipo.Reais?Money(x.ValorParcela.Value):$"{x.ValorParcela:F2}%",4),
        new("entrada","Entrada",x=>x.Entrada?"Sim":"Não",5)
    ];
    private ConditionModel _model = new();
    private MudForm? _form;
    private bool _valid;
    private bool _loading;
    private bool _saving;
    private bool _editing;

    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _result = await Service.ListAsync(new CondicaoPagamentoFilter(null, 1, 0, _sortKey, _sortDescending));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OnSmartTableStateChanged(SmartTableState state)
    {
        _sortKey = state.SortKey;
        _sortDescending = state.SortDescending;
        await LoadAsync();
    }

    private void New() { _model = new(); _editing = true; }
    private void Edit(CondicaoPagamentoDto x)
    {
        _model = new() { Id = x.Id, Nome = x.Nome, QuantidadeParcelas = x.QuantidadeParcelas,
            IntervaloDias = x.IntervaloDias, Indefinido = x.Indefinido, ValorParcela = x.ValorParcela,
            TipoValorParcela = x.TipoValorParcela, Entrada = x.Entrada };
        _editing = true;
    }
    private void Cancel() => _editing = false;

    private async Task SaveAsync()
    {
        await (_form?.ValidateAsync() ?? Task.CompletedTask);
        if (!_valid) return;
        _saving = true;
        try
        {
            var dto = new CondicaoPagamentoDto(
                _model.Id, _model.Nome, _model.QuantidadeParcelas, _model.IntervaloDias, _model.Indefinido,
                _model.ValorParcela, _model.TipoValorParcela, _model.Entrada);
            if (_model.Id is null) await Service.CreateAsync(dto);
            else await Service.UpdateAsync(_model.Id.Value, dto);
            Snackbar.Add("Condição salva com sucesso.", Severity.Success);
            _editing = false;
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(CondicaoPagamentoDto x)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Excluir condição", $"Deseja excluir “{x.Nome}”?", "Excluir", cancelText: "Cancelar");
        if (confirm != true || x.Id is null) return;
        try { await Service.DeleteAsync(x.Id.Value); await LoadAsync(); Snackbar.Add("Condição excluída.", Severity.Success); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private static string Money(decimal v) => v.ToString("C2", new System.Globalization.CultureInfo("pt-BR"));

    private sealed class ConditionModel
    {
        public long? Id { get; set; }
        public string Nome { get; set; } = "";
        public int QuantidadeParcelas { get; set; } = 1;
        public int? IntervaloDias { get; set; } = 30;
        public bool Indefinido { get; set; }
        public bool Entrada { get; set; }
        public decimal? ValorParcela { get; set; }
        public CondicaoPagamentoValorTipo TipoValorParcela { get; set; } = CondicaoPagamentoValorTipo.Reais;
    }
}
