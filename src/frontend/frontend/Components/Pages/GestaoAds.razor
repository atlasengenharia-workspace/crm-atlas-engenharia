@page "/gestao-ads"
@attribute [Authorize]
@using Radzen.Blazor

<PageTitle>Gestão Ads | CRM Atlas</PageTitle>
<PageHeader Title="Gestão Ads" Subtitle="Contexto independente para campanhas e aquisição de oportunidades.">
    <Actions><MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add">Nova campanha</MudButton></Actions>
</PageHeader>
<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5">Este módulo permanece isolado dos fluxos financeiros e operacionais do CRM.</MudAlert>
<MudGrid>
    <MudItem xs="6" md="3"><MetricCard Title="Investimento" Value="R$ 12.480" Icon="@Icons.Material.Filled.Payments" Color="Color.Primary" /></MudItem>
    <MudItem xs="6" md="3"><MetricCard Title="Leads" Value="184" Icon="@Icons.Material.Filled.PersonSearch" Color="Color.Info" /></MudItem>
    <MudItem xs="6" md="3"><MetricCard Title="CPL médio" Value="R$ 67,82" Icon="@Icons.Material.Filled.Analytics" Color="Color.Warning" /></MudItem>
    <MudItem xs="6" md="3"><MetricCard Title="Conversões" Value="22" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" /></MudItem>
</MudGrid>
<MudPaper Outlined="true" Class="pa-5 mt-5"><MudText Typo="Typo.h6">Campanhas ativas</MudText>
    <SmartTableFilter TItem="Campaign" Items="_campaigns" Columns="_filterColumns" TableKey="gestao-ads">
    <ChildContent Context="smartItems">
    <RadzenDataGrid @ref="_grid" Data="@smartItems" TItem="Campaign"
                    Class="excel-grid" Style="width:100%;" AllowPaging="true" PageSize="50"
                    AllowColumnResize="true" AllowColumnPicking="true" AllowColumnReorder="true"
                    AllowSorting="true" AllowFiltering="true" AllowColumnFiltering="true" AllowGrouping="true" AllowAlternatingRows="true"
                    FilterMode="Radzen.FilterMode.CheckBoxList" Culture="@_ptBr" UICulture="@_ptBr"
                    Density="Radzen.Density.Compact" EmptyText="Nenhuma campanha cadastrada"
                    GroupPanelText="Arraste um cabeçalho de coluna aqui para agrupar"
                    ColumnsShowingText="colunas visíveis">
        <Columns>
            <RadzenDataGridColumn TItem="Campaign" Property="Name" Title="Campanha" />
            <RadzenDataGridColumn TItem="Campaign" Property="Channel" Title="Canal" />
            <RadzenDataGridColumn TItem="Campaign" Property="Status" Title="Status">
                <Template Context="context">
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@context.Status</MudChip>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Campaign" Property="Leads" Title="Leads" />
            <RadzenDataGridColumn TItem="Campaign" Property="Spend" Title="Investimento" />
        </Columns>
    </RadzenDataGrid>
    </ChildContent>
    </SmartTableFilter>
</MudPaper>
@code {
    private readonly Campaign[] _campaigns =
    [
        new("Regularização AVCB SP", "Google Ads", "Ativa", 96, "R$ 6.850"),
        new("CLCB para comércios", "Meta Ads", "Ativa", 54, "R$ 3.420"),
        new("Projetos e obras", "Google Ads", "Ativa", 34, "R$ 2.210")
    ];
    private readonly System.Globalization.CultureInfo _ptBr = new("pt-BR");
    private RadzenDataGrid<Campaign>? _grid;
    private readonly IReadOnlyList<SmartFilterColumn<Campaign>> _filterColumns =
    [
        new("campanha", "Campanha", x => x.Name, 1),
        new("canal", "Canal", x => x.Channel, 2),
        new("status", "Status", x => x.Status, 3),
        new("leads", "Leads", x => x.Leads, 4),
        new("investimento", "Investimento", x => x.Spend, 5)
    ];
    private sealed record Campaign(string Name, string Channel, string Status, int Leads, string Spend);
}
