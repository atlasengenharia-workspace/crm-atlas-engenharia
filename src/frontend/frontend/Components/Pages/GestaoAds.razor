@page "/gestao-ads"
@attribute [Authorize]
@using Radzen.Blazor
@using CrmAtlas.ApplicationCore.Integracoes
@inject IGoogleAdsIntegrationService Service
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Gestão Ads | CRM Atlas</PageTitle>
<PageHeader Title="Gestão Ads" Subtitle="Campanhas e aquisição de oportunidades integradas com Google Ads.">
    <Actions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Settings" OnClick="GoToConfig">
            Configurar integração
        </MudButton>
    </Actions>
</PageHeader>

@if (_integration is null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5">
        Nenhuma integração Google Ads configurada. Configure uma para começar a sincronizar campanhas.
    </MudAlert>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GoToConfig">
        Nova integração Google Ads
    </MudButton>
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="6" md="3"><MetricCard Title="Investimento" Value="@TotalCostText" Icon="@Icons.Material.Filled.Payments" Color="Color.Primary" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="Leads" Value="@TotalLeadsText" Icon="@Icons.Material.Filled.PersonSearch" Color="Color.Info" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="CPL médio" Value="@CplText" Icon="@Icons.Material.Filled.Analytics" Color="Color.Warning" /></MudItem>
        <MudItem xs="6" md="3"><MetricCard Title="Conversões" Value="@TotalConversionsText" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" /></MudItem>
    </MudGrid>

    <MudPaper Outlined="true" Class="pa-5 mt-5">
        <MudToolBar Class="pa-0 mb-3">
            <MudText Typo="Typo.h6">Campanhas ativas</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sync" OnClick="SyncAsync" Disabled="_syncing">
                @if (_syncing)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                }
                Sincronizar
            </MudButton>
        </MudToolBar>

        @if (!string.IsNullOrWhiteSpace(_integration.ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@_integration.ErrorMessage</MudAlert>
        }

        <RadzenDataGrid @ref="_grid" Data="@_campaigns" TItem="GoogleAdsCampaignDto"
                        Class="excel-grid" Style="width:100%;" AllowPaging="true" PageSize="50"
                        AllowColumnResize="true" AllowColumnPicking="true" AllowColumnReorder="true"
                        AllowSorting="true" AllowFiltering="true" AllowColumnFiltering="true" AllowGrouping="true" AllowAlternatingRows="true"
                        FilterMode="Radzen.FilterMode.CheckBoxList" Culture="@_ptBr" UICulture="@_ptBr"
                        Density="Radzen.Density.Compact" EmptyText="Nenhuma campanha sincronizada"
                        GroupPanelText="Arraste um cabeçalho de coluna aqui para agrupar"
                        ColumnsShowingText="colunas visíveis">
            <Columns>
                <RadzenDataGridColumn TItem="GoogleAdsCampaignDto" Property="Name" Title="Campanha" />
                <RadzenDataGridColumn TItem="GoogleAdsCampaignDto" Property="Channel" Title="Canal" />
                <RadzenDataGridColumn TItem="GoogleAdsCampaignDto" Property="Status" Title="Status">
                    <Template Context="context">
                        <MudChip T="string" Color="@StatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GoogleAdsCampaignDto" Property="Leads" Title="Leads" />
                <RadzenDataGridColumn TItem="GoogleAdsCampaignDto" Property="Spend" Title="Investimento" />
            </Columns>
        </RadzenDataGrid>
    </MudPaper>
}

@code {
    private GoogleAdsIntegrationDto? _integration;
    private GoogleAdsDashboardSummary? _summary;
    private IReadOnlyList<GoogleAdsCampaignDto> _campaigns = [];
    private bool _syncing;
    private readonly System.Globalization.CultureInfo _ptBr = new("pt-BR");
    private RadzenDataGrid<GoogleAdsCampaignDto>? _grid;

    private string TotalCostText => (_summary?.TotalCost ?? 0).ToString("C2", _ptBr);
    private string TotalLeadsText => (_summary?.TotalLeads ?? 0).ToString("N0", _ptBr);
    private string CplText => (_summary?.Cpl ?? 0).ToString("C2", _ptBr);
    private string TotalConversionsText => (_summary?.TotalConversions ?? 0).ToString("N2", _ptBr);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Service.ListAsync(new GoogleAdsIntegrationFilter(PageSize: 1));
            _integration = result.Items.FirstOrDefault();

            if (_integration is not null && _integration.Id is not null)
            {
                _summary = await Service.GetDashboardSummaryAsync(_integration.Id.Value);
                _campaigns = await Service.ListCampaignsAsync(_integration.Id.Value);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Não foi possível carregar a integração Google Ads: {ex.Message}", Severity.Error);
        }
    }

    private void GoToConfig() => Navigation.NavigateTo("/configuracao/google-ads");

    private async Task SyncAsync()
    {
        if (_integration?.Id is null) return;
        _syncing = true;
        try
        {
            await Service.SyncAsync(_integration.Id.Value, "sistema");
            _summary = await Service.GetDashboardSummaryAsync(_integration.Id.Value);
            _campaigns = await Service.ListCampaignsAsync(_integration.Id.Value);
            Snackbar.Add("Sincronização concluída.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro na sincronização: {ex.Message}", Severity.Error);
        }
        finally
        {
            _syncing = false;
        }
    }

    private static Color StatusColor(string status) =>
        status.ToUpperInvariant() switch
        {
            "ENABLED" => Color.Success,
            "PAUSED" => Color.Warning,
            "REMOVED" => Color.Error,
            _ => Color.Default
        };
}
