@page "/authentication-error"
@attribute [AllowAnonymous]

<PageTitle>Falha na autenticação</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        <MudText Typo="Typo.h6" GutterBottom="true">
            Não foi possível concluir a autenticação
        </MudText>
        <MudText>
            Nenhum método de acesso está disponível para esta aplicação no
            Auth0. Habilite uma conexão para o cliente e tente novamente.
        </MudText>
    </MudAlert>

    <MudStack Row="true" Class="mt-6">
        <MudButton Href="/Login"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Login">
            Tentar novamente
        </MudButton>
    </MudStack>
</MudContainer>
