@page "/busca"
@attribute [Authorize]
@inject IGlobalSearchService SearchService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Busca global | CRM Atlas</PageTitle>
<PageHeader Title="Busca global" Subtitle="Clientes, serviços, orçamentos, prestadores e acompanhamentos em um só lugar." />

<MudPaper Outlined="true" Class="pa-4 mb-5">
    <div class="d-flex gap-2">
        <MudTextField T="string" @bind-Value="_query" Label="O que você procura?" Variant="Variant.Outlined"
                      Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyDown="SearchOnEnter" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync" Disabled="@(_query?.Trim().Length<2)">Buscar</MudButton>
    </div>
</MudPaper>

@if(_loading){<MudProgressLinear Indeterminate="true" Color="Color.Primary" />}
else if(_searched && _results.Count==0){<EmptyState Title="Nenhum resultado" Message="Tente outro nome, código, documento, e-mail ou situação." />}
else
{
    @foreach(var group in _results.GroupBy(x=>x.Tipo))
    {
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mt-5 mb-2">@TypeLabel(group.Key) (@group.Count())</MudText>
        <MudPaper Outlined="true">
            <MudList T="string">
                @foreach(var item in group)
                {
                    <MudListItem Href="@Href(item)" Icon="@Icon(item.Tipo)">
                        <div class="d-flex align-center">
                            <div><MudText Typo="Typo.subtitle2">@item.Titulo</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">@item.Subtitulo</MudText></div>
                            <MudSpacer />@if(!string.IsNullOrWhiteSpace(item.Codigo)){<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@item.Codigo</MudChip>}
                        </div>
                    </MudListItem><MudDivider />
                }
            </MudList>
        </MudPaper>
    }
}

@code {
    [SupplyParameterFromQuery(Name="q")] public string? Query{get;set;}
    private string? _query;private List<GlobalSearchResult> _results=[];private bool _loading,_searched;
    protected override async Task OnParametersSetAsync(){if(Query==_query&&_searched)return;_query=Query;if(!string.IsNullOrWhiteSpace(_query))await SearchAsync();}
    private async Task SearchOnEnter(KeyboardEventArgs e){if(e.Key=="Enter")await NavigateSearchAsync();}
    private Task NavigateSearchAsync(){if((_query?.Trim().Length??0)<2)return Task.CompletedTask;Navigation.NavigateTo($"/busca?q={Uri.EscapeDataString(_query!.Trim())}");return Task.CompletedTask;}
    private async Task SearchAsync(){if((_query?.Trim().Length??0)<2)return;_loading=true;try{_results=(await SearchService.SearchAsync(_query!)).ToList();_searched=true;}catch(Exception e){Snackbar.Add(e.Message,Severity.Error);}finally{_loading=false;}}
    private static string TypeLabel(GlobalSearchResultType type)=>type switch{GlobalSearchResultType.CLIENTE=>"Clientes",GlobalSearchResultType.SERVICO=>"Serviços",GlobalSearchResultType.ORCAMENTO=>"Orçamentos",GlobalSearchResultType.PRESTADOR=>"Prestadores",_=>"Acompanhamentos"};
    private static string Icon(GlobalSearchResultType type)=>type switch{GlobalSearchResultType.CLIENTE=>Icons.Material.Filled.Groups,GlobalSearchResultType.SERVICO=>Icons.Material.Filled.Assignment,GlobalSearchResultType.ORCAMENTO=>Icons.Material.Filled.RequestQuote,GlobalSearchResultType.PRESTADOR=>Icons.Material.Filled.Engineering,_=>Icons.Material.Filled.ViewKanban};
    private static string Href(GlobalSearchResult item)=>item.Tipo switch{GlobalSearchResultType.CLIENTE=>"/clientes",GlobalSearchResultType.SERVICO=>"/servicos",GlobalSearchResultType.ORCAMENTO=>"/orcamentos",GlobalSearchResultType.PRESTADOR=>"/prestadores",_=>"/acompanhamento"};
}
