<div class="table-page-skeleton" role="status" aria-label="Carregando dados">
    <MudGrid Class="mb-4">
        @for (var metric = 0; metric < MetricCount; metric++)
        {
            <MudItem xs="12" sm="@MetricWidth">
                <div class="skeleton-surface skeleton-metric"><span></span><strong></strong></div>
            </MudItem>
        }
    </MudGrid>
    <div class="skeleton-surface skeleton-filter">
        <span></span><span></span><span></span><i></i>
    </div>
    <div class="skeleton-surface skeleton-table">
        <div class="skeleton-table-head"></div>
        @for (var row = 0; row < 7; row++)
        {
            <div class="skeleton-row">
                @for (var column = 0; column < ColumnCount; column++)
                {
                    <span></span>
                }
            </div>
        }
    </div>
    <span class="sr-only">Carregando informações da página.</span>
</div>

@code {
    [Parameter] public int MetricCount { get; set; } = 3;
    [Parameter] public int ColumnCount { get; set; } = 5;
    private int MetricWidth => Math.Max(1, 12 / Math.Max(1, MetricCount));
}
